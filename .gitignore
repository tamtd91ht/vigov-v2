# Secrets — never committed
.env
.env.local
.env.*.local
*.pem
*.key
!*.pub

# Runtime artefacts
.claude/logs/
.claude/settings.local.json
__pycache__/
*.pyc

# Go
/bin/
/dist/
vendor/

# Generated from .proto — run `make proto`
gen/

# Node / Next.js
node_modules/
.next/
out/
web/build/

# The GENERATED kb tiers are committed on purpose, so a fresh clone has working
# knowledge before anyone runs `make kb`.

# Cấu hình MCP là của từng máy, không phải của dự án
.mcp.json

# Bản nén trùng nội dung với docs/ui-ux/*.md
docs/ui-ux/*.zip

# Thư mục của IDE — của từng máy, không phải của dự án.
# Chưa có dòng nào cho chúng cho tới 2026-09-17, nên một lần `git add -A` là .idea/ lọt vào
# kho mã: đường dẫn tuyệt đối, tên người dùng, đôi khi cả chuỗi kết nối trong cấu hình data source.
.idea/
.vscode/
*.swp
