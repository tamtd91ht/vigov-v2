// Job TRIỂN KHAI. Tệp này là nơi DUY NHẤT chạm vào cụm k8s.
//
// ─────────────────────────────────────────────────────────────────────────────────────────
// VÌ SAO NÓ TÁCH KHỎI TÁM JOB ĐÓNG ẢNH, VÀ VÌ SAO NÓ KHÔNG TỰ CHẠY
//
// Tám job kia đóng ảnh tự động, thoải mái — một ảnh nằm trong Harbor không làm gì cả.
// Đưa một ảnh lên cụm thì khác: nó thay mã đang phục vụ hồ sơ hành chính của 200+ xã.
//
// Nên job này chỉ chạy khi có người bấm, với ba tham số người ấy phải tự điền, và nó để
// lại một commit mang tên người ấy trong `deploy/overlays/<mt>/kustomization.yaml`.
// Commit đó LÀ nhật ký triển khai: "lúc đó bản nào đang chạy" trả lời được bằng `git log`,
// không phải bằng suy đoán từ thời điểm kéo ảnh.
//
// PHẠM VI: đúng MỘT dịch vụ mỗi lượt. Đó là toàn bộ cơ chế "deploy A mà B đứng yên" —
// dịch vụ khác không có diff nên `kubectl apply` không sinh generation mới cho chúng.
// ─────────────────────────────────────────────────────────────────────────────────────────
//
// MÁY CHỦ BUILD CẦN: git, kubectl, kustomize (hoặc kubectl >= 1.27 có -k sẵn), skopeo hoặc crane.
// Dòng trên là CHÚ THÍCH, và một chú thích không kiểm gì cả — stage 'Kiểm công cụ' bên dưới mới
// là thứ kiểm. Thêm ngày 2026-09-21, sau khi lượt chạy thật đầu tiên của dự án trên Jenkins cho
// thấy máy chủ không có cả những công cụ mọi tệp ở đây vẫn mặc định là có.
//
// KHÔNG DÙNG `withKubeConfig`: nó thuộc plugin `kubernetes-cli`, mà máy chủ Jenkins này không
// có plugin nào ngoài bộ lõi — xem `Jenkinsfile` gốc, mục "VÌ SAO KHÔNG GỌI PLUGIN DOCKER
// PIPELINE". Thay bằng ràng buộc `file` của `credentials-binding`: nó đặt biến `KUBECONFIG` trỏ
// tới một tệp tạm, và `kubectl` tự đọc biến ấy.
//
// ĐIỀU KIỆN: credentials `kubeconfig-vigov` phải là kiểu **Secret file** (nội dung là kubeconfig).
// Nếu nó đang được lưu dưới kiểu riêng của plugin kubernetes-cli thì ràng buộc `file` không gắn
// được, và lỗi sẽ là "credentials ... is not a file" — lúc ấy đổi kiểu lưu, đừng đổi lại mã.

pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 20, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '200'))   // giữ lâu hơn job build: đây là hồ sơ
    disableConcurrentBuilds()
  }

  parameters {
    // `platform` đứng đầu vì nó phải lên trước: bảy dịch vụ còn lại quay số tới cổng 9090 của
    // nó để phân giải Host → xã. Bốn tên cuối là các dịch vụ vừa có manifest trong `base/`;
    // `reporting` KHÔNG có trong danh sách vì nó chưa có manifest — 0 tuyến REST, xem
    // `deploy/README.md`. Một lựa chọn trỏ tới một Deployment không tồn tại chỉ đỏ ở bước
    // `rollout status`, sau khi commit ghim thẻ đã được đẩy.
    choice(name: 'DICH_VU',
           choices: ['platform', 'identity', 'web-admin',
                     'comms', 'documents', 'finance', 'petitions'],
           description: 'Đúng MỘT dịch vụ. Muốn đưa hai cái lên thì chạy hai lượt — ' +
                        'để mỗi lượt là một dòng riêng trong nhật ký.')
    string(name: 'THE', defaultValue: '',
           description: 'Thẻ ảnh = commit 12 ký tự đã sinh ra nó. Lấy từ log job đóng ảnh.')
    choice(name: 'MT', choices: ['staging', 'prod'],
           description: 'staging đứng TRƯỚC prod trong danh sách, có chủ ý.')
    string(name: 'KUBE_CRED', defaultValue: 'kubeconfig-vigov',
           description: 'ID credentials trong Jenkins. CHỈ LÀ ID, không bao giờ là giá trị thật.')
    string(name: 'GIT_CRED', defaultValue: 'git-vigov',
           description: 'ID credentials để đẩy commit ghim thẻ.')
  }

  environment {
    REGISTRY = 'harbor.omicrm.services'
    PROJECT  = 'ci'
    // Tên ẢNH mang tiền tố `vigov-service-` cho dịch vụ Go, `vigov-` cho web.
    // Tên TÀI NGUYÊN k8s là tên NGHIỆP VỤ trần (`platform`, `identity`) — ADR 0016 §2:
    // tiền tố `service-` là dấu hiệu hạ tầng, nó không được lọt vào bề mặt người khác đọc.
    NS = "vigov-${params.MT}"
  }

  stages {

    stage('Kiểm công cụ') {
      steps {
        sh '''
          set -eu
          thieu=""
          for cc in git kubectl kustomize skopeo; do
            command -v "$cc" >/dev/null 2>&1 || thieu="$thieu $cc"
          done
          if [ -n "$thieu" ]; then
            echo ""
            echo "MÁY CHỦ BUILD THIẾU:$thieu"
            echo "Dừng ở đây thay vì đổ giữa một lượt triển khai đã sửa cụm được một nửa."
            echo ""
            exit 1
          fi
          kubectl version --client
        '''
      }
    }

    stage('Kiểm tham số') {
      steps {
        script {
          // Cờ cho khối `post { failure }`. Phải đặt Ở STAGE ĐẦU TIÊN có script, vì khối ấy
          // chạy cho MỌI stage đỏ — kể cả stage này.
          env.DA_AP = 'chua'

          if (!(params.THE ==~ /^[0-9a-f]{12}$/)) {
            error("THE phải là 12 ký tự hex — commit đã sinh ra ảnh. Nhận được: '${params.THE}'\n" +
                  "Thẻ di động (latest, main, prod) bị cấm: hai pod cùng manifest có thể chạy " +
                  "hai đoạn mã khác nhau, và câu 'bản nào đang chạy lúc đó' mất lời giải.")
          }

          // AI BẤM — kiểm Ở ĐÂY, trước khi chạm git và cụm, vì đây là chỗ duy nhất còn quay
          // lại được mà không tốn gì. Chi tiết cơ chế ở cuối tệp, hàm `nguoiBam()`.
          env.NGUOI_BAM = nguoiBam()
          if (!env.NGUOI_BAM) {
            error('KHÔNG XÁC ĐỊNH ĐƯỢC AI BẤM LƯỢT NÀY — dừng trước khi chạm git và cụm.\n' +
                  '\n' +
                  'Commit ghim thẻ LÀ nhật ký triển khai của hệ thống. Một dòng không có tên\n' +
                  'người là một dòng trả lời được "bản nào" và "lúc nào" nhưng không trả lời\n' +
                  'được "AI" — và với hệ thống lưu hồ sơ hành chính, đó đúng là câu một cuộc\n' +
                  'thanh tra sẽ hỏi. Ghi một cái tên giả (`khong-ro`) còn tệ hơn để trống: nó\n' +
                  'làm dòng nhật ký TRÔNG NHƯ đã có câu trả lời.\n' +
                  '\n' +
                  'Job này KHÔNG khai trigger tự động, nên mọi lượt chạy hợp lệ đều do một\n' +
                  'người đã đăng nhập bấm. Thấy dòng này nghĩa là lượt chạy không mang\n' +
                  'hudson.model.Cause$UserIdCause — kiểm xem nó có bị một job khác, một timer,\n' +
                  'hay một script gọi hộ không.')
          }

          env.ANH = (params.DICH_VU == 'web-admin')
                  ? "${env.REGISTRY}/${env.PROJECT}/vigov-web-admin"
                  : "${env.REGISTRY}/${env.PROJECT}/vigov-service-${params.DICH_VU}"
          echo "sẽ đưa ${env.ANH}:${params.THE} lên ${env.NS} — người bấm: ${env.NGUOI_BAM}"
        }
      }
    }

    stage('Ảnh có thật trong registry chưa') {
      steps {
        // KIỂM TRƯỚC KHI COMMIT. Ghim một thẻ không tồn tại rồi mới phát hiện nghĩa là
        // Deployment ngồi ImagePullBackOff, nhật ký triển khai có một dòng nói dối, và
        // người sửa phải làm thêm một commit nữa để rút lại.
        // `--authfile` chứ không `--creds`: kho này không mang credentials registry nữa, nó
        // dùng phiên đăng nhập sẵn của user `jenkins` như tám job đóng ảnh — xem `Jenkinsfile`
        // gốc, mục "VÌ SAO KHÔNG GỌI PLUGIN DOCKER PIPELINE". Chỉ đường dẫn ra tường minh chứ
        // không dựa vào thứ tự tìm mặc định của skopeo: nó ưu tiên
        // `$XDG_RUNTIME_DIR/containers/auth.json` TRƯỚC `~/.docker/config.json`, nên trên một
        // máy có cả hai, "docker đăng nhập rồi" và "skopeo đọc được" là hai chuyện khác nhau.
        sh '''
          set -eu
          skopeo inspect --authfile "${DOCKER_CONFIG:-$HOME/.docker}/config.json" \
                 "docker://${ANH}:${THE}" >/dev/null \
            || { echo ""; echo "KHÔNG TÌM THẤY ${ANH}:${THE} trong registry."; \
                 echo "Job đóng ảnh của dịch vụ này đã chạy xong cho commit đó chưa?"; \
                 echo "(Nếu lỗi là unauthorized: máy chủ chưa đăng nhập ${REGISTRY}.)"; \
                 echo ""; exit 1; }
        '''
      }
    }

    stage('Ghim thẻ và commit') {
      steps {
        sh '''
          set -eu
          cd deploy/overlays/${MT}
          kustomize edit set image ${ANH}=${ANH}:${THE}
          git --no-pager diff -- kustomization.yaml
        '''
        script {
          // Không có diff nghĩa là thẻ ấy ĐANG chạy. Dừng lại chứ không apply lại: một lượt
          // rollout không thay đổi gì vẫn là một lượt khởi động lại pod, và một dòng trong
          // nhật ký không tương ứng với thay đổi nào.
          def doi = sh(script: 'git diff --quiet -- deploy/overlays/${MT}/kustomization.yaml || echo doi',
                       returnStdout: true).trim()
          if (doi != 'doi') {
            error("${params.DICH_VU} ở ${params.MT} đã đang chạy thẻ ${params.THE}. Không có gì để làm.")
          }
        }
        withCredentials([gitUsernamePassword(credentialsId: params.GIT_CRED)]) {
          sh '''
            set -eu
            git config user.email "jenkins@vihat.vn"
            git config user.name  "Jenkins"
            git add deploy/overlays/${MT}/kustomization.yaml
            git commit -m "deploy(${MT}): ${DICH_VU} -> ${THE}

Bấm bởi: ${NGUOI_BAM}
Job: ${BUILD_URL}"
            git push origin HEAD:main
          '''
        }
      }
    }

    stage('Áp lên cụm') {
      steps {
        // TỪ DÒNG NÀY TRỞ ĐI CỤM CÓ THỂ ĐÃ ĐỔI, nên từ đây `post { failure }` mới được phép
        // rút lại. Đặt TRƯỚC `apply` chứ không sau: một `apply` đổ giữa chừng vẫn có thể đã
        // sửa xong một phần tài nguyên.
        script { env.DA_AP = 'roi' }

        withCredentials([file(credentialsId: params.KUBE_CRED, variable: 'KUBECONFIG')]) {
          sh '''
            set -eu
            # Không `--prune`. Xoá một tài nguyên là một hành động riêng, có người quyết —
            # không phải hệ quả phụ của một lượt deploy.
            kubectl apply -k deploy/overlays/${MT}
          '''
        }
      }
    }

    stage('Đợi rollout') {
      steps {
        withCredentials([file(credentialsId: params.KUBE_CRED, variable: 'KUBECONFIG')]) {
          // 6 phút: startupProbe cho phép tới 5 phút vì di trú CSDL chạy TRONG tiến trình
          // lúc khởi động và ôm advisory lock (core/migrate.Chay) — replica thứ hai đợi
          // replica thứ nhất. Timeout chặt hơn sẽ "thất bại" trong lúc mọi thứ vẫn đúng.
          sh '''
            set -eu
            kubectl -n ${NS} rollout status deploy/${DICH_VU} --timeout=6m
          '''
        }
      }
    }
  }

  post {
    failure {
      // `post { failure }` CHẠY CHO MỌI STAGE ĐỎ, kể cả các stage kiểm chạy TRƯỚC khi có gì
      // được áp lên cụm. Không có cờ `DA_AP` thì một lỗi gõ ở ô `THE` — đỏ ở 'Kiểm tham số',
      // trước cả khi job biết mình sẽ làm gì — vẫn chạy `rollout undo`, tức RÚT LẠI BẢN ĐANG
      // CHẠY ĐÚNG của một dịch vụ mà lượt này chưa hề đụng tới. `set +e` không che được: nó
      // chỉ giữ cho job khỏi đỏ thêm, lệnh vẫn thi hành. Lỗ này có sẵn từ trước; bản vá 'ai
      // bấm' thêm một đường đỏ sớm nữa nên nó phải được bịt cùng lượt.
      script {
        if (env.DA_AP != 'roi') {
          echo 'Đỏ TRƯỚC khi chạm cụm — không có gì để rút lại, cụm không bị đụng tới.'
        } else {
          // Quay lại bản trước Ở CỤM ngay. Commit ghim thẻ thì GIỮ NGUYÊN, không revert tự
          // động: nhật ký phải ghi cả lần thất bại. Rút lại nó là việc của người, ở lượt sau.
          withCredentials([file(credentialsId: params.KUBE_CRED, variable: 'KUBECONFIG')]) {
            sh '''
              set +e
              echo "THẤT BẠI — quay lại bản trước ở cụm"
              kubectl -n ${NS} rollout undo deploy/${DICH_VU}
              kubectl -n ${NS} rollout status deploy/${DICH_VU} --timeout=5m
              echo ""
              echo "Cụm đã về bản cũ. Commit ghim thẻ VẪN CÒN trong deploy/overlays/${MT}/ —"
              echo "chạy lại job này với thẻ cũ để nhật ký khớp với thực tế."
            '''
          }
        }
      }
    }
    success {
      echo "XONG  ${env.ANH}:${params.THE} đang chạy ở ${env.NS} — bấm bởi ${env.NGUOI_BAM}"
    }
  }
}

// ─────────────────────────────────────────────────────────────────────────────────────────
// AI BẤM LƯỢT NÀY — đọc từ NGUYÊN NHÂN của lượt build, không qua plugin nào.
//
// `BUILD_USER_ID` là biến của plugin `build-user-vars`, và máy chủ Jenkins này chỉ có bộ lõi
// (`Jenkinsfile` gốc, mục "VÌ SAO KHÔNG GỌI PLUGIN DOCKER PIPELINE"). Biến ấy vì thế LUÔN
// rỗng ở đây, nên dòng cũ `${BUILD_USER_ID:-khong-ro}` ghi `khong-ro` vào MỌI commit triển
// khai — và nó hỏng theo kiểu tệ nhất: không đỏ, không cảnh báo, chỉ là một nhật ký trông
// như đã trả lời câu "ai" trong khi chưa bao giờ trả lời.
//
// `currentBuild.getBuildCauses()` thuộc Pipeline lõi (`workflow-support`), không cần cài gì
// thêm — đó là lý do chọn nó thay vì đi xin cài plugin trên một máy chủ dùng chung.
//
// TRẢ VỀ CHUỖI RỖNG KHI KHÔNG BIẾT, KHÔNG BAO GIỜ TRẢ VỀ MỘT TÊN THAY THẾ. Nơi gọi mới là
// nơi quyết định làm gì với cái không biết ấy, và ở đây nó quyết định DỪNG. Một hàm tự bịa
// `khong-ro` là đúng cái khiếm khuyết đang được vá, viết lại ở chỗ khác.
String nguoiBam() {
  List nn
  try {
    nn = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')
  } catch (Throwable e) {
    // BẮT RỘNG, CÓ CHỦ Ý — và nó an toàn ĐÚNG VÌ nhánh này trả về rỗng. Bắt rộng chỉ nguy
    // hiểm khi nó nuốt lỗi rồi đi tiếp theo hướng dễ dãi; ở đây mọi thất bại đều dẫn tới
    // cùng một kết luận "không biết ai bấm", và nơi gọi DỪNG. Bản Pipeline cũ ném
    // `MissingMethodException` (một Exception) còn `NoSuchMethodError` là một Error —
    // `catch (Exception)` sẽ hụt nửa sau, và `catch (A | B)` thì đa-bắt từng vỡ dưới phép
    // biến đổi CPS của Jenkins.
    echo "Không đọc được nguyên nhân lượt build (${e.getClass().getSimpleName()}) — coi như không xác định được người bấm."
    return ''
  }
  if (nn == null || nn.isEmpty()) {
    return ''
  }
  def id = nn[0].userId
  return id == null ? '' : id.toString().trim()
}
