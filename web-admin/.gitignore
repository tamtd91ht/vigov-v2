# Bộ nhớ đệm của tsc --incremental. Là dấu vết của máy đang chạy, không phải của dự án:
# nó đổi sau mỗi lần kiểm kiểu và không nói lên điều gì về mã nguồn.
tsconfig.tsbuildinfo

# MapLibre's worker, copied from node_modules by scripts/copy-maplibre-worker.mjs on every build/dev
# start. Generated: committing it would let it drift from the installed maplibre-gl version.
public/maplibre/

# Roboto TTFs for the Tong quan PDF export, copied from node_modules by scripts/copy-pdf-fonts.mjs on every
# build/dev start. Generated: committing them would let them drift from the installed font package.
public/pdf-fonts/
