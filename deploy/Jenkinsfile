           description: 'Cho nen-ban-do: ngày bản dựng hằng ngày Protomaps, YYYYMMDD (có ở https://build.protomaps.com/<ngày>.pmtiles).')
    string(name: 'BAN_OVERTURE', defaultValue: '',
           description: 'Cho nen-ban-do: bản phát hành Overture Maps cho lớp địa điểm (vn-places.pmtiles), dạng 2026-09-23.1. ' +
                        'Overture chỉ giữ vài bản gần nhất — danh sách: https://overturemaps-us-west-2.s3.us-west-2.amazonaws.com/?list-type=2&prefix=release/&delimiter=/')
    booleanParam(name: 'CHAY_THU', defaultValue: true,
                 description: 'Cho nen-ban-do: CHẠY THỬ — in bucket, đích, giá trị BASEMAP_URL sẽ là; không tải, không ghi gì. ' +
                              'Cho lam-moi-csdl: chỉ in CSDL, số bảng, số tệp migration đã áp; không xoá gì. Bỏ tick để làm thật.')
    booleanParam(name: 'TAO_CSDL', defaultValue: false,
                 description: 'Cho tao-bang: TẠO CSDL trước khi tạo bảng — tên CSDL lấy từ DATABASE_DSN của từng dịch vụ; ' +
                              'đã có thì bỏ qua. DỪNG trước mọi thao tác nếu hai dịch vụ trùng tên CSDL (mỗi dịch vụ một CSDL — ' +
                              'deploy/README.md). Tài khoản trong DSN phải có quyền CREATEDB.')
  }

  environment {
    // Kubeconfig của ViGov — KHÔNG phải `rancher-omi.yaml` nằm cạnh nó (tên chỉ khác bốn ký tự;
    // chép nhầm là thao tác vào cụm của dự án khác).
    KUBECONFIG = '/u01/rancher/rancher-vigov.yaml'
  }

  stages {

    stage('Kiểm công cụ') {
      steps {
        script {
          // LƯỢT ĐẦU SAU KHI ĐỔI `parameters {}`: Jenkins chỉ HỌC danh sách tham số ở lượt ấy, nên
          // lượt ấy chạy với mọi `params.*` là null. Dừng trước mọi lệnh kubectl.
          if (params.HANH_DONG == null || params.MT == null) {
            error('Jenkins vừa học tham số mới của job — lượt này không có tham số nào.\n' +
                  'Bấm lại bằng "Build with Parameters". Cụm không bị đụng tới.')
          }
          // Một việc đã GỠ khỏi `choices` vẫn tới được đây qua "Rebuild" một lượt cũ (đo được
          // 25/09/2026: `sao-chep-tu-staging` chạy xanh mà không stage nào khớp). Xanh-mà-không-làm-
          // gì là dạng hỏng tệ nhất: người bấm tin là đã xong.
          //
          // THIS LIST MUST EQUAL `choices` OF HANH_DONG ABOVE, item for item. On 02/10/2026
          // `tao-tai-khoan-van-hanh` was added to `choices` but not here, so the job refused the one
          // action it had just offered ("không còn trong job này"). Add/remove an action in BOTH places.
          if (!(params.HANH_DONG in ['kiem-tra', 'xem-log', 'tao-bang', 'lam-moi-csdl', 'doi-ten-mien-thang-binh', 'tao-xa-thang-binh',
                                  'gan-mini-app-thang-binh', 'doi-app-id-thang-binh',
                                  'tao-khoa-ma-hoa-identity', 'mo-netpol-identity-zalo', 'bo-sung-cau-hinh-identity',
                                  'bo-sung-cau-hinh-petitions',
                                  'kiem-tra-dang-nhap-app-rieng',
                                  'dat-secret-mini-app',
                                  'dung-clamav', 'tao-tai-khoan-van-hanh', 'cap-quyen-van-hanh', 'chi-dinh-owner',
                                  'di-tru-vihat-miniapp', 'bat-cau-phien-miniapp', 'nen-ban-do'])) {
            error("HANH_DONG '${params.HANH_DONG}' không còn trong job này (đã gỡ). " +
                  'Bấm "Build with Parameters" và chọn lại trong danh sách — đừng "Rebuild" một lượt cũ.')
          }
          env.HANH_DONG = params.HANH_DONG
          env.MT = params.MT
          env.DICH_VU = params.DICH_VU
          env.NS = "vigov-${params.MT}"

          env.NGUOI_BAM = nguoiBam()
          if (!env.NGUOI_BAM) {
            error('KHÔNG XÁC ĐỊNH ĐƯỢC AI BẤM LƯỢT NÀY — dừng. Lịch sử build của job này là nhật ký ' +
                  'thay đổi hạ tầng; một dòng không có tên người không trả lời được câu thanh tra sẽ hỏi.')
          }
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.HANH_DONG} · ${env.NS} · ${env.NGUOI_BAM}"
        }
        sh '''
          set -eu
          command -v kubectl >/dev/null 2>&1 || { echo "MÁY CHỦ BUILD THIẾU: kubectl"; exit 1; }
          if [ ! -r "$KUBECONFIG" ]; then
            echo "KHÔNG ĐỌC ĐƯỢC KUBECONFIG: $KUBECONFIG"; exit 1
          fi
          kubectl version --client
          echo "cụm: $(kubectl config current-context) · namespace: $NS · việc: $HANH_DONG · bấm bởi: $NGUOI_BAM"
          echo "commit của kho: $(git rev-parse --short=12 HEAD)"
        '''
      }
    }

    stage('Kiểm tra') {
      steps {
        sh '''
          set -u
          echo "── namespace"
          kubectl get ns "$NS" || echo "   (không đọc được namespace $NS)"
          echo "── Deployment + ảnh đang chạy"
          kubectl -n "$NS" get deploy -o wide || true
          echo "── Pod"
          kubectl -n "$NS" get pod -o wide || true
          echo "── Service · Ingress · ConfigMap · NetworkPolicy"
          kubectl -n "$NS" get svc,ingress,configmap,networkpolicy || true
          echo "── Secret (CHỈ TÊN và LOẠI — không in giá trị)"
          kubectl -n "$NS" get secret -o custom-columns=TEN:.metadata.name,LOAI:.type \
            --no-headers 2>/dev/null | awk '{print "   " $1 "  " $2}' || true
          # TÊN KEY, không giá trị: go-template chỉ duyệt khoá của `.data`.
          echo "── Key của từng Secret (CHỈ TÊN KEY)"
          kubectl -n "$NS" get secret -o go-template='{{range .items}}   {{.metadata.name}}:{{range $k, $v := .data}} {{$k}}{{end}}{{"\\n"}}{{end}}' 2>/dev/null || true
          echo "── Key của từng ConfigMap (CHỈ TÊN KEY)"
          kubectl -n "$NS" get configmap -o go-template='{{range .items}}   {{.metadata.name}}:{{range $k, $v := .data}} {{$k}}{{end}}{{"\\n"}}{{end}}' 2>/dev/null || true
          echo "── Deployment đọc Secret/ConfigMap nào (envFrom) và biến env đặt thẳng"
          kubectl -n "$NS" get deploy -o go-template='{{range .items}}   {{.metadata.name}}:{{range .spec.template.spec.containers}}{{range .envFrom}}{{if .secretRef}} secret/{{.secretRef.name}}{{end}}{{if .configMapRef}} configmap/{{.configMapRef.name}}{{end}}{{end}} | env:{{range .env}} {{.name}}{{end}}{{end}}{{"\\n"}}{{end}}' 2>/dev/null || true
          echo "── Sự kiện gần nhất"
          kubectl -n "$NS" get events --sort-by=.lastTimestamp 2>/dev/null | tail -25 || true
        '''
        script {
          // Secret + ConfigMap mà các Deployment dựng theo staging đọc (`envFrom`).
          env.THIEU = sh(returnStdout: true, script: '''
            set -u
            thieu=""
            for s in harbor-vigov platform-secrets identity-secrets comms-secrets documents-secrets \
                     finance-secrets petitions-secrets reporting-secrets; do
              kubectl -n "$NS" get secret "$s" >/dev/null 2>&1 || thieu="$thieu secret/$s"
            done
            kubectl -n "$NS" get configmap common-config >/dev/null 2>&1 || thieu="$thieu configmap/common-config"
            echo "$thieu"
          ''').trim()
          if (env.THIEU) {
            echo "⚠ THIẾU trong ${env.NS}: ${env.THIEU}"
          } else {
            echo "✓ đủ 8 Secret + common-config trong ${env.NS}"
          }
        }
      }
    }

    // Owner 14/10/2026: `kiem-tra` also reports each service's OWN database — reachable, table count,
    // and the `schema_migration` ledger against the migration files of this checkout. A separate stage
    // with a `when`, because 'Kiểm tra' above runs before EVERY action and seven pods would slow them all.
    //
    // Read-only by its SQL (the DSN owns its tables and could write — nothing here does). The DSN never
    // enters a shell variable or the log: each pod reads it from `<service>-secrets` via envFrom, and a
    // failed connection is reported as a CATEGORY, never psql's message (it names host and user).
    //
    // The checksum is hex SHA-256 of the raw file, the same as core/migrate (migrate.go). A file applied
    // and later edited shows as LỆCH here before it stops a service at startup — the 0001 platform/
    // identity comment edit in the ledger (`migration-0001-da-ap-bi-sua-chu-thich`) is that case.
    // The comparison is against THIS JOB'S CHECKOUT (main); vigov-dev runs images built from `dev`, so
    // for MT=dev "chưa áp" may just mean dev is ahead of main — the commit is printed for that reason.
    stage('Kiểm CSDL') {
      when { expression { params.HANH_DONG == 'kiem-tra' } }
      steps {
        sh '''
          set +x
          set -u
          umask 077
          TMP_DIR=$(mktemp -d)
          PODS=""
          trap 'for p in $PODS; do kubectl -n "$NS" delete pod "$p" --ignore-not-found --wait=false >/dev/null 2>&1 || true; done; rm -rf "$TMP_DIR"' EXIT

          # Runs INSIDE the pod. Line 1: OK|<db>|<tables>|<t|f ledger exists> or ERR|<category>; then
          # L|<file> <checksum> per ledger row. No backslash anywhere: this text sits in a Groovy string.
          cat > "$TMP_DIR/probe.sh" <<'PROBE'
set -u
# CASE, not a bare boolean: text || boolean renders 'true'/'false', never 't' — until 15/10/2026 every
# database with tables was reported as having NO ledger, while seven services ran on theirs.
q="SELECT current_database() || '|' || (SELECT count(*) FROM information_schema.tables WHERE table_type = 'BASE TABLE' AND table_schema NOT IN ('pg_catalog', 'information_schema')) || '|' || (CASE WHEN to_regclass('public.schema_migration') IS NULL THEN 'f' ELSE 't' END)"
if out=$(psql "$DATABASE_DSN" -X -At -v ON_ERROR_STOP=1 -c "$q" 2>/tmp/err); then
  echo "OK|$out"
  case "$out" in
    *'|t') psql "$DATABASE_DSN" -X -At -F ' ' -c "SELECT ten, checksum FROM schema_migration ORDER BY ten" 2>/dev/null | while read -r l; do echo "L|$l"; done ;;
  esac
else
  e=$(cat /tmp/err)
  case "$e" in
    *'database "'*'does not exist'*) c=csdl-chua-tao ;;
    *'password authentication failed'*|*'role "'*'does not exist'*|*'no pg_hba.conf entry'*) c=sai-tai-khoan-hoac-chua-cap-quyen ;;
    *'could not translate host'*|*'Connection refused'*|*'timeout'*|*'timed out'*|*'No route'*) c=khong-toi-duoc-may-chu ;;
    *SSL*|*ssl*|*certificate*) c=loi-tls ;;
    *) c=loi-ket-noi-khac ;;
  esac
  echo "ERR|$c"
fi
PROBE
          PROBE_B64=$(base64 -w0 "$TMP_DIR/probe.sh")

          SERVICES="platform identity comms documents finance petitions reporting"
          for s in $SERVICES; do
            sec="$s-secrets"
            has=$(kubectl -n "$NS" get secret "$sec" \\
                    -o go-template='{{range $k, $v := .data}}{{if eq $k "DATABASE_DSN"}}yes{{end}}{{end}}' 2>/dev/null || true)
            if [ -z "$has" ]; then
              echo "ERR|thieu-secret-$sec-hoac-key-DATABASE_DSN" > "$TMP_DIR/$s.log"
              continue
            fi
            pod="kiem-csdl-$s-$BUILD_NUMBER"
            printf '%s' '{"apiVersion":"v1","spec":{"restartPolicy":"Never",
              "imagePullSecrets":[{"name":"dockerhub-omicrm"}],
              "containers":[{"name":"psql","image":"postgres:16-alpine",
                "envFrom":[{"secretRef":{"name":"'"$sec"'"}}],
                "env":[{"name":"PROBE_B64","value":"'"$PROBE_B64"'"}],
                "command":["sh","-c","echo \\"$PROBE_B64\\" | base64 -d > /tmp/probe.sh && sh /tmp/probe.sh"]}]}}' \\
              > "$TMP_DIR/$s.json"
            if kubectl -n "$NS" run "$pod" --restart=Never --image=postgres:16-alpine \\
                 --overrides="$(cat "$TMP_DIR/$s.json")" --quiet >/dev/null 2>&1; then
              PODS="$PODS $pod"
            else
              echo "ERR|khong-dung-duoc-pod" > "$TMP_DIR/$s.log"
            fi
          done

          # All seven run at once; wait up to 5 minutes for the slowest.
          n=0
          while [ $n -lt 60 ]; do
            left=0
            for p in $PODS; do
              pha=$(kubectl -n "$NS" get pod "$p" -o jsonpath='{.status.phase}' 2>/dev/null || true)
              case "$pha" in Succeeded|Failed) ;; *) left=$((left + 1)) ;; esac
            done
            [ $left -eq 0 ] && break
            sleep 5; n=$((n + 1))
          done
          for s in $SERVICES; do
            p="kiem-csdl-$s-$BUILD_NUMBER"
            case " $PODS " in *" $p "*) ;; *) continue ;; esac
            pha=$(kubectl -n "$NS" get pod "$p" -o jsonpath='{.status.phase}' 2>/dev/null || true)
            if [ "$pha" = "Succeeded" ]; then
              kubectl -n "$NS" logs "$p" > "$TMP_DIR/$s.log" 2>/dev/null || echo "ERR|khong-doc-duoc-log" > "$TMP_DIR/$s.log"
            else
              echo "ERR|pod-dung-o-pha-${pha:-khong-ro}" > "$TMP_DIR/$s.log"
              kubectl -n "$NS" describe pod "$p" 2>/dev/null | sed -n '/^Events:/,$p' | tail -8 || true
            fi
          done

          echo "── CSDL của từng dịch vụ trong $NS · so với migration của kho @ $(git rev-parse --short=12 HEAD)"
          printf '   %-10s %-22s %6s  %s\\n' "DỊCH VỤ" "CSDL" "BẢNG" "MIGRATION"
          canh=0
          for s in $SERVICES; do
            head1=$(head -n 1 "$TMP_DIR/$s.log" 2>/dev/null || echo "ERR|khong-co-ket-qua")
            case "$head1" in
              OK\\|*) ;;
              *) printf '   %-10s %s\\n' "$s" "✗ ${head1#ERR|}"; canh=1; continue ;;
            esac
            db=$(echo "$head1" | cut -d'|' -f2)
            tables=$(echo "$head1" | cut -d'|' -f3)
            ledger=$(echo "$head1" | cut -d'|' -f4)
            grep '^L|' "$TMP_DIR/$s.log" | cut -c3- | sort > "$TMP_DIR/$s.ledger" || true
            for f in service-$s/migrations/*.sql; do
              [ -f "$f" ] && printf '%s %s\\n' "${f##*/}" "$(sha256sum "$f" | cut -d' ' -f1)"
            done | sort > "$TMP_DIR/$s.repo"
            if [ "$ledger" != "t" ]; then
              if [ "$tables" = "0" ]; then
                ket="CSDL rỗng — chưa áp migration nào ($(wc -l < "$TMP_DIR/$s.repo") tệp chờ)"
              else
                ket="⚠ CÓ $tables BẢNG mà KHÔNG có sổ schema_migration — tao-bang sẽ DỪNG ở đây; khởi động dịch vụ thì KHÔNG dừng mà áp lại từ 0001 (ADR 0013 §Sửa đổi 14/10/2026). Người quyết, đừng khởi động trước"; canh=1
              fi
            else
              ket=$(awk 'NR==FNR { r[$1] = $2; next }
                         { l[$1] = $2; n++; last = $1 }
                         END {
                           for (k in r) if (!(k in l)) pend++
                           for (k in l) { if (!(k in r)) extra++; else if (l[k] != r[k]) { bad++; badn = badn " " k } }
                           printf "đã áp %d (cuối: %s) · chưa áp %d", n, (n ? last : "-"), pend
                           if (extra) printf " · ⚠ CSDL có %d tệp kho KHÔNG có (ảnh mới hơn kho?)", extra
                           if (bad) printf " · ⚠ LỆCH checksum:%s", badn
                         }' "$TMP_DIR/$s.repo" "$TMP_DIR/$s.ledger")
              case "$ket" in *⚠*) canh=1 ;; esac
            fi
            printf '   %-10s %-22s %6s  %s\\n' "$s" "$db" "$tables" "$ket"
          done
          if [ $canh -ne 0 ]; then
            echo "⚠ Có dịch vụ cần xử lý (dòng ✗/⚠ ở trên). Việc này chỉ ĐỌC — không đổi gì."
          else
            echo "✓ Bảy CSDL nối được, sổ migration khớp kho."
          fi
        '''
      }
    }

    // Owner 14/10/2026: create each service's tables AHEAD of the service, so a fresh database (vigov-dev's
    // own, ADR 0046 §Sửa đổi 14/10/2026) is not first touched by a starting pod. It runs the SAME runner as
    // startup — `/server -migrate-only` in the Deployment's CURRENT image (owner's choice: the schema then
    // matches the code that serves it) — so the ledger, checksums and advisory lock are core/migrate's
    // own; there is no second migration runner to drift from the first (ADR 0013 §Sửa đổi 14/10/2026).
    //
    // "Already there → skip, no error" is the ledger's existing behaviour. A MISMATCH (tables without a
    // ledger, an applied file edited, a database ahead of the image) STOPS that service with nothing
    // applied — owner's choice, and ADR 0013: archival records wait for a person, never an auto-fix.
    // "Tables without a ledger" is checked by the -migrate-only path ONLY (core/migrate/only.go); the
    // startup path still creates the ledger and re-applies 0001 — a known gap, ADR 0013 §Sửa đổi.
    //
    // An image built before this mode ignores the argument and starts the real server (which also migrates
    // at startup, but then serves): no `migrate-only:` marker within 60 s means old image → pod deleted,
    // service reported, nothing else assumed. The pod carries its own label, NOT the Deployment's, so the
    // Service never routes traffic to it — if a NetworkPolicy then blocks its database egress, the log says so.
    stage('Tạo bảng') {
      when { expression { params.HANH_DONG == 'tao-bang' } }
      steps {
        script {
          if (!(params.MT in ['prod', 'dev'])) { error("tao-bang: MT '${params.MT}' không hợp lệ.") }
          if (params.XAC_NHAN != env.NS) {
            error("XAC_NHAN phải là đúng '${env.NS}' (namespace của MT). Nhận được: '${params.XAC_NHAN}'. Không làm gì cả.")
          }
          // null on the first run after this parameter was added — treated as unticked.
          env.TAO_CSDL = (params.TAO_CSDL == true) ? 'yes' : ''
        }
        sh '''
          set +x
          set -u
          umask 077
          TMP_DIR=$(mktemp -d)
          PODS=""
          trap 'for p in $PODS; do kubectl -n "$NS" delete pod "$p" --ignore-not-found --wait=false >/dev/null 2>&1 || true; done; rm -rf "$TMP_DIR"' EXIT
          SERVICES="platform identity comms documents finance petitions reporting"

          # ── TAO_CSDL (owner 14/10/2026): create the database a DSN names when it is missing.
          # Step 0 runs BEFORE anything is created, for all seven: read each database NAME (only the name,
          # filtered inside the pipe — the DSN never enters a variable) and refuse if two services share one.
          # Measured on prod the same day: all seven DSNs named `vigov_comms`. Creating it would have let the
          # first service own the ledger and stopped the other six on a checksum mismatch — and mixed seven
          # audit trails into one table if any got through (deploy/README.md, "bảy CSDL khác nhau").
          if [ -n "${TAO_CSDL:-}" ]; then
            echo "── TAO_CSDL: tên CSDL trong DATABASE_DSN của từng dịch vụ"
            : > "$TMP_DIR/dbnames"
            bad=""
            for s in $SERVICES; do
              name=$(kubectl -n "$NS" get secret "$s-secrets" -o go-template='{{index .data "DATABASE_DSN"}}' 2>/dev/null \\
                       | base64 -d 2>/dev/null | sed -e 's/[?].*//' -e 's#.*/##' -e 's/.*dbname=\\([^ ]*\\).*/\\1/' \\
                       | grep -xE '[a-z_][a-z0-9_]{0,62}' || true)
              if [ -z "$name" ]; then
                echo "   ✗ $s: không đọc được tên CSDL (thiếu secret/$s-secrets, thiếu DATABASE_DSN, hoặc tên có chữ HOA/ký tự lạ)"
                bad=yes; continue
              fi
              printf '   %-10s %s\\n' "$s" "$name"
              echo "$name $s" >> "$TMP_DIR/dbnames"
            done
            dup=$(cut -d' ' -f1 "$TMP_DIR/dbnames" | sort | uniq -d)
            if [ -n "$dup" ]; then
              for d in $dup; do
                echo "   ✗ CSDL '$d' bị dùng chung bởi:$(grep "^$d " "$TMP_DIR/dbnames" | cut -d' ' -f2 | tr '\\n' ' ')"
              done
              bad=yes
            fi
            if [ -n "$bad" ]; then
              echo "DỪNG — chưa tạo gì. Mỗi dịch vụ phải có CSDL RIÊNG: sửa DATABASE_DSN trong <dịch vụ>-secrets rồi chạy lại."
              exit 1
            fi
          fi

          # Runs INSIDE a postgres:16-alpine pod: connects with the SAME credentials to the `postgres`
          # maintenance database, creates $DB_NAME if pg_database lacks it. The creator is the DSN's own
          # account, so the service owns its database and core/migrate can create its tables. $DB_NAME is
          # lowercase [a-z0-9_] (checked above), so it needs no quoting. Prints CO-SAN · DA-TAO · ERR|<label>.
          cat > "$TMP_DIR/createdb.sh" <<'CREATEDB'
set -u
case "$DATABASE_DSN" in
  *://*) admin=$(printf '%s' "$DATABASE_DSN" | sed -E 's#^([^:]+://[^/]+)/[^?]*#\\1/postgres#') ;;
  *) admin=$(printf '%s' "$DATABASE_DSN" | sed -E 's/(^|[[:space:]])dbname=[^[:space:]]*/\\1dbname=postgres/') ;;
esac
label() {
  e=$(cat /tmp/err)
  case "$e" in
    *'permission denied to create database'*) echo khong-co-quyen-CREATEDB ;;
    *'password authentication failed'*|*'role "'*'does not exist'*|*'no pg_hba.conf entry'*) echo sai-tai-khoan-hoac-chua-cap-quyen ;;
    *'could not translate host'*|*'Connection refused'*|*'timeout'*|*'timed out'*|*'No route'*) echo khong-toi-duoc-may-chu ;;
    *'database "postgres" does not exist'*) echo khong-vao-duoc-csdl-postgres ;;
    *SSL*|*ssl*|*certificate*) echo loi-tls ;;
    *) echo loi-khac ;;
  esac
}
if ! have=$(psql "$admin" -X -At -v ON_ERROR_STOP=1 -c "SELECT 1 FROM pg_database WHERE datname = '$DB_NAME'" 2>/tmp/err); then
  echo "ERR|$(label)"; exit 0
fi
if [ "$have" = "1" ]; then echo CO-SAN; exit 0; fi
if psql "$admin" -X -q -v ON_ERROR_STOP=1 -c "CREATE DATABASE $DB_NAME" 2>/tmp/err; then echo DA-TAO; else echo "ERR|$(label)"; fi
CREATEDB
          CREATEDB_B64=$(base64 -w0 "$TMP_DIR/createdb.sh")

          # ensure_db <service> — 0 when the database exists (already, or created now).
          ensure_db() {
            db=$(grep " $1\\$" "$TMP_DIR/dbnames" | cut -d' ' -f1)
            cpod="vigov-createdb-$1-$BUILD_NUMBER"
            PODS="$PODS $cpod"
            printf '%s' '{"apiVersion":"v1","kind":"Pod","metadata":{"name":"'"$cpod"'","labels":{"app.kubernetes.io/name":"vigov-createdb"}},
              "spec":{"restartPolicy":"Never","imagePullSecrets":[{"name":"dockerhub-omicrm"}],
              "containers":[{"name":"psql","image":"postgres:16-alpine",
                "envFrom":[{"secretRef":{"name":"'"$1"'-secrets"}}],
                "env":[{"name":"DB_NAME","value":"'"$db"'"},{"name":"CREATEDB_B64","value":"'"$CREATEDB_B64"'"}],
                "command":["sh","-c","echo \\"$CREATEDB_B64\\" | base64 -d > /tmp/c.sh && sh /tmp/c.sh"]}]}}' \\
              > "$TMP_DIR/cpod.json"
            kubectl -n "$NS" create -f "$TMP_DIR/cpod.json" >/dev/null || { echo "   ✗ CSDL $db: không tạo được pod."; return 1; }
            cph=""; j=0
            while [ $j -lt 24 ]; do   # 2 minutes
              cph=$(kubectl -n "$NS" get pod "$cpod" -o jsonpath='{.status.phase}' 2>/dev/null || true)
              case "$cph" in Succeeded|Failed) break ;; esac
              sleep 5; j=$((j+1))
            done
            res=$(kubectl -n "$NS" logs "$cpod" 2>/dev/null | tail -n 1)
            kubectl -n "$NS" delete pod "$cpod" --ignore-not-found --wait=false >/dev/null 2>&1 || true
            case "$res" in
              CO-SAN) echo "   CSDL $db: đã có — bỏ qua"; return 0 ;;
              DA-TAO) echo "   CSDL $db: ĐÃ TẠO"; return 0 ;;
              ERR\\|*) echo "   ✗ CSDL $db: ${res#ERR|}"; return 1 ;;
              *) echo "   ✗ CSDL $db: pod dừng ở pha '${cph:-không rõ}', không có kết quả"; return 1 ;;
            esac
          }

          # Order of deploy/README.md: platform, then identity, then the rest. Each database is its own, so
          # one service failing does not stop the next — every result is reported, and the job ends red.
          ok=""; skipped=""; failed=""
          for s in $SERVICES; do
            DEP="vigov-service-$s"
            echo "════ $s"
            if ! kubectl -n "$NS" get deploy "$DEP" >/dev/null 2>&1; then
              echo "   ✗ chưa có deploy/$DEP trong $NS — bấm job dịch vụ trước (tao-bang dùng ảnh của Deployment)."
              failed="$failed $s"; continue
            fi
            n=$(kubectl -n "$NS" get deploy "$DEP" -o go-template='{{len .spec.template.spec.containers}}')
            if [ "$n" != "1" ]; then
              echo "   ✗ deploy/$DEP có $n container — không biết lấy ảnh nào."; failed="$failed $s"; continue
            fi
            get_field() { kubectl -n "$NS" get deploy "$DEP" -o jsonpath="$1"; }
            IMG=$(get_field '{.spec.template.spec.containers[0].image}')
            get_field '{.spec.template.spec.containers[0].envFrom}' > "$TMP_DIR/envfrom"
            get_field '{.spec.template.spec.containers[0].env}' > "$TMP_DIR/env"
            get_field '{.spec.template.spec.imagePullSecrets}' > "$TMP_DIR/pull"
            for f in envfrom env pull; do [ -s "$TMP_DIR/$f" ] || printf '[]' > "$TMP_DIR/$f"; done
            echo "   ảnh: $IMG"
            if [ -n "${TAO_CSDL:-}" ] && ! ensure_db "$s"; then
              echo "     Không tạo bảng cho $s khi chưa có CSDL."; failed="$failed $s"; continue
            fi

            pod="vigov-migrate-$s-$BUILD_NUMBER"
            PODS="$PODS $pod"
            {
              printf '{"apiVersion":"v1","kind":"Pod","metadata":{"name":"%s","labels":{"app.kubernetes.io/name":"vigov-migrate-only"}},' "$pod"
              printf '"spec":{"restartPolicy":"Never","imagePullSecrets":'; cat "$TMP_DIR/pull"
              printf ',"containers":[{"name":"migrate","image":"%s","envFrom":' "$IMG"; cat "$TMP_DIR/envfrom"
              printf ',"env":'; cat "$TMP_DIR/env"
              printf ',"command":["/server","-migrate-only"]}]}}'
            } > "$TMP_DIR/pod.json"
            if ! kubectl -n "$NS" create -f "$TMP_DIR/pod.json" >/dev/null; then
              echo "   ✗ không tạo được pod."; failed="$failed $s"; continue
            fi

            phase=""; i=0; old=""
            while [ $i -lt 60 ]; do   # 60 × 5 s = 5 minutes, the runner's own budget
              phase=$(kubectl -n "$NS" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)
              case "$phase" in Succeeded|Failed) break ;; esac
              if [ "$phase" = "Running" ] && [ $i -ge 12 ] && \\
                 ! kubectl -n "$NS" logs "$pod" 2>/dev/null | grep -q '^migrate-only:'; then
                old=yes; break
              fi
              sleep 5; i=$((i+1))
            done
            kubectl -n "$NS" logs "$pod" > "$TMP_DIR/$s.log" 2>&1 || true
            kubectl -n "$NS" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true

            # No marker at all = an image built before -migrate-only, WHATEVER the phase. Measured on prod
            # 14/10/2026 (run with images 757be2524d28): the old server ignores the argument, starts, and
            # its pod ends Failed within ~6 s — the first version of this check waited for 60 s of Running
            # and so reported all seven as "sổ lệch" while hiding the real log. Show the tail instead.
            if [ -z "$old" ] && ! grep -q '^migrate-only:' "$TMP_DIR/$s.log"; then
              old=yes
            fi
            if [ -n "$old" ]; then
              echo "   ⚠ ẢNH CŨ — chưa có chế độ -migrate-only (không in dòng mốc 'migrate-only:'); pod ở pha '${phase:-không rõ}', đã gỡ."
              echo "     CHƯA tạo bảng nào cho $s. Bấm job service-$s để lên ảnh từ commit có -migrate-only rồi chạy lại tao-bang."
              echo "     20 dòng cuối log của server cũ trong pod (để thấy vì sao nó dừng):"
              tail -n 20 "$TMP_DIR/$s.log" | cut -c1-400 | sed 's/^/       │ /'
              skipped="$skipped $s"; continue
            fi
            # Only the runner's own lines: they carry file names and counts, never the DSN (core/migrate).
            grep '^migrate-only:\\|^ *[0-9][0-9][0-9][0-9]_.*[.]sql$' "$TMP_DIR/$s.log" | sed 's/^/   /' || true
            if [ "$phase" = "Succeeded" ] && grep -q "^migrate-only: $s ok" "$TMP_DIR/$s.log"; then
              ok="$ok $s"
            elif grep -q "^migrate-only: $s FAILED: \\(cannot reach the database\\|open database\\|configuration\\)" "$TMP_DIR/$s.log"; then
              # Not a ledger problem — say what it is (prod 14/10/2026 printed "sổ lệch" for a missing database).
              echo "   ✗ KHÔNG NỐI ĐƯỢC CSDL / thiếu cấu hình — đọc dòng FAILED ở trên. CSDL chưa có: chạy lại với TAO_CSDL;"
              echo "     sai DSN: sửa DATABASE_DSN trong $s-secrets. Chưa áp gì."
              failed="$failed $s"
            else
              echo "   ✗ dừng ở pha '${phase:-không rõ}' — không áp tiếp dịch vụ này. Đọc dòng migrate-only ở trên;"
              echo "     sổ lệch (checksum / CSDL mới hơn ảnh / có bảng không có sổ) là việc của NGƯỜI, không tự sửa."
              failed="$failed $s"
            fi
          done

          echo ""
          echo "── xong:${ok:- (không)}"
          [ -z "$skipped" ] || echo "── ẢNH CŨ, CHƯA tạo bảng:$skipped — lên ảnh mới cho các dịch vụ này trước"
          [ -z "$failed" ] || echo "── HỎNG:$failed"
          echo "Kiểm lại: HANH_DONG=kiem-tra cùng MT — phần CSDL phải báo 'chưa áp 0' cho các dịch vụ trên."
          # Red while any service is left without its tables: a green run must mean "tables are there".
          [ -z "$failed" ] && [ -z "$skipped" ]
        '''
      }
    }

    // Owner 15/10/2026 (ADR 0096): wipe every service's tables so `tao-bang` rebuilds them from the
    // migrations as they now stand. Needed because ADR 0096 rewrote ALREADY-APPLIED migration files
    // (partition reduction): every existing ledger now mismatches its checksums and core/migrate refuses
    // to start the service (ADR 0013 #5). Allowed only while a namespace holds TEST data — once a
    // commune's real records live there this action destroys archival records (rule 7) and must go.
    //
    // ORDER MATTERS. Run it AFTER the seven service jobs have deployed images built from the rewritten
    // migrations (those pods crash-loop on the checksum until now). A pod of an OLD image restarting
    // after the wipe would happily re-create the OLD schema, and the new image would then stop on it.
    //
    // Per service, one transaction: DROP SCHEMA public CASCADE; CREATE SCHEMA public. The migrations
    // create everything in `public` and nothing else — no extension, no event trigger, no other schema
    // (checked 15/10/2026). lock_timeout 30 s: a session holding a lock makes it fail closed, not hang.
    // GRANT USAGE … TO PUBLIC restores what PostgreSQL's own `public` schema carries; a bare CREATE SCHEMA
    // does not, and an account other than the DSN's — a read-only login — would then be refused the whole
    // schema. Grants that roles held on the OLD tables are gone with them either way.
    // Refuses before touching anything when two services share one database name (prod, 14/10/2026):
    // wiping one would silently wipe another's ledger. vihat-miniapp's database is not among the seven.
    stage('Làm mới CSDL') {
      when { expression { params.HANH_DONG == 'lam-moi-csdl' } }
      steps {
        script {
          if (!(params.MT in ['prod', 'dev'])) { error("lam-moi-csdl: MT '${params.MT}' không hợp lệ.") }
          // null on the first run after CHAY_THU gained this meaning — treated as a dry run.
          env.CHE_DO = (params.CHAY_THU == false) ? 'that' : 'thu'
          if (env.CHE_DO == 'that' && params.XAC_NHAN != "xoa-sach-${env.NS}") {
            error("Làm thật cần XAC_NHAN đúng 'xoa-sach-${env.NS}'. Nhận được: '${params.XAC_NHAN}'. Không xoá gì.")
          }
        }
        sh '''
          set +x
          set -u
          umask 077
          TMP_DIR=$(mktemp -d)
          PODS=""
          trap 'for p in $PODS; do kubectl -n "$NS" delete pod "$p" --ignore-not-found --wait=false >/dev/null 2>&1 || true; done; rm -rf "$TMP_DIR"' EXIT
          SERVICES="platform identity comms documents finance petitions reporting"
          if [ "$CHE_DO" = "that" ]; then echo "══ LÀM THẬT — xoá sạch bảng của 7 dịch vụ trong $NS"; else echo "══ CHẠY THỬ — chỉ đọc, không xoá gì"; fi

          # Step 0, before anything is touched: each database NAME (filtered inside the pipe — the DSN never
          # enters a variable), refusing when two services share one. Same filter as 'Tạo bảng'.
          echo "── tên CSDL trong DATABASE_DSN của từng dịch vụ"
          : > "$TMP_DIR/dbnames"
          bad=""
          for s in $SERVICES; do
            name=$(kubectl -n "$NS" get secret "$s-secrets" -o go-template='{{index .data "DATABASE_DSN"}}' 2>/dev/null \\
                     | base64 -d 2>/dev/null | sed -e 's/[?].*//' -e 's#.*/##' -e 's/.*dbname=\\([^ ]*\\).*/\\1/' \\
                     | grep -xE '[a-z_][a-z0-9_]{0,62}' || true)
            if [ -z "$name" ]; then
              echo "   ✗ $s: không đọc được tên CSDL (thiếu secret/$s-secrets, thiếu DATABASE_DSN, hoặc tên có chữ HOA/ký tự lạ)"
              bad=yes; continue
            fi
            echo "$name $s" >> "$TMP_DIR/dbnames"
          done
          dup=$(cut -d' ' -f1 "$TMP_DIR/dbnames" | sort | uniq -d)
          for d in $dup; do
            echo "   ✗ CSDL '$d' bị dùng chung bởi:$(grep "^$d " "$TMP_DIR/dbnames" | cut -d' ' -f2 | tr '\\n' ' ')"
            bad=yes
          done
          if [ -n "$bad" ]; then
            echo "DỪNG — chưa xoá gì. Mỗi dịch vụ phải có CSDL RIÊNG (deploy/README.md)."
            exit 1
          fi

          # Runs INSIDE a postgres:16-alpine pod. Prints INFO|<db>|<tables>|<ledger rows or ->, then, when
          # CHE_DO=that, DONE|<relations left> or ERR|<category> — never psql's message (it names host/user).
          cat > "$TMP_DIR/wipe.sh" <<'WIPE'
set -u
if ! info=$(psql "$DATABASE_DSN" -X -At -v ON_ERROR_STOP=1 -c "SELECT current_database() || '|' || (SELECT count(*) FROM pg_class WHERE relnamespace = 'public'::regnamespace AND relkind IN ('r', 'p')) || '|' || (CASE WHEN to_regclass('public.schema_migration') IS NULL THEN 'f' ELSE 't' END)" 2>/tmp/err); then
  echo "ERR|khong-noi-duoc-csdl"; exit 0
fi
ledger=-
case "$info" in *'|t') ledger=$(psql "$DATABASE_DSN" -X -At -c "SELECT count(*) FROM schema_migration" 2>/dev/null || echo '?') ;; esac
echo "INFO|${info%|*}|$ledger"
[ "$CHE_DO" = "that" ] || exit 0
if psql "$DATABASE_DSN" -X -q -v ON_ERROR_STOP=1 -1 -c "SET LOCAL lock_timeout = '30s'" -c "DROP SCHEMA public CASCADE" -c "CREATE SCHEMA public" -c "GRANT USAGE ON SCHEMA public TO PUBLIC" 2>/tmp/err; then
  left=$(psql "$DATABASE_DSN" -X -At -c "SELECT count(*) FROM pg_class WHERE relnamespace = 'public'::regnamespace" 2>/dev/null || echo '?')
  echo "DONE|$left"
else
  e=$(cat /tmp/err)
  case "$e" in
    *'must be owner'*) echo "ERR|tai-khoan-trong-DSN-khong-so-huu-schema-public" ;;
    *'lock timeout'*) echo "ERR|co-phien-dang-giu-khoa-bang--chay-lai-sau" ;;
    *) echo "ERR|xoa-khong-duoc" ;;
  esac
fi
WIPE
          WIPE_B64=$(base64 -w0 "$TMP_DIR/wipe.sh")

          ok=""; failed=""
          printf '   %-10s %-22s %7s %8s  %s\\n' "DỊCH VỤ" "CSDL" "BẢNG" "ĐÃ ÁP" "KẾT QUẢ"
          for s in $SERVICES; do
            pod="vigov-lam-moi-$s-$BUILD_NUMBER"
            PODS="$PODS $pod"
            printf '%s' '{"apiVersion":"v1","kind":"Pod","metadata":{"name":"'"$pod"'","labels":{"app.kubernetes.io/name":"vigov-lam-moi-csdl"}},
              "spec":{"restartPolicy":"Never","imagePullSecrets":[{"name":"dockerhub-omicrm"}],
              "containers":[{"name":"psql","image":"postgres:16-alpine",
                "envFrom":[{"secretRef":{"name":"'"$s"'-secrets"}}],
                "env":[{"name":"CHE_DO","value":"'"$CHE_DO"'"},{"name":"WIPE_B64","value":"'"$WIPE_B64"'"}],
                "command":["sh","-c","echo \\"$WIPE_B64\\" | base64 -d > /tmp/w.sh && sh /tmp/w.sh"]}]}}' \\
              > "$TMP_DIR/pod.json"
            if ! kubectl -n "$NS" create -f "$TMP_DIR/pod.json" >/dev/null; then
              printf '   %-10s ✗ không tạo được pod\\n' "$s"; failed="$failed $s"; continue
            fi
            ph=""; i=0
            while [ $i -lt 60 ]; do   # 5 minutes — dropping ~3 400 relations is not instant
              ph=$(kubectl -n "$NS" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)
              case "$ph" in Succeeded|Failed) break ;; esac
              sleep 5; i=$((i+1))
            done
            kubectl -n "$NS" logs "$pod" > "$TMP_DIR/$s.log" 2>/dev/null || true
            kubectl -n "$NS" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true
            info=$(grep '^INFO|' "$TMP_DIR/$s.log" | head -n 1)
            res=$(grep '^DONE|\\|^ERR|' "$TMP_DIR/$s.log" | tail -n 1)
            db=$(echo "$info" | cut -d'|' -f2); tables=$(echo "$info" | cut -d'|' -f3); ledger=$(echo "$info" | cut -d'|' -f4)
            case "$res" in
              DONE\\|*) ket="✓ đã xoá sạch (còn ${res#DONE|} quan hệ)"; ok="$ok $s" ;;
              ERR\\|*) ket="✗ ${res#ERR|}"; failed="$failed $s" ;;
              *) if [ "$CHE_DO" = "thu" ] && [ -n "$info" ]; then ket="(chạy thử — chưa xoá)"; ok="$ok $s"
                 else ket="✗ pod dừng ở pha '${ph:-không rõ}', không có kết quả"; failed="$failed $s"; fi ;;
            esac
            printf '   %-10s %-22s %7s %8s  %s\\n' "$s" "${db:--}" "${tables:--}" "${ledger:--}" "$ket"
          done

          echo ""
          [ -z "$failed" ] || echo "── HỎNG:$failed — dịch vụ ấy CHƯA bị xoá (mỗi CSDL một giao dịch). Đọc nhãn lỗi ở trên rồi chạy lại."
          if [ "$CHE_DO" = "that" ] && [ -n "$ok" ]; then
            echo "Bước kế:"
            echo "  1. tao-bang cùng MT (TAO_CSDL không cần) — dựng lại bảng bằng ảnh đang chạy; ảnh phải có migration của ADR 0096."
            echo "  2. kiem-tra cùng MT — 7 CSDL phải báo 'chưa áp 0', số bảng nhỏ hơn trước khoảng 3 000 là ĐÚNG (bớt mảnh)."
            echo "  3. Dựng lại dữ liệu vận hành đã mất: tài khoản vận hành (tao-tai-khoan-van-hanh, chi-dinh-owner), xã + tên miền +"
            echo "     App ID (platform-admin), secret Mini App (dat-secret-mini-app). Khoá trong <dịch vụ>-secrets KHÔNG bị đụng."
          fi
          [ -z "$failed" ]
        '''
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // CHƯA TỪNG GHI ĐƯỢC — đo lượt #20 (26/09/2026): sổ xã của vigov_platform trống, không một
    // dòng vết `tao_xa`. Lượt trước "chạy" bằng `kubectl run -i`, cách đã treo ở #17/#18, nên
    // không ghi gì. Nay chạy qua `chay_psql`. Câu SQL giữ nguyên, KHÔNG sửa: nó gắn admin.vigov.vn
    // tạm thời, và việc `doi-ten-mien-thang-binh` chạy NGAY SAU gỡ đi và đặt tên miền của xã
    // (mô hình chốt cùng ngày: admin.vigov.vn là cổng liên xã của nhà cung cấp, không phải một
    // xã). Hai dòng vết `tao_xa` + `doi_ten_mien` kể lại đủ. Chạy lại khi xã đã có thì DỪNG ở phép
    // kiểm đầu; trên CSDL đã có platform 0007 thì INSERT admin.* bị CHECK
    // `tenant_domain_khong_danh_rieng` từ chối — cả hai đều là hỏng-đóng, đúng.
    //
    // VIỆC MỘT LẦN — onboard Xã Thăng Bình (Thành phố Đà Nẵng) vào sổ xã của `platform`, gắn
    // admin.vigov.vn (chính) và admin-stg.vigov.vn. Chủ dự án chọn 26/09/2026.
    //
    // Vì sao cần: admin.vigov.vn trả 404 `tenant_not_found` — sổ xã không có dòng nào. Kho
    // không gieo xã nào (một xã thật là dữ liệu vận hành, không phải migration).
    //
    // tenant_id là ULID sinh MỘT lần lúc viết stage này (core/ulid.Moi) và cố định ở đây, để
    // chạy lại không tạo xã thứ hai (luật 1 bất biến 2: id vô nghĩa, bất biến). Tên + tỉnh viết
    // theo ADR 0017 ("Thành phố Đà Nẵng", đúng một cách viết mỗi tỉnh — ADR 0023).
    //
    // CHỈ THÊM, MỘT GIAO DỊCH, CÓ VẾT: dừng không ghi gì nếu id / tên miền / một xã trùng tên đã
    // có; ghi `audit_log` của platform cùng giao dịch (luật 6), chủ thể là người bấm job.
    //
    // CHẠY Ở ĐÂU: pod `platform` là distroless (không shell, không psql), nên job dựng một pod
    // `postgres:16-alpine` sống một lượt, đọc DATABASE_DSN từ `platform-secrets` (envFrom — DSN
    // không đi qua log hay tham số). `chay_psql` xoá pod khi xong.
    //
    // Staging và prod đang DÙNG CHUNG CSDL (Secret chép nguyên 25/09/2026), nên một lượt ghi
    // cho cả hai môi trường.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Tạo xã Thăng Bình') {
      when { expression { params.HANH_DONG == 'tao-xa-thang-binh' } }
      steps {
        script {
          if (params.MT != 'prod') { error('tao-xa-thang-binh chỉ chạy với MT=prod.') }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
          // Tên người bấm đi THẲNG vào câu SQL của dòng vết bên dưới — chỉ nhận ký tự an toàn.
          if (!(env.NGUOI_BAM ==~ /^[A-Za-z0-9._-]{1,64}$/)) {
            error("Tên người bấm '${env.NGUOI_BAM}' có ký tự không an toàn cho câu SQL — dừng.")
          }
        }
        writeFile file: 'tao-xa.sql', encoding: 'UTF-8', text: """\\set ON_ERROR_STOP on
BEGIN;
DO \$\$
BEGIN
  IF EXISTS (SELECT 1 FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8') THEN
    RAISE EXCEPTION 'DUNG: xa 01M3CS7HHK72V71CGRRJHGR8E8 da co — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant_domain WHERE host IN ('admin.vigov.vn', 'admin-stg.vigov.vn')) THEN
    RAISE EXCEPTION 'DUNG: ten mien admin.vigov.vn / admin-stg.vigov.vn da gan cho mot xa — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant WHERE lower(ten) LIKE '%thăng bình%') THEN
    RAISE EXCEPTION 'DUNG: da co mot xa ten Thang Binh — khong tao xa thu hai';
  END IF;
END \$\$;
INSERT INTO tenant (id, ten, tinh_thanh, dang_hoat_dong)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'Xã Thăng Bình', 'Thành phố Đà Nẵng', true);
INSERT INTO tenant_domain (host, tenant_id, la_chinh) VALUES
  ('admin.vigov.vn',     '01M3CS7HHK72V71CGRRJHGR8E8', true),
  ('admin-stg.vigov.vn', '01M3CS7HHK72V71CGRRJHGR8E8', false);
INSERT INTO audit_log (tenant_id, actor_id, actor_kind, action, subject, at, delta)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'van-hanh:${env.NGUOI_BAM}', 'system', 'tao_xa',
          'Xã Thăng Bình', now(),
          jsonb_build_object('ten', 'Xã Thăng Bình', 'tinh_thanh', 'Thành phố Đà Nẵng',
                             'ten_mien', jsonb_build_array('admin.vigov.vn', 'admin-stg.vigov.vn'),
                             'qua', 'jenkins vigov-deploy #${env.BUILD_NUMBER}'));
COMMIT;
SELECT t.id, t.ten, t.tinh_thanh, t.dang_hoat_dong, d.host, d.la_chinh
  FROM tenant t JOIN tenant_domain d ON d.tenant_id = t.id
 WHERE t.id = '01M3CS7HHK72V71CGRRJHGR8E8';
"""
        sh(CHAY_PSQL + '''
          echo "── các xã đang có trong sổ (trước khi ghi)"
          echo "SELECT id, ten, tinh_thanh, dang_hoat_dong FROM tenant ORDER BY tao_luc; SELECT host, tenant_id, la_chinh FROM tenant_domain ORDER BY host;" > doc-xa.sql
          chay_psql "vigov-psql-doc-$BUILD_NUMBER" doc-xa.sql
