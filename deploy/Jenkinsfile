  IF EXISTS (SELECT 1 FROM mini_app WHERE app_id = '3043188591857102858') THEN
    RAISE EXCEPTION 'DUNG: App ID moi 3043188591857102858 da co dong trong mini_app (xem bang doc o tren) — khong ghi gi';
  END IF;
