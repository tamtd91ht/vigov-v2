{
  "name": "@vigov/citizen-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/dung.mjs day-du",
    "build:goc": "node scripts/dung.mjs goc",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zmp:login": "npx --yes zmp-cli@4.0.3 login",
    "zmp:sync": "npm run build && npx --yes zmp-cli@4.0.3 sync-config dist/index.html",
    "zmp:deploy": "node scripts/deploy.mjs --bien-the=day-du",
    "zmp:deploy:goc": "node scripts/deploy.mjs --bien-the=goc",
    "zmp:phat-hanh:goc": "node scripts/deploy.mjs --bien-the=goc --phat-hanh",
    "check:api": "node -e \"console.log('citizen-app: no generated REST types in phase 1 — the introduction app calls no backend. Phase 2 replaces this script.')\""
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zmp-sdk": "^2.53.0"
  },
  "devDependencies": {
    "vite": "^8.2.2",
    "typescript": "^5.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "vitest": "^5.0.1"
  }
}
