// Job TRIỂN KHAI. Tệp này là nơi DUY NHẤT chạm vào cụm k8s.
//
// ─────────────────────────────────────────────────────────────────────────────────────────
// MÔ HÌNH — CHỐT 22/09/2026, theo mẫu ĐANG CHẠY THẬT trên cùng máy chủ Jenkins này
//
// Tám job đóng ảnh dừng ở Harbor. Job này đưa một ảnh lên cụm, chỉ khi có người bấm, với ba
// tham số người ấy tự điền.
//
// Cơ chế đặt ảnh là `kubectl set image` + `rollout status` — giống hệt nhánh `stg` của mẫu
// `cloud-vihat-saas-omicrm-wrapper-auto-call-service`. Nó thay cho thiết kế cũ ở đây
// (`kustomize edit set image` → commit → push → `apply -k`), vì thiết kế ấy chưa từng chạy
// một lượt nào, còn cái này thì đang chạy hằng ngày.
//
// CÁI GIÁ ĐÃ BIẾT, ghi ra chứ không giấu: nhật ký triển khai không còn nằm trong `git log`
// của `overlays/<mt>/kustomization.yaml`. Nó nằm ở LỊCH SỬ BUILD của job này — và lịch sử ấy
// bị `buildDiscarder` cắt sau 200 lượt. Đổi lại, cụm không còn phụ thuộc vào một lượt `push`
// có thể bị từ chối giữa chừng.
//
// HỆ QUẢ PHẢI NHỚ: `overlays/<mt>/kustomization.yaml` KHÔNG còn ghi thẻ đang chạy. Chạy
// `kubectl apply -k` lên một namespace đã có dịch vụ sẽ ĐẨY MỌI DỊCH VỤ VỀ
// `CHUA-TRIEN-KHAI-LAN-NAO` — cách phục hồi ở `deploy/README.md`, mục *Sửa manifest*.
// ─────────────────────────────────────────────────────────────────────────────────────────
//
// MÁY CHỦ BUILD CẦN: kubectl, skopeo. `kustomize` KHÔNG còn cần cho job này (chỉ còn dùng ở
// lần cài đầu, do người chạy tay). Dòng này là chú thích và một chú thích không kiểm gì cả —
// stage 'Kiểm công cụ' bên dưới mới là thứ kiểm.

pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 20, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '200'))   // giữ lâu hơn job build: đây là hồ sơ
    disableConcurrentBuilds()
  }

  parameters {
    // `platform` đứng đầu vì nó phải lên trước: sáu dịch vụ còn lại quay số tới cổng 9090 của
    // nó để phân giải Host → xã. `reporting` KHÔNG có trong danh sách vì nó chưa có manifest
    // (0 tuyến REST). Một lựa chọn trỏ tới Deployment không tồn tại chỉ đỏ ở `set image`.
    choice(name: 'DICH_VU',
           choices: ['platform', 'identity', 'web-admin',
                     'comms', 'documents', 'finance', 'petitions'],
           description: 'Đúng MỘT dịch vụ. Muốn đưa hai cái lên thì chạy hai lượt — ' +
                        'để mỗi lượt là một dòng riêng trong lịch sử build.')
    string(name: 'THE', defaultValue: '',
           description: 'Thẻ ảnh = commit 12 ký tự đã sinh ra nó. Lấy từ log job đóng ảnh.')
    choice(name: 'MT', choices: ['staging', 'prod'],
           description: 'staging đứng TRƯỚC prod trong danh sách, có chủ ý.')
  }

  environment {
    REGISTRY = 'harbor.omicrm.services'
    PROJECT  = 'ci'

    // KUBECONFIG LÀ MỘT TỆP TRÊN ĐĨA MÁY CHỦ, không phải một mục credentials của Jenkins —
    // giống mẫu omicrm, và vì lý do thực tế: máy chủ này chỉ có bộ plugin lõi, nên mọi đường
    // đi qua plugin đều là một thứ phải xin cài trên một máy dùng chung.
    //
    // ĐƯỜNG DẪN NÀY DO CHỦ DỰ ÁN CHỈ, ngày 23/09/2026. Nó KHÔNG phải kubeconfig của omicrm
    // (`rancher-omi.yaml`) — ViGov có tệp riêng, `rancher-vigov.yaml`, cạnh nó. Hai tệp cùng
    // thư mục và tên chỉ khác bốn ký tự, nên đây là chỗ một lần chép nhầm sẽ đưa lượt deploy
    // của ViGov vào CỤM CỦA DỰ ÁN KHÁC — và `kubectl set image` trên một Deployment không tồn
    // tại thì đỏ, nhưng trên một Deployment TRÙNG TÊN thì không.
    //
    // Stage 'Kiểm công cụ' đọc thử tệp và in `kubectl config current-context` ra log trước khi
    // chạm bất cứ gì: thiếu tệp thì dừng ngay, và sai cụm thì có một dòng đọc được để nhận ra.
    KUBECONFIG = '/u01/rancher/rancher-vigov.yaml'

    // Tên ẢNH mang tiền tố `vigov-service-` cho dịch vụ Go, `vigov-` cho web.
    // Tên TÀI NGUYÊN k8s là tên NGHIỆP VỤ trần (`platform`, `identity`) — ADR 0016 §2.
    NS = "vigov-${params.MT}"
  }

  stages {

    stage('Kiểm công cụ') {
      steps {
        sh '''
          set -eu
          thieu=""
          for cc in kubectl skopeo; do
            command -v "$cc" >/dev/null 2>&1 || thieu="$thieu $cc"
          done
          if [ -n "$thieu" ]; then
            echo ""
            echo "MÁY CHỦ BUILD THIẾU:$thieu"
            echo "Dừng ở đây thay vì đổ giữa một lượt triển khai đã sửa cụm được một nửa."
            echo ""
            exit 1
          fi

          # Kiểm kubeconfig RA MẶT. Thiếu nó thì `kubectl` vẫn chạy, chỉ là nó rơi về
          # `~/.kube/config` hoặc về service account — tức có thể trỏ vào MỘT CỤM KHÁC mà
          # không câu nào nói ra.
          if [ ! -r "$KUBECONFIG" ]; then
            echo ""
            echo "KHÔNG ĐỌC ĐƯỢC KUBECONFIG: $KUBECONFIG"
            echo "Sửa hằng số KUBECONFIG ở đầu deploy/Jenkinsfile cho đúng máy chủ này."
            echo ""
            exit 1
          fi
          kubectl version --client
          kubectl config current-context
        '''
      }
    }

    stage('Kiểm tham số') {
      steps {
        script {
          // Cờ cho khối `post { failure }`. Phải đặt Ở STAGE ĐẦU TIÊN có script, vì khối ấy
          // chạy cho MỌI stage đỏ — kể cả stage này.
          env.DA_DAT = 'chua'

          if (!(params.THE ==~ /^[0-9a-f]{12}$/)) {
            error("THE phải là 12 ký tự hex — commit đã sinh ra ảnh. Nhận được: '${params.THE}'\n" +
                  "Thẻ di động (latest, main, prod) bị cấm: hai pod cùng manifest có thể chạy " +
                  "hai đoạn mã khác nhau, và câu 'bản nào đang chạy lúc đó' mất lời giải.")
          }

          // AI BẤM — kiểm Ở ĐÂY, trước khi chạm cụm, vì đây là chỗ duy nhất còn quay lại được
          // mà không tốn gì. Chi tiết cơ chế ở cuối tệp, hàm `nguoiBam()`.
          //
          // Từ 22/09/2026 tên người bấm không còn đi vào một commit git nữa — nó đi vào
          // `currentBuild.description`. Vai trò thì không đổi: đó là chỗ DUY NHẤT trả lời
          // "ai đưa bản này lên", nên không xác định được thì DỪNG.
          env.NGUOI_BAM = nguoiBam()
          if (!env.NGUOI_BAM) {
            error('KHÔNG XÁC ĐỊNH ĐƯỢC AI BẤM LƯỢT NÀY — dừng trước khi chạm cụm.\n' +
                  '\n' +
                  'Lịch sử build của job này LÀ nhật ký triển khai. Một dòng không có tên\n' +
                  'người là một dòng trả lời được "bản nào" và "lúc nào" nhưng không trả lời\n' +
                  'được "AI" — và với hệ thống lưu hồ sơ hành chính, đó đúng là câu một cuộc\n' +
                  'thanh tra sẽ hỏi. Ghi một cái tên giả (`khong-ro`) còn tệ hơn để trống: nó\n' +
                  'làm dòng nhật ký TRÔNG NHƯ đã có câu trả lời.\n' +
                  '\n' +
                  'Job này KHÔNG khai trigger tự động, nên mọi lượt chạy hợp lệ đều do một\n' +
                  'người đã đăng nhập bấm. Thấy dòng này nghĩa là lượt chạy không mang\n' +
                  'hudson.model.Cause$UserIdCause — kiểm xem nó có bị một job khác, một timer,\n' +
                  'hay một script gọi hộ không.')
          }

          env.ANH = (params.DICH_VU == 'web-admin')
                  ? "${env.REGISTRY}/${env.PROJECT}/vigov-web-admin"
                  : "${env.REGISTRY}/${env.PROJECT}/vigov-service-${params.DICH_VU}"

          // Tên THÙNG bên trong Deployment — `kubectl set image` đòi `<thùng>=<ảnh>`, không
          // phải tên Deployment. Sáu dịch vụ Go dùng `server`, web-admin dùng `web`
          // (`deploy/base/*/deployment.yaml`). Đặt sai tên thùng thì `set image` trả về
          // "unable to find container named ..." và KHÔNG đổi gì — đỏ, nhưng vô hại.
          env.THUNG = (params.DICH_VU == 'web-admin') ? 'web' : 'server'

          currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.DICH_VU} ${params.THE} → ${params.MT}"
          echo "sẽ đưa ${env.ANH}:${params.THE} lên ${env.NS} — người bấm: ${env.NGUOI_BAM}"
        }
      }
    }

    stage('Ảnh có thật trong registry chưa') {
      steps {
        // KIỂM TRƯỚC KHI CHẠM CỤM. Đặt một thẻ không tồn tại nghĩa là Deployment ngồi
        // ImagePullBackOff và `rollout status` treo tới hết timeout — đỏ rất xa nguyên nhân.
        // `--authfile` chứ không `--creds`: kho này không mang credentials registry, nó dùng
        // phiên đăng nhập sẵn của user `jenkins` như tám job đóng ảnh. Chỉ đường dẫn ra tường
        // minh chứ không dựa vào thứ tự tìm mặc định của skopeo: nó ưu tiên
        // `$XDG_RUNTIME_DIR/containers/auth.json` TRƯỚC `~/.docker/config.json`, nên trên một
        // máy có cả hai, "docker đăng nhập rồi" và "skopeo đọc được" là hai chuyện khác nhau.
        sh '''
          set -eu
          skopeo inspect --authfile "${DOCKER_CONFIG:-$HOME/.docker}/config.json" \
                 "docker://${ANH}:${THE}" >/dev/null \
            || { echo ""; echo "KHÔNG TÌM THẤY ${ANH}:${THE} trong registry."; \
                 echo "Job đóng ảnh của dịch vụ này đã chạy xong cho commit đó chưa?"; \
                 echo "(Nếu lỗi là unauthorized: máy chủ chưa đăng nhập ${REGISTRY}.)"; \
                 echo ""; exit 1; }
        '''
      }
    }

    stage('Đặt ảnh') {
      steps {
        // Ghi lại thẻ ĐANG chạy trước khi đổi. `rollout undo` ở khối `failure` lo phần quay
        // lại; dòng này lo phần CON NGƯỜI đọc: sau một lượt đỏ, câu đầu tiên phải trả lời là
        // "trước đó nó đang chạy bản nào", và lịch sử build của lượt TRƯỚC có thể đã bị cắt.
        sh '''
          set -eu
          echo "trước lượt này: $(kubectl -n ${NS} get deploy/${DICH_VU} \
              -o jsonpath='{.spec.template.spec.containers[*].image}')"
        '''

        // TỪ DÒNG NÀY TRỞ ĐI CỤM ĐÃ ĐỔI, nên từ đây `post { failure }` mới được phép rút lại.
        script { env.DA_DAT = 'roi' }

        sh '''
          set -eu
          kubectl -n ${NS} set image deploy/${DICH_VU} ${THUNG}=${ANH}:${THE}
        '''
      }
    }

    stage('Đợi rollout') {
      steps {
        // 6 phút: startupProbe cho phép tới 5 phút vì di trú CSDL chạy TRONG tiến trình lúc
        // khởi động và ôm advisory lock (core/migrate.Chay) — replica thứ hai đợi replica
        // thứ nhất. Timeout chặt hơn sẽ "thất bại" trong lúc mọi thứ vẫn đúng.
        sh '''
          set -eu
          kubectl -n ${NS} rollout status deploy/${DICH_VU} --timeout=6m
        '''
      }
    }
  }

  post {
    failure {
      // `post { failure }` CHẠY CHO MỌI STAGE ĐỎ, kể cả các stage kiểm chạy TRƯỚC khi cụm bị
      // đụng tới. Không có cờ `DA_DAT` thì một lỗi gõ ở ô `THE` — đỏ ở 'Kiểm tham số', trước
      // cả khi job biết mình sẽ làm gì — vẫn chạy `rollout undo`, tức RÚT LẠI BẢN ĐANG CHẠY
      // ĐÚNG của một dịch vụ mà lượt này chưa hề đụng tới. `set +e` không che được: nó chỉ
      // giữ cho job khỏi đỏ thêm, lệnh vẫn thi hành.
      script {
        if (env.DA_DAT != 'roi') {
          echo 'Đỏ TRƯỚC khi chạm cụm — không có gì để rút lại, cụm không bị đụng tới.'
        } else {
          sh '''
            set +e
            echo "THẤT BẠI — quay lại bản trước ở cụm"
            kubectl -n ${NS} rollout undo deploy/${DICH_VU}
            kubectl -n ${NS} rollout status deploy/${DICH_VU} --timeout=5m
          '''
          // Ghi thẳng, KHÔNG bọc thêm một `script { }` nữa: ở đây đã là mã Groovy rồi, và
          // `script` là một step của khối `steps` — lồng nó vào chính nó thì pipeline hỏng
          // ngay ở bước phân tích cú pháp, tức đỏ trước cả khi job chạy được dòng nào.
          currentBuild.description =
            "ĐỎ · ${env.ANH}:${params.THE} → ${env.NS} · đã rollout undo · bấm bởi ${env.NGUOI_BAM}"
        }
      }
    }
    success {
      script {
        // ĐÂY LÀ NHẬT KÝ TRIỂN KHAI. Một dòng cho mỗi lượt, đọc được ngay ở trang lịch sử
        // build — không có sổ nào khác kể từ khi commit ghim thẻ bị gỡ.
        currentBuild.description =
          "${env.ANH}:${params.THE} → ${env.NS} · bấm bởi ${env.NGUOI_BAM}"
        echo "XONG  ${env.ANH}:${params.THE} đang chạy ở ${env.NS} — bấm bởi ${env.NGUOI_BAM}"
      }
    }
  }
}

// ─────────────────────────────────────────────────────────────────────────────────────────
// AI BẤM LƯỢT NÀY — đọc từ NGUYÊN NHÂN của lượt build, không qua plugin nào.
//
// `BUILD_USER_ID` là biến của plugin `build-user-vars`, và máy chủ Jenkins này chỉ có bộ lõi
// (`Jenkinsfile` gốc, mục "VÌ SAO KHÔNG GỌI PLUGIN DOCKER PIPELINE"). Biến ấy vì thế LUÔN
// rỗng ở đây, nên dòng cũ `${BUILD_USER_ID:-khong-ro}` ghi `khong-ro` vào MỌI lượt triển
// khai — và nó hỏng theo kiểu tệ nhất: không đỏ, không cảnh báo, chỉ là một nhật ký trông
// như đã trả lời câu "ai" trong khi chưa bao giờ trả lời.
//
// `currentBuild.getBuildCauses()` thuộc Pipeline lõi (`workflow-support`), không cần cài gì
// thêm — đó là lý do chọn nó thay vì đi xin cài plugin trên một máy chủ dùng chung.
//
// TRẢ VỀ CHUỖI RỖNG KHI KHÔNG BIẾT, KHÔNG BAO GIỜ TRẢ VỀ MỘT TÊN THAY THẾ. Nơi gọi mới là
// nơi quyết định làm gì với cái không biết ấy, và ở đây nó quyết định DỪNG. Một hàm tự bịa
// `khong-ro` là đúng cái khiếm khuyết đang được vá, viết lại ở chỗ khác.
String nguoiBam() {
  List nn
  try {
    nn = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')
  } catch (Throwable e) {
    // BẮT RỘNG, CÓ CHỦ Ý — và nó an toàn ĐÚNG VÌ nhánh này trả về rỗng. Bắt rộng chỉ nguy
    // hiểm khi nó nuốt lỗi rồi đi tiếp theo hướng dễ dãi; ở đây mọi thất bại đều dẫn tới
    // cùng một kết luận "không biết ai bấm", và nơi gọi DỪNG. Bản Pipeline cũ ném
    // `MissingMethodException` (một Exception) còn `NoSuchMethodError` là một Error —
    // `catch (Exception)` sẽ hụt nửa sau, và `catch (A | B)` thì đa-bắt từng vỡ dưới phép
    // biến đổi CPS của Jenkins.
    echo "Không đọc được nguyên nhân lượt build (${e.getClass().getSimpleName()}) — coi như không xác định được người bấm."
    return ''
  }
  if (nn == null || nn.isEmpty()) {
    return ''
  }
  def id = nn[0].userId
  return id == null ? '' : id.toString().trim()
}
