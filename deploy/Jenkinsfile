// Job HẠ TẦNG `vigov-deploy` — bấm tay. Làm qua Jenkins những việc trước đây phải SSH vào máy
// chủ mới làm được: kiểm cụm, xem log, và (một lần) nhân bản staging sang prod.
//
// ─────────────────────────────────────────────────────────────────────────────────────────
// MÔ HÌNH ĐANG CHẠY THẬT — đo 25/09/2026 bằng `kiem-tra` trên vigov-staging, chủ dự án chọn
// "prod = nhân bản staging" cùng ngày:
//
//   Staging được dựng TAY trong Rancher, KHÔNG từ `deploy/base`. Tên thật trên cụm:
//     Deployment/Service  vigov-service-<dịch vụ> · vigov-web-admin
//     Secret              <dịch vụ>-secrets  (key DATABASE_DSN · GRPC_CALLER_KEY ·
//                         SESSION_SIGNING_KEYS · REDIS_DSN — trừ platform: không REDIS_DSN)
//     ConfigMap           common-config (key ENV)
//     Ingress             một cái mỗi dịch vụ, HTTP cổng 80, host thật (admin.vigov.vn …)
//
//   `deploy/base` + `overlays/` KHÔNG mô tả cụm này (tên `platform`, `<service>-secrets`, Ingress
//   `*.vigov.vn` bắt TLS). Việc `ap-manifest` đã GỠ: áp nó lên prod sẽ tạo bộ Deployment thứ
//   hai chạy song song, và giành `*.vigov.vn` với Ingress của staging.
//
// Đặt ẢNH là việc của job dịch vụ (`service-*/Jenkinsfile`). Job này không tạo Secret từ giá
// trị nào nhập vào — chỉ chép theo TÊN, dữ liệu đi qua ống, không in ra log.
// ─────────────────────────────────────────────────────────────────────────────────────────
//
// MÁY CHỦ BUILD CẦN: kubectl. Stage đầu kiểm.

// Hàm shell `chay_psql <tên pod> <tệp .sql>` dùng chung cho các việc một lần ghi vào CSDL của
// `platform`. Dán vào ĐẦU khối sh của stage: sh(CHAY_PSQL + '''...''').
def CHAY_PSQL = '''
          set -eu
          MAU='{"apiVersion":"v1","spec":{"restartPolicy":"Never",
                "imagePullSecrets":[{"name":"dockerhub-omicrm"}],
                "containers":[{"name":"psql","image":"postgres:16-alpine",
                  "envFrom":[{"secretRef":{"name":"platform-secrets"}}],
                  "env":[{"name":"SQL_B64","value":"@SQL@"}],
                  "command":["sh","-c","echo \\"$SQL_B64\\" | base64 -d | psql \\"$DATABASE_DSN\\" -X -q -v ON_ERROR_STOP=1 -f -"]}]}}'
          # Lượt #17 và #18 (26/09/2026) chết ở "timed out waiting for the condition" dù pod đã
          # Started ngay giây đầu (image có sẵn trên máy): `kubectl run -i` KHÔNG GẮN ĐƯỢC vào pod,
          # psql ngồi đợi stdin tới khi bị giết. Nên bỏ stdin/attach: câu SQL vào pod qua biến môi
          # trường (base64 — chỉ [A-Za-z0-9+/=], nhúng vào JSON an toàn; SQL này không chứa bí mật),
          # pod tự chạy tới xong, job hỏi pha bằng `get` rồi đọc `logs`. Chỉ cần quyền
          # create/get/delete pod + đọc log — không cần attach, không cần watch.
          chay_psql() {
            ten="$1"
            tep="$2"
            OVR=$(printf '%s' "$MAU" | sed "s|@SQL@|$(base64 -w0 "$tep")|")
            kubectl -n vigov-prod run "$ten" --restart=Never \
                --image=postgres:16-alpine --overrides="$OVR" --quiet
            pha=""; i=0
            while [ $i -lt 60 ]; do   # 60 × 5 giây = 5 phút
              pha=$(kubectl -n vigov-prod get pod "$ten" -o jsonpath='{.status.phase}' 2>/dev/null || true)
              case "$pha" in Succeeded|Failed) break ;; esac
              sleep 5; i=$((i+1))
            done
            kubectl -n vigov-prod logs "$ten" 2>&1 || true
            if [ "$pha" != "Succeeded" ]; then
              echo "── pod $ten kết thúc ở pha '$pha' — sự kiện của pod:"
              kubectl -n vigov-prod describe pod "$ten" 2>/dev/null | sed -n '/^Events:/,$p' || true
            fi
            kubectl -n vigov-prod delete pod "$ten" --ignore-not-found --wait=false || true
            [ "$pha" = "Succeeded" ]
          }
'''

pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 20, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '200'))   // giữ lâu hơn job build: đây là hồ sơ
    disableConcurrentBuilds()
  }

  parameters {
    // `nhan-ban-staging` (một lần) đã chạy 25/09/2026 và đã gỡ — xem lịch sử git của tệp này.
    // `tao-xa-thang-binh` là việc MỘT LẦN (chủ dự án, 26/09/2026): CHƯA GHI ĐƯỢC tới lượt #20 —
    // chạy nó TRƯỚC `doi-ten-mien-thang-binh`.
    // `doi-ten-mien-thang-binh` là việc MỘT LẦN (chủ dự án, 26/09/2026). Hai việc gỡ bằng một commit
    // khi chủ dự án xác nhận xong.
    // `gan-mini-app-thang-binh` là việc MỘT LẦN (chủ dự án, 27/09/2026) — ĐÃ CHẠY (chủ dự án xác nhận
    // 01/10/2026); chạy lại sẽ DỪNG ở phép kiểm vì App ID cũ đã có dòng.
    // `doi-app-id-thang-binh` là việc MỘT LẦN (chủ dự án, 01/10/2026): Xã Thăng Bình chuyển sang App ID
    // 3043188591857102858, dòng App ID cũ bị TẮT (không xoá). Gỡ cả hai khi platform-admin có màn
    // ghi sổ mini_app.
    // Năm việc đăng nhập app riêng (ADR 0066) — thứ tự ở khối chú thích trước stage
    // 'Tạo khoá mã hoá identity'. Gỡ cùng commit đưa platform-admin có màn tương ứng.
    // `bat-demo-mini-app` / `tat-demo-mini-app` removed 05/10/2026 (ADR 0066 §Sửa đổi 05/10/2026):
    // demo identity is retired. "Rebuild" of an old run naming them is refused by the guard in
    // 'Kiểm công cụ' — that is the guard's purpose.
    choice(name: 'HANH_DONG', choices: ['kiem-tra', 'xem-log', 'doi-ten-mien-thang-binh', 'tao-xa-thang-binh',
                                  'gan-mini-app-thang-binh', 'doi-app-id-thang-binh',
                                  'tao-khoa-ma-hoa-identity', 'mo-netpol-identity-zalo', 'bo-sung-cau-hinh-identity',
                                  'kiem-tra-dang-nhap-app-rieng',
                                  'dat-secret-mini-app',
                                  'dung-clamav', 'tao-tai-khoan-van-hanh'],
           description:'kiem-tra: chỉ đọc · xem-log: log + sự kiện của DICH_VU · ' +
                        'tao-khoa-ma-hoa-identity: (app riêng, bước 1) sinh SECRET_ENCRYPTION_KEYS vào identity-secrets ' +
                        'của vigov-prod VÀ cùng giá trị vào vigov-staging (chung CSDL); đã có thì DỪNG, không đổi gì ' +
                        '(MT=prod; chạy TRƯỚC job service-identity) · ' +
                        'mo-netpol-identity-zalo: (bước 2) mở đường ra 443 cho pod identity nếu namespace MT có NetworkPolicy ' +
                        '(không có cái nào = không cần, không đổi gì) · ' +
                        'bo-sung-cau-hinh-identity: (bước 3, TRƯỚC job service-identity) thêm PETITIONS_GRPC_ADDR / ' +
                        'DOCUMENTS_GRPC_ADDR / CITIZEN_SESSION_BRIDGE_LISTEN_ADDR vào env của deploy identity nếu chưa có ' +
                        '(có rồi thì giữ nguyên), CITIZEN_SESSION_BRIDGE_KEYS vào identity-secrets (cùng giá trị prod + ' +
                        'staging; đã có thì giữ), rồi khởi động lại identity của MT · ' +
                        'kiem-tra-dang-nhap-app-rieng: (bước 4, SAU job service-identity) chỉ đọc — key, ảnh, Ingress, ' +
                        'thử POST /api/v1/citizen-sessions · ' +
                        'dat-secret-mini-app: (bước 5) operatorctl mini-app-secret set cho TENANT_ID + APP_ID bằng APP_SECRET ' +
                        '(App Secret của app trên developers.zalo.me) — app riêng đăng nhập công dân THẬT (có xác minh số); ' +
                        'MT=prod, XAC_NHAN=vigov-prod, TICKET bắt buộc; App ID phải đã gắn xã (doi-app-id-thang-binh) · ' +
                        'doi-ten-mien-thang-binh: đặt thangbinh-danang.vigov.vn làm tên miền chính của Xã Thăng Bình ' +
                        '+ thangbinh-danang.stg.vigov.vn (MT=prod; chạy SAU khi DNS/TLS/Ingress của hai host chạy, ' +
                        'TRƯỚC job service-platform có migration 0007) · ' +
                        'tao-xa-thang-binh: LỊCH SỬ — đã chạy 26/09/2026; chạy lại sẽ DỪNG ở phép kiểm, và sau ' +
                        'platform 0007 câu INSERT admin.* của nó bị CHECK từ chối · ' +
                        'gan-mini-app-thang-binh: LỊCH SỬ — đã ghi dòng mini_app App ID 3291993990104489440 → ' +
                        'Xã Thăng Bình; chạy lại sẽ DỪNG ở phép kiểm · ' +
                        'doi-app-id-thang-binh: ghi dòng mini_app App ID 3043188591857102858 → Xã Thăng Bình VÀ tắt ' +
                        'dòng App ID 3291993990104489440 (không xoá), một giao dịch, có vết (MT=prod) · ' +
                        'dung-clamav: áp deploy/cluster/clamav.yaml (clamd, ADR 0052 §9) vào namespace của MT, đợi sẵn sàng, ' +
                        'thử PING/PONG, rồi đặt MALWARE_SCANNER_ADDRESS=vigov-clamav:3310 vào common-config NẾU CHƯA CÓ ' +
                        '(có rồi thì giữ nguyên); không khởi động lại dịch vụ nào (chạy TRƯỚC job service-petitions) · ' +
                        'tao-tai-khoan-van-hanh: operatorctl create cho EMAIL_VAN_HANH + TEN_VAN_HANH rồi cấp đủ 7 quyền ops.* ' +
                        '(MT=prod, XAC_NHAN=vigov-prod, TICKET bắt buộc). ⚠ MẬT KHẨU TẠM IN VÀO LOG LƯỢT BUILD NÀY ' +
                        '(chủ dự án chấp nhận 02/10/2026): đăng nhập platform-admin, đổi mật khẩu + đăng ký TOTP NGAY; ' +
                        'mật khẩu tạm tự hết hạn sau 24 giờ')
    choice(name: 'MT', choices: ['prod', 'staging'], description: 'Môi trường')
    choice(name: 'DICH_VU',
           choices: ['vigov-service-platform', 'vigov-service-identity', 'vigov-service-comms',
                     'vigov-service-documents', 'vigov-service-finance', 'vigov-service-petitions',
                     'vigov-service-reporting', 'vigov-web-admin', 'vigov-platform-admin'],
           description: 'Chỉ dùng cho xem-log')
    string(name: 'XAC_NHAN', defaultValue: '',
           description: 'Cho doi-ten-mien-thang-binh / tao-xa-thang-binh / gan-mini-app-thang-binh / doi-app-id-thang-binh / ' +
                        'tao-khoa-ma-hoa-identity / dat-secret-mini-app: gõ đúng vigov-prod. ' +
                        'Cho mo-netpol-identity-zalo / bo-sung-cau-hinh-identity / dung-clamav: gõ đúng namespace của MT ' +
                        '(vigov-prod hoặc vigov-staging).')
    string(name: 'TENANT_ID', defaultValue: '01M3CS7HHK72V71CGRRJHGR8E8',
           description: 'Cho dat-secret-mini-app: id xã (ULID 26 ký tự). Mặc định: Xã Thăng Bình.')
    string(name: 'APP_ID', defaultValue: '3043188591857102858',
           description: 'Cho dat-secret-mini-app: App ID Zalo (chỉ chữ số) đã gắn cho xã ấy ' +
                        '(doi-app-id-thang-binh). Mặc định: app riêng của Xã Thăng Bình (App ID từ 01/10/2026).')
    string(name: 'TICKET', defaultValue: '',
           description: 'Cho dat-secret-mini-app / tao-tai-khoan-van-hanh: BẮT BUỘC — số phiếu yêu cầu, ' +
                        'ghi vào vết kiểm toán (ticket:<số>). Chỉ A-Z a-z 0-9 . _ -, tối đa 64 ký tự.')
    // A PLACEHOLDER, not a secret (rule 8): the stage refuses to run while the field still holds it,
    // so a press that forgot to paste the real value never seals a fake secret into prod.
    password(name: 'APP_SECRET', defaultValue: 'THAY-BANG-APP-SECRET-CUA-ZALO',
             description: 'Cho dat-secret-mini-app: App Secret của App ID trên developers.zalo.me (Cài đặt → App Secret). ' +
                          'Xoá giá trị mặc định rồi dán secret thật — để nguyên mặc định thì job DỪNG, không ghi gì. ' +
                          'Không in ra log; vào pod qua một Secret k8s tạm, xoá ngay khi xong.')
    string(name: 'EMAIL_VAN_HANH', defaultValue: '',
           description: 'Cho tao-tai-khoan-van-hanh: email đăng nhập platform-admin của người vận hành (ADR 0048 — ' +
                        'tên đăng nhập LÀ email). Là dữ liệu cá nhân: job không in nó ra log, nhưng Jenkins lưu tham số của lượt build.')
    string(name: 'TEN_VAN_HANH', defaultValue: '',
           description: 'Cho tao-tai-khoan-van-hanh: tên hiển thị (chữ cái, khoảng trắng, . \' -; tối đa 100 ký tự).')
  }

  environment {
    // Kubeconfig của ViGov — KHÔNG phải `rancher-omi.yaml` nằm cạnh nó (tên chỉ khác bốn ký tự;
    // chép nhầm là thao tác vào cụm của dự án khác).
    KUBECONFIG = '/u01/rancher/rancher-vigov.yaml'
  }

  stages {

    stage('Kiểm công cụ') {
      steps {
        script {
          // LƯỢT ĐẦU SAU KHI ĐỔI `parameters {}`: Jenkins chỉ HỌC danh sách tham số ở lượt ấy, nên
          // lượt ấy chạy với mọi `params.*` là null. Dừng trước mọi lệnh kubectl.
          if (params.HANH_DONG == null || params.MT == null) {
            error('Jenkins vừa học tham số mới của job — lượt này không có tham số nào.\n' +
                  'Bấm lại bằng "Build with Parameters". Cụm không bị đụng tới.')
          }
          // Một việc đã GỠ khỏi `choices` vẫn tới được đây qua "Rebuild" một lượt cũ (đo được
          // 25/09/2026: `sao-chep-tu-staging` chạy xanh mà không stage nào khớp). Xanh-mà-không-làm-
          // gì là dạng hỏng tệ nhất: người bấm tin là đã xong.
          //
          // THIS LIST MUST EQUAL `choices` OF HANH_DONG ABOVE, item for item. On 02/10/2026
          // `tao-tai-khoan-van-hanh` was added to `choices` but not here, so the job refused the one
          // action it had just offered ("không còn trong job này"). Add/remove an action in BOTH places.
          if (!(params.HANH_DONG in ['kiem-tra', 'xem-log', 'doi-ten-mien-thang-binh', 'tao-xa-thang-binh',
                                  'gan-mini-app-thang-binh', 'doi-app-id-thang-binh',
                                  'tao-khoa-ma-hoa-identity', 'mo-netpol-identity-zalo', 'bo-sung-cau-hinh-identity',
                                  'kiem-tra-dang-nhap-app-rieng',
                                  'dat-secret-mini-app',
                                  'dung-clamav', 'tao-tai-khoan-van-hanh'])) {
            error("HANH_DONG '${params.HANH_DONG}' không còn trong job này (đã gỡ). " +
                  'Bấm "Build with Parameters" và chọn lại trong danh sách — đừng "Rebuild" một lượt cũ.')
          }
          env.HANH_DONG = params.HANH_DONG
          env.MT = params.MT
          env.DICH_VU = params.DICH_VU
          env.NS = "vigov-${params.MT}"

          env.NGUOI_BAM = nguoiBam()
          if (!env.NGUOI_BAM) {
            error('KHÔNG XÁC ĐỊNH ĐƯỢC AI BẤM LƯỢT NÀY — dừng. Lịch sử build của job này là nhật ký ' +
                  'thay đổi hạ tầng; một dòng không có tên người không trả lời được câu thanh tra sẽ hỏi.')
          }
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.HANH_DONG} · ${env.NS} · ${env.NGUOI_BAM}"
        }
        sh '''
          set -eu
          command -v kubectl >/dev/null 2>&1 || { echo "MÁY CHỦ BUILD THIẾU: kubectl"; exit 1; }
          if [ ! -r "$KUBECONFIG" ]; then
            echo "KHÔNG ĐỌC ĐƯỢC KUBECONFIG: $KUBECONFIG"; exit 1
          fi
          kubectl version --client
          echo "cụm: $(kubectl config current-context) · namespace: $NS · việc: $HANH_DONG · bấm bởi: $NGUOI_BAM"
          echo "commit của kho: $(git rev-parse --short=12 HEAD)"
        '''
      }
    }

    stage('Kiểm tra') {
      steps {
        sh '''
          set -u
          echo "── namespace"
          kubectl get ns "$NS" || echo "   (không đọc được namespace $NS)"
          echo "── Deployment + ảnh đang chạy"
          kubectl -n "$NS" get deploy -o wide || true
          echo "── Pod"
          kubectl -n "$NS" get pod -o wide || true
          echo "── Service · Ingress · ConfigMap · NetworkPolicy"
          kubectl -n "$NS" get svc,ingress,configmap,networkpolicy || true
          echo "── Secret (CHỈ TÊN và LOẠI — không in giá trị)"
          kubectl -n "$NS" get secret -o custom-columns=TEN:.metadata.name,LOAI:.type \
            --no-headers 2>/dev/null | awk '{print "   " $1 "  " $2}' || true
          # TÊN KEY, không giá trị: go-template chỉ duyệt khoá của `.data`.
          echo "── Key của từng Secret (CHỈ TÊN KEY)"
          kubectl -n "$NS" get secret -o go-template='{{range .items}}   {{.metadata.name}}:{{range $k, $v := .data}} {{$k}}{{end}}{{"\\n"}}{{end}}' 2>/dev/null || true
          echo "── Key của từng ConfigMap (CHỈ TÊN KEY)"
          kubectl -n "$NS" get configmap -o go-template='{{range .items}}   {{.metadata.name}}:{{range $k, $v := .data}} {{$k}}{{end}}{{"\\n"}}{{end}}' 2>/dev/null || true
          echo "── Deployment đọc Secret/ConfigMap nào (envFrom) và biến env đặt thẳng"
          kubectl -n "$NS" get deploy -o go-template='{{range .items}}   {{.metadata.name}}:{{range .spec.template.spec.containers}}{{range .envFrom}}{{if .secretRef}} secret/{{.secretRef.name}}{{end}}{{if .configMapRef}} configmap/{{.configMapRef.name}}{{end}}{{end}} | env:{{range .env}} {{.name}}{{end}}{{end}}{{"\\n"}}{{end}}' 2>/dev/null || true
          echo "── Sự kiện gần nhất"
          kubectl -n "$NS" get events --sort-by=.lastTimestamp 2>/dev/null | tail -25 || true
        '''
        script {
          // Secret + ConfigMap mà các Deployment dựng theo staging đọc (`envFrom`).
          env.THIEU = sh(returnStdout: true, script: '''
            set -u
            thieu=""
            for s in harbor-vigov platform-secrets identity-secrets comms-secrets documents-secrets \
                     finance-secrets petitions-secrets reporting-secrets; do
              kubectl -n "$NS" get secret "$s" >/dev/null 2>&1 || thieu="$thieu secret/$s"
            done
            kubectl -n "$NS" get configmap common-config >/dev/null 2>&1 || thieu="$thieu configmap/common-config"
            echo "$thieu"
          ''').trim()
          if (env.THIEU) {
            echo "⚠ THIẾU trong ${env.NS}: ${env.THIEU}"
          } else {
            echo "✓ đủ 8 Secret + common-config trong ${env.NS}"
          }
        }
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // CHƯA TỪNG GHI ĐƯỢC — đo lượt #20 (26/09/2026): sổ xã của vigov_platform trống, không một
    // dòng vết `tao_xa`. Lượt trước "chạy" bằng `kubectl run -i`, cách đã treo ở #17/#18, nên
    // không ghi gì. Nay chạy qua `chay_psql`. Câu SQL giữ nguyên, KHÔNG sửa: nó gắn admin.vigov.vn
    // tạm thời, và việc `doi-ten-mien-thang-binh` chạy NGAY SAU gỡ đi và đặt tên miền của xã
    // (mô hình chốt cùng ngày: admin.vigov.vn là cổng liên xã của nhà cung cấp, không phải một
    // xã). Hai dòng vết `tao_xa` + `doi_ten_mien` kể lại đủ. Chạy lại khi xã đã có thì DỪNG ở phép
    // kiểm đầu; trên CSDL đã có platform 0007 thì INSERT admin.* bị CHECK
    // `tenant_domain_khong_danh_rieng` từ chối — cả hai đều là hỏng-đóng, đúng.
    //
    // VIỆC MỘT LẦN — onboard Xã Thăng Bình (Thành phố Đà Nẵng) vào sổ xã của `platform`, gắn
    // admin.vigov.vn (chính) và admin-stg.vigov.vn. Chủ dự án chọn 26/09/2026.
    //
    // Vì sao cần: admin.vigov.vn trả 404 `tenant_not_found` — sổ xã không có dòng nào. Kho
    // không gieo xã nào (một xã thật là dữ liệu vận hành, không phải migration).
    //
    // tenant_id là ULID sinh MỘT lần lúc viết stage này (core/ulid.Moi) và cố định ở đây, để
    // chạy lại không tạo xã thứ hai (luật 1 bất biến 2: id vô nghĩa, bất biến). Tên + tỉnh viết
    // theo ADR 0017 ("Thành phố Đà Nẵng", đúng một cách viết mỗi tỉnh — ADR 0023).
    //
    // CHỈ THÊM, MỘT GIAO DỊCH, CÓ VẾT: dừng không ghi gì nếu id / tên miền / một xã trùng tên đã
    // có; ghi `audit_log` của platform cùng giao dịch (luật 6), chủ thể là người bấm job.
    //
    // CHẠY Ở ĐÂU: pod `platform` là distroless (không shell, không psql), nên job dựng một pod
    // `postgres:16-alpine` sống một lượt, đọc DATABASE_DSN từ `platform-secrets` (envFrom — DSN
    // không đi qua log hay tham số). `chay_psql` xoá pod khi xong.
    //
    // Staging và prod đang DÙNG CHUNG CSDL (Secret chép nguyên 25/09/2026), nên một lượt ghi
    // cho cả hai môi trường.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Tạo xã Thăng Bình') {
      when { expression { params.HANH_DONG == 'tao-xa-thang-binh' } }
      steps {
        script {
          if (params.MT != 'prod') { error('tao-xa-thang-binh chỉ chạy với MT=prod.') }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
          // Tên người bấm đi THẲNG vào câu SQL của dòng vết bên dưới — chỉ nhận ký tự an toàn.
          if (!(env.NGUOI_BAM ==~ /^[A-Za-z0-9._-]{1,64}$/)) {
            error("Tên người bấm '${env.NGUOI_BAM}' có ký tự không an toàn cho câu SQL — dừng.")
          }
        }
        writeFile file: 'tao-xa.sql', encoding: 'UTF-8', text: """\\set ON_ERROR_STOP on
BEGIN;
DO \$\$
BEGIN
  IF EXISTS (SELECT 1 FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8') THEN
    RAISE EXCEPTION 'DUNG: xa 01M3CS7HHK72V71CGRRJHGR8E8 da co — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant_domain WHERE host IN ('admin.vigov.vn', 'admin-stg.vigov.vn')) THEN
    RAISE EXCEPTION 'DUNG: ten mien admin.vigov.vn / admin-stg.vigov.vn da gan cho mot xa — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant WHERE lower(ten) LIKE '%thăng bình%') THEN
    RAISE EXCEPTION 'DUNG: da co mot xa ten Thang Binh — khong tao xa thu hai';
  END IF;
END \$\$;
INSERT INTO tenant (id, ten, tinh_thanh, dang_hoat_dong)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'Xã Thăng Bình', 'Thành phố Đà Nẵng', true);
INSERT INTO tenant_domain (host, tenant_id, la_chinh) VALUES
  ('admin.vigov.vn',     '01M3CS7HHK72V71CGRRJHGR8E8', true),
  ('admin-stg.vigov.vn', '01M3CS7HHK72V71CGRRJHGR8E8', false);
INSERT INTO audit_log (tenant_id, actor_id, actor_kind, action, subject, at, delta)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'van-hanh:${env.NGUOI_BAM}', 'system', 'tao_xa',
          'Xã Thăng Bình', now(),
          jsonb_build_object('ten', 'Xã Thăng Bình', 'tinh_thanh', 'Thành phố Đà Nẵng',
                             'ten_mien', jsonb_build_array('admin.vigov.vn', 'admin-stg.vigov.vn'),
                             'qua', 'jenkins vigov-deploy #${env.BUILD_NUMBER}'));
COMMIT;
SELECT t.id, t.ten, t.tinh_thanh, t.dang_hoat_dong, d.host, d.la_chinh
  FROM tenant t JOIN tenant_domain d ON d.tenant_id = t.id
 WHERE t.id = '01M3CS7HHK72V71CGRRJHGR8E8';
"""
        sh(CHAY_PSQL + '''
          echo "── các xã đang có trong sổ (trước khi ghi)"
          echo "SELECT id, ten, tinh_thanh, dang_hoat_dong FROM tenant ORDER BY tao_luc; SELECT host, tenant_id, la_chinh FROM tenant_domain ORDER BY host;" > doc-xa.sql
          chay_psql "vigov-psql-doc-$BUILD_NUMBER" doc-xa.sql
          echo "── ghi"
          chay_psql "vigov-psql-ghi-$BUILD_NUMBER" tao-xa.sql
          echo ""
          echo "Xong. Bước kế: chạy lại job này với HANH_DONG=doi-ten-mien-thang-binh."
        ''')
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // VIỆC MỘT LẦN — trỏ Xã Thăng Bình (01M3CS7HHK72V71CGRRJHGR8E8) sang tên miền của mô hình
    // chủ dự án chốt 26/09/2026: `<xã>.vigov.vn` (prod) · `<xã>.stg.vigov.vn` (staging). Mô hình
    // + nhãn dành riêng: ADR 0046; việc của người vận hành: deploy/cau-hinh/README.md mục 5.
    //
    // THỨ TỰ BẮT BUỘC — sai thứ tự là xã mất đăng nhập hoặc việc này không chạy được:
    //   1. DNS + TLS + Ingress cho thangbinh-danang.vigov.vn và thangbinh-danang.stg.vigov.vn chạy
    //      thật (cụm dựng tay trong Rancher — `deploy/base` KHÔNG được áp, nên đây là việc tay).
    //      Đổi tên miền chính trước khi host mới tới được pod là mọi đường dẫn dựng từ tên miền
    //      chính (thông báo, liên kết) trỏ vào một địa chỉ chưa ai trả lời.
    //   2. VIỆC NÀY — chạy được cả TRƯỚC lẫn SAU platform 0007: nó chỉ DELETE và INSERT, không
    //      UPDATE dòng admin.*, nên CHECK `tenant_domain_khong_danh_rieng` không có gì để từ chối.
    //      Thực tế 26/09/2026: 0007 áp lúc 07:50Z, TRƯỚC việc này (lượt #21 đo) — bản cũ có câu
    //      UPDATE la_chinh và dừng ở phép kiểm 0007; chủ dự án chọn "xoá trước, chèn sau".
    //
    // GỠ hai dòng admin.vigov.vn / admin-stg.vigov.vn — chủ dự án quyết 26/09/2026 ("xóa đi, nó
    // là dùng cho pod web admin tổng quản lý multi domain"). Đó là dòng định tuyến, không phải hồ
    // sơ nghiệp vụ; trạng thái trước khi gỡ nằm trong delta `truoc` của dòng vết `doi_ten_mien`.
    // Gỡ xong thì 0007 VALIDATE CONSTRAINT được — nhưng việc ấy để một migration sau quyết.
    //
    // GỠ HAI DÒNG + THÊM HAI DÒNG, MỘT GIAO DỊCH, CÓ VẾT: mọi phép kiểm RAISE và không ghi gì; dòng
    // `audit_log` cùng giao dịch, chủ thể là người bấm job (luật 6). Cách chạy psql và CSDL dùng
    // chung hai môi trường: như việc `tao-xa-thang-binh` ở trên.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Đổi tên miền Thăng Bình') {
      when { expression { params.HANH_DONG == 'doi-ten-mien-thang-binh' } }
      steps {
        script {
          if (params.MT != 'prod') { error('doi-ten-mien-thang-binh chỉ chạy với MT=prod.') }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
          // Tên người bấm đi THẲNG vào câu SQL của dòng vết bên dưới — chỉ nhận ký tự an toàn.
          if (!(env.NGUOI_BAM ==~ /^[A-Za-z0-9._-]{1,64}$/)) {
            error("Tên người bấm '${env.NGUOI_BAM}' có ký tự không an toàn cho câu SQL — dừng.")
          }
        }
        writeFile file: 'doi-ten-mien.sql', encoding: 'UTF-8', text: """\\set ON_ERROR_STOP on
BEGIN;
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8') THEN
    RAISE EXCEPTION 'DUNG: xa 01M3CS7HHK72V71CGRRJHGR8E8 chua co trong so xa — khong ghi gi';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8' AND dang_hoat_dong) THEN
    RAISE EXCEPTION 'DUNG: xa 01M3CS7HHK72V71CGRRJHGR8E8 khong con hoat dong — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant_domain
              WHERE host IN ('thangbinh-danang.vigov.vn', 'thangbinh-danang.stg.vigov.vn')
                AND tenant_id <> '01M3CS7HHK72V71CGRRJHGR8E8') THEN
    RAISE EXCEPTION 'DUNG: thangbinh-danang.vigov.vn / .stg.vigov.vn da gan cho MOT XA KHAC — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant_domain
              WHERE host = 'thangbinh-danang.vigov.vn' AND tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8' AND la_chinh) THEN
    RAISE EXCEPTION 'DUNG: thangbinh-danang.vigov.vn da la ten mien chinh — viec nay da chay, khong ghi gi';
  END IF;
END \$\$;
INSERT INTO audit_log (tenant_id, actor_id, actor_kind, action, subject, at, delta)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'van-hanh:${env.NGUOI_BAM}', 'system', 'doi_ten_mien',
          'Xã Thăng Bình', now(),
          jsonb_build_object(
            'truoc', (SELECT jsonb_agg(jsonb_build_object('host', host, 'la_chinh', la_chinh) ORDER BY host)
                        FROM tenant_domain WHERE tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8'),
            'chinh_moi', 'thangbinh-danang.vigov.vn',
            'them', jsonb_build_array('thangbinh-danang.vigov.vn', 'thangbinh-danang.stg.vigov.vn'),
            'go', jsonb_build_array('admin.vigov.vn', 'admin-stg.vigov.vn'),
            'qua', 'jenkins vigov-deploy #${env.BUILD_NUMBER}'));
-- Gỡ hai tên miền cũ: chủ dự án quyết 26/09/2026 — admin.vigov.vn là tên miền của pod web quản
-- trị tổng liên xã (chưa dựng), không phải của một xã. Đây là dòng ĐỊNH TUYẾN của sổ xã, không
-- phải hồ sơ nghiệp vụ; dòng vết `doi_ten_mien` ở trên giữ nguyên trạng thái trước (`truoc`).
-- Lọc đúng hai host VÀ đúng xã này — không bao giờ gỡ tên miền của xã khác.
--
-- XOÁ TRƯỚC, CHÈN SAU — không UPDATE (chủ dự án chọn 26/09/2026, sau lượt #21). Platform 0007 đã
-- áp, và CHECK NOT VALID của nó kiểm MỌI phiên bản dòng mới: hạ cờ la_chinh của admin.vigov.vn
-- bị từ chối (23514). DELETE không tạo phiên bản dòng mới nên CHECK không chạm; xoá xong thì xã
-- không còn dòng chính nào, và chỉ mục `tenant_domain_mot_chinh` nhận dòng chính mới.
DELETE FROM tenant_domain
 WHERE tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8'
   AND host IN ('admin.vigov.vn', 'admin-stg.vigov.vn');
INSERT INTO tenant_domain (host, tenant_id, la_chinh) VALUES
  ('thangbinh-danang.vigov.vn',     '01M3CS7HHK72V71CGRRJHGR8E8', true),
  ('thangbinh-danang.stg.vigov.vn', '01M3CS7HHK72V71CGRRJHGR8E8', false)
  ON CONFLICT (host) DO NOTHING;
DO \$\$
BEGIN
  IF (SELECT count(*) FROM tenant_domain
       WHERE host IN ('thangbinh-danang.vigov.vn', 'thangbinh-danang.stg.vigov.vn')
         AND tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8') <> 2 THEN
    RAISE EXCEPTION 'DUNG: sau khi ghi, hai ten mien moi khong cung thuoc xa 01M3CS7HHK72V71CGRRJHGR8E8 — quay lui, khong ghi gi';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM tenant_domain
                  WHERE host = 'thangbinh-danang.vigov.vn' AND tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8' AND la_chinh) THEN
    RAISE EXCEPTION 'DUNG: thangbinh-danang.vigov.vn khong thanh ten mien chinh (dong co san voi la_chinh=false?) — quay lui, khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant_domain WHERE host IN ('admin.vigov.vn', 'admin-stg.vigov.vn')) THEN
    RAISE EXCEPTION 'DUNG: admin.vigov.vn / admin-stg.vigov.vn van con (gan cho xa khac?) — quay lui, khong ghi gi';
  END IF;
END \$\$;
COMMIT;
SELECT t.id, t.ten, t.dang_hoat_dong, d.host, d.la_chinh
  FROM tenant t JOIN tenant_domain d ON d.tenant_id = t.id
 WHERE t.id = '01M3CS7HHK72V71CGRRJHGR8E8'
 ORDER BY d.host;
"""
        sh(CHAY_PSQL + '''
          echo "── tên miền của xã và hai host mới (trước khi ghi)"
          # Lượt #19: phép kiểm báo xã chưa có trong sổ dù `tao-xa-thang-binh` được ghi là đã chạy.
          # Đọc TOÀN BỘ sổ xã + CSDL đang nói chuyện + vết tao_xa, để biết xã thiếu thật hay DSN
          # trỏ nhầm CSDL — trước khi ai tạo lại một xã có thể đã tồn tại ở nơi khác.
          cat > doc-ten-mien.sql <<'SQL'
SELECT current_database() AS csdl, inet_server_addr() AS may_chu, current_user AS vai;
SELECT id, ten, tinh_thanh, dang_hoat_dong FROM tenant ORDER BY tao_luc;
SELECT host, tenant_id, la_chinh FROM tenant_domain ORDER BY host;
SELECT tenant_id, actor_id, action, subject, at FROM audit_log WHERE action IN ('tao_xa', 'doi_ten_mien') ORDER BY at;
SQL
          chay_psql "vigov-psql-doc-$BUILD_NUMBER" doc-ten-mien.sql
          echo "── ghi"
          chay_psql "vigov-psql-ghi-$BUILD_NUMBER" doi-ten-mien.sql
          echo ""
          echo "Xong. Thử: https://thangbinh-danang.vigov.vn/dang-nhap · https://thangbinh-danang.stg.vigov.vn/dang-nhap"
          echo "Bước kế: job service-platform (migration 0007)."
        ''')
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // VIỆC MỘT LẦN — ghi sổ `mini_app`: App ID 3291993990104489440 là app RIÊNG của Xã Thăng Bình
    // (01M3CS7HHK72V71CGRRJHGR8E8). Chủ dự án giao App ID và chọn đường này 27/09/2026: đẩy app lên
    // trước, màn ghi sổ ở platform-admin làm sau — gỡ stage này cùng commit thêm màn ấy.
    //
    // Vì sao cần: `ResolveMiniApp` là nơi DUY NHẤT máy chủ biết một App ID phục vụ xã nào (ADR
    // 0044, 0045). Không có dòng → từ chối, nên app đẩy lên được mà không mở được. Migration 0006
    // cố ý không gieo dòng nào (một App ID thật là dữ liệu vận hành, không phải migration).
    // `citizen-app/scripts/ung-dung-theo-ten-mien.mjs` giữ CÙNG cặp cho bước đẩy — hai nơi, chưa
    // có phép đối chiếu (ADR 0047 CÒN MỞ #3); sửa một thì sửa cả hai.
    //
    // CHỈ THÊM, MỘT GIAO DỊCH, CÓ VẾT, như `tao-xa-thang-binh`: mọi phép kiểm RAISE và không ghi
    // gì — xã thiếu hoặc ngừng hoạt động, App ID đã có dòng (kể cả dòng đã xoá mềm: khoá chính
    // giữ nó, một App ID không bao giờ bị gắn lại lặng lẽ). Dòng `audit_log` cùng giao dịch, chủ
    // thể là người bấm job (luật 6). Bảng chưa có (0006 chưa áp) thì psql lỗi và không ghi gì.
    // Cách chạy psql và CSDL dùng chung hai môi trường: như `tao-xa-thang-binh`.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Gắn Mini App Thăng Bình') {
      when { expression { params.HANH_DONG == 'gan-mini-app-thang-binh' } }
      steps {
        script {
          if (params.MT != 'prod') { error('gan-mini-app-thang-binh chỉ chạy với MT=prod.') }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
          // Tên người bấm đi THẲNG vào câu SQL bên dưới — chỉ nhận ký tự an toàn.
          if (!(env.NGUOI_BAM ==~ /^[A-Za-z0-9._-]{1,64}$/)) {
            error("Tên người bấm '${env.NGUOI_BAM}' có ký tự không an toàn cho câu SQL — dừng.")
          }
        }
        writeFile file: 'gan-mini-app.sql', encoding: 'UTF-8', text: """\\set ON_ERROR_STOP on
BEGIN;
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8' AND dang_hoat_dong) THEN
    RAISE EXCEPTION 'DUNG: xa 01M3CS7HHK72V71CGRRJHGR8E8 chua co hoac khong con hoat dong — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM mini_app WHERE app_id = '3291993990104489440') THEN
    RAISE EXCEPTION 'DUNG: App ID 3291993990104489440 da co dong trong mini_app (xem bang doc o tren) — khong ghi gi';
  END IF;
END \$\$;
INSERT INTO mini_app (app_id, che_do, tenant_id, ghi_chu, tao_boi, cap_nhat_boi)
  VALUES ('3291993990104489440', 'rieng', '01M3CS7HHK72V71CGRRJHGR8E8',
          'App riêng Xã Thăng Bình — App ID chủ dự án giao 27/09/2026 (jenkins vigov-deploy #${env.BUILD_NUMBER})',
          'van-hanh:${env.NGUOI_BAM}', 'van-hanh:${env.NGUOI_BAM}');
INSERT INTO audit_log (tenant_id, actor_id, actor_kind, action, subject, at, delta)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'van-hanh:${env.NGUOI_BAM}', 'system', 'gan_mini_app',
          'MiniApp 3291993990104489440', now(),
          jsonb_build_object('app_id', '3291993990104489440', 'che_do', 'rieng',
                             'xa', 'Xã Thăng Bình',
                             'qua', 'jenkins vigov-deploy #${env.BUILD_NUMBER}'));
COMMIT;
SELECT m.app_id, m.che_do, m.tenant_id, t.ten, m.dang_hoat_dong, m.tao_boi, m.tao_luc
  FROM mini_app m JOIN tenant t ON t.id = m.tenant_id
 WHERE m.app_id = '3291993990104489440';
"""
        sh(CHAY_PSQL + '''
          echo "── CSDL, xã, và sổ mini_app (trước khi ghi)"
          cat > doc-mini-app.sql <<'SQL'
SELECT current_database() AS csdl, current_user AS vai;
SELECT id, ten, dang_hoat_dong FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8';
