          chay_psql "vigov-psql-doc-$BUILD_NUMBER" doc-mini-app.sql
          echo "SELECT app_id, che_do, tenant_id, dang_hoat_dong, deleted_at FROM mini_app ORDER BY tao_luc;" > doc-mini-app-2.sql
          chay_psql "vigov-psql-doc2-$BUILD_NUMBER" doc-mini-app-2.sql || echo "   (không đọc được mini_app — migration 0006 chưa áp?)"
          echo "── ghi"
          chay_psql "vigov-psql-ghi-$BUILD_NUMBER" gan-mini-app.sql
          echo ""
          echo "Xong. Bước kế: cd citizen-app && npm run zmp:phat-hanh -- --domain=thangbinh-danang.vigov.vn (citizen-app/README.md §Nộp lên Zalo)"
        ''')
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // VIỆC MỘT LẦN — Xã Thăng Bình ĐỔI App ID (chủ dự án, 01/10/2026): 3291993990104489440 → 3043188591857102858.
    //
    // TẮT, KHÔNG XOÁ, dòng cũ: `dang_hoat_dong = false` là đúng cách migration 0006 dành cho việc này
    // (`0006:74-76` — một dòng tắt được trả lời như App ID lạ: từ chối). Dòng cũ là thứ đã quyết xã
    // của các phiên công dân trước đây, nên nó ở lại (luật 7), và App ID cũ không bao giờ được gắn
    // lại lặng lẽ (khoá chính giữ nó). Chủ dự án chọn TẮT (01/10/2026), không để hai app cùng chạy.
    //
    // MỘT GIAO DỊCH: thêm dòng mới, tắt dòng cũ, hai dòng `audit_log` — hoặc tất cả, hoặc không gì.
    // Một nửa (đã tắt cũ, chưa có mới) là một xã không mở được app nào. Mọi phép kiểm RAISE và
    // không ghi gì: xã thiếu/ngừng; dòng cũ không có, không còn hoạt động, đã xoá mềm, hay gắn xã
    // khác; App ID mới đã có dòng (kể cả xoá mềm).
    //
    // Cặp mới cũng phải sửa ở `citizen-app/scripts/ung-dung-theo-ten-mien.mjs` (đích đẩy bundle) —
    // cùng commit với stage này (ADR 0047 CÒN MỞ #3: hai nơi, chưa có phép đối chiếu).
    //
    // KHÔNG làm ở đây, là việc của người vận hành — khoá bí mật không đi qua tệp này (luật 8):
    //   · identity: `operatorctl mini-app-secret set --tenant 01M3CS7HHK72V71CGRRJHGR8E8
    //     --app-id 3043188591857102858 --ticket <n> < tệp-khoá` (khoá của App ID MỚI, lấy ở Zalo),
    //     rồi `mini-app-secret retire ... --app-id 3291993990104489440`.
    //   · vihat-miniapp: thêm cặp App ID mới = khoá vào biến các app xã (bước đổi mã vị trí).
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Đổi App ID Thăng Bình') {
      when { expression { params.HANH_DONG == 'doi-app-id-thang-binh' } }
      steps {
        script {
          if (params.MT != 'prod') { error('doi-app-id-thang-binh chỉ chạy với MT=prod.') }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
          // Tên người bấm đi THẲNG vào câu SQL bên dưới — chỉ nhận ký tự an toàn.
          if (!(env.NGUOI_BAM ==~ /^[A-Za-z0-9._-]{1,64}$/)) {
            error("Tên người bấm '${env.NGUOI_BAM}' có ký tự không an toàn cho câu SQL — dừng.")
          }
        }
        writeFile file: 'doi-app-id.sql', encoding: 'UTF-8', text: """\\set ON_ERROR_STOP on
BEGIN;
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8' AND dang_hoat_dong) THEN
    RAISE EXCEPTION 'DUNG: xa 01M3CS7HHK72V71CGRRJHGR8E8 chua co hoac khong con hoat dong — khong ghi gi';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM mini_app WHERE app_id = '3291993990104489440'
                   AND che_do = 'rieng' AND tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8'
                   AND dang_hoat_dong AND deleted_at IS NULL) THEN
    RAISE EXCEPTION 'DUNG: App ID cu 3291993990104489440 khong co dong dang hoat dong gan Xa Thang Binh (xem bang doc o tren) — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM mini_app WHERE app_id = '3043188591857102858') THEN
    RAISE EXCEPTION 'DUNG: App ID moi 3043188591857102858 da co dong trong mini_app (xem bang doc o tren) — khong ghi gi';
  END IF;
END \$\$;
INSERT INTO mini_app (app_id, che_do, tenant_id, ghi_chu, tao_boi, cap_nhat_boi)
  VALUES ('3043188591857102858', 'rieng', '01M3CS7HHK72V71CGRRJHGR8E8',
          'App riêng Xã Thăng Bình — App ID chủ dự án giao 01/10/2026, thay 3291993990104489440 (jenkins vigov-deploy #${env.BUILD_NUMBER})',
          'van-hanh:${env.NGUOI_BAM}', 'van-hanh:${env.NGUOI_BAM}');
UPDATE mini_app
   SET dang_hoat_dong = false, cap_nhat_luc = now(), cap_nhat_boi = 'van-hanh:${env.NGUOI_BAM}'
 WHERE app_id = '3291993990104489440' AND tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8' AND dang_hoat_dong;
INSERT INTO audit_log (tenant_id, actor_id, actor_kind, action, subject, at, delta)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'van-hanh:${env.NGUOI_BAM}', 'system', 'gan_mini_app',
          'MiniApp 3043188591857102858', now(),
          jsonb_build_object('app_id', '3043188591857102858', 'che_do', 'rieng',
                             'xa', 'Xã Thăng Bình', 'thay_cho', '3291993990104489440',
                             'qua', 'jenkins vigov-deploy #${env.BUILD_NUMBER}'));
INSERT INTO audit_log (tenant_id, actor_id, actor_kind, action, subject, at, delta)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'van-hanh:${env.NGUOI_BAM}', 'system', 'tat_mini_app',
          'MiniApp 3291993990104489440', now(),
          jsonb_build_object('app_id', '3291993990104489440',
                             'truoc', jsonb_build_object('dang_hoat_dong', true),
                             'sau', jsonb_build_object('dang_hoat_dong', false),
                             'ly_do', 'Xã Thăng Bình chuyển sang App ID 3043188591857102858 (chủ dự án, 01/10/2026)',
                             'qua', 'jenkins vigov-deploy #${env.BUILD_NUMBER}'));
COMMIT;
SELECT m.app_id, m.che_do, m.tenant_id, t.ten, m.dang_hoat_dong, m.tao_boi, m.tao_luc, m.cap_nhat_boi, m.cap_nhat_luc
  FROM mini_app m JOIN tenant t ON t.id = m.tenant_id
 WHERE m.app_id IN ('3291993990104489440', '3043188591857102858')
 ORDER BY m.tao_luc;
"""
        sh(CHAY_PSQL + '''
          echo "── CSDL, xã, và sổ mini_app (trước khi ghi)"
          cat > doc-doi-app-id.sql <<'SQL'
SELECT current_database() AS csdl, current_user AS vai;
SELECT id, ten, dang_hoat_dong FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8';
SELECT app_id, che_do, tenant_id, dang_hoat_dong, deleted_at FROM mini_app ORDER BY tao_luc;
SQL
          chay_psql "vigov-psql-doc-$BUILD_NUMBER" doc-doi-app-id.sql
          echo "── ghi"
          chay_psql "vigov-psql-ghi-$BUILD_NUMBER" doi-app-id.sql
          echo ""
          echo "Xong ở platform. Còn việc của người vận hành (khoá bí mật, không qua job này):"
          echo "  1. identity: operatorctl mini-app-secret set --tenant 01M3CS7HHK72V71CGRRJHGR8E8 --app-id 3043188591857102858 --ticket <n> < tệp-khoá"
          echo "  2. identity: operatorctl mini-app-secret retire --tenant 01M3CS7HHK72V71CGRRJHGR8E8 --app-id 3291993990104489440 --ticket <n>"
          echo "  3. vihat-miniapp: thêm cặp 3043188591857102858=<khoá> vào biến các app xã (đổi mã vị trí)"
          echo "  4. cd citizen-app && npm run zmp:phat-hanh -- --domain=thangbinh-danang.vigov.vn (ZMP_TOKEN của App ID mới; citizen-app/README.md §Nộp lên Zalo)"
        ''')
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // ĐĂNG NHẬP APP RIÊNG CỦA XÃ (ADR 0066) — đưa lên cụm thật. THỨ TỰ BẮT BUỘC:
    //
    //   1. tao-khoa-ma-hoa-identity      (MT=prod)   SECRET_ENCRYPTION_KEYS vào identity-secrets
    //                                                 của vigov-prod + vigov-staging, cùng giá trị.
    //                                                 Thiếu nó thì ảnh identity mới TỪ CHỐI khởi động.
    //   2. mo-netpol-identity-zalo       (MT=prod, rồi MT=staging)   đường ra 443 tới Zalo, nếu cần.
    //   3. bo-sung-cau-hinh-identity     (MT=prod, rồi MT=staging)   PETITIONS_GRPC_ADDR ·
    //                                                 DOCUMENTS_GRPC_ADDR · CITIZEN_SESSION_BRIDGE_LISTEN_ADDR
    //                                                 vào env của deploy identity, CITIZEN_SESSION_BRIDGE_KEYS
    //                                                 vào identity-secrets (cùng giá trị hai namespace).
    //                                                 Thiếu chúng thì ảnh identity mới TỪ CHỐI khởi động
    //                                                 (sự cố 01/10/2026).
    //   4. job `service-identity` (service-identity/Jenkinsfile) — ảnh có migration 0021 +
    //      /operatorctl, và khởi động lại pod để đọc khoá ở bước 1. KHÔNG làm lại ở đây.
    //      rồi kiem-tra-dang-nhap-app-rieng (chỉ đọc) — tuyến mới có sống chưa.
    //   5. đặt App Secret của App ID xã: platform-admin "Đặt/đổi khoá bí mật", hoặc
    //      dat-secret-mini-app (MT=prod).
    //   rồi: cd citizen-app && npm run zmp:deploy -- --domain=thangbinh-danang.vigov.vn
    //   (không có --demo: danh tính demo đã gỡ 05/10/2026, ADR 0066 §Sửa đổi; không có --vao-thang:
    //   bỏ 06/10/2026, --domain nay luôn nung tên miền — ADR 0047 §Sửa đổi 06/10/2026 #5; deploy.mjs
    //   từ chối cả hai cờ. Lệnh đầy đủ: citizen-app/README.md §Nộp lên Zalo).
    //
    // Cùng bản ở trang của người vận hành: deploy/cau-hinh/README.md mục 6. Sửa một thì sửa cả hai.
    // Gỡ năm việc này cùng commit đưa platform-admin có màn tương ứng.
    // ─────────────────────────────────────────────────────────────────────────────────────

    // ─────────────────────────────────────────────────────────────────────────────────────
    // BƯỚC 1 — SECRET_ENCRYPTION_KEYS của identity (ADR 0009, 0066). Một khoá: 32 byte từ
    // /dev/urandom (CSPRNG của nhân), base64 chuẩn — đúng dạng core/config/secret_encryption.go
    // đòi (danh sách `<mới>,<cũ>`, một phần tử là đủ).
    //
    // KHÔNG BAO GIỜ GHI ĐÈ: prod đã có key → DỪNG, prod không bị đụng. Ghi đè là mọi khoá dữ liệu
    // đã niêm bằng khoá cũ — và mọi secret Zalo của mọi xã — không mở lại được nữa.
    //
    // CÙNG MỘT GIÁ TRỊ Ở STAGING: hai môi trường dùng CHUNG CSDL (xem trên), nên khoá dữ liệu
    // staging niêm thì prod phải mở được và ngược lại. Staging có một giá trị KHÁC → DỪNG, báo.
    // Prod có mà staging thiếu (lượt trước ghi được prod, hỏng ở staging) → chỉ CHÉP prod sang
    // staging — không ghi đè gì, prod không bị đụng.
    //
    // GIÁ TRỊ KHÔNG BAO GIỜ VÀO LOG HAY DÒNG LỆNH: sinh thẳng vào tệp trong thư mục tạm (umask
    // 077, xoá khi thoát), bản vá đi qua `--patch-file` (không qua `-p`, vì argv hiện trong `ps`),
    // staging chép THEO TÊN từ prod qua tệp, so khớp bằng `cmp -s`. Không `set -x`.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Tạo khoá mã hoá identity') {
      when { expression { params.HANH_DONG == 'tao-khoa-ma-hoa-identity' } }
      steps {
        script {
          if (params.MT != 'prod') { error('tao-khoa-ma-hoa-identity chỉ chạy với MT=prod (nó ghi cả prod lẫn staging).') }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
        }
        sh '''
          set -eu
          umask 077
          TMP_DIR=$(mktemp -d)
          trap 'rm -f "$TMP_DIR"/*; rmdir "$TMP_DIR"' EXIT
          kubectl patch --help 2>/dev/null | grep -q -- '--patch-file' || {
            echo "DỪNG: kubectl của máy chủ build không có 'patch --patch-file' — giá trị sẽ phải đi qua dòng lệnh. Không đổi gì."
            exit 1; }
          for ns in vigov-prod vigov-staging; do
            kubectl -n "$ns" get secret identity-secrets >/dev/null 2>&1 || {
              echo "DỪNG: không thấy secret/identity-secrets trong $ns — không đổi gì."; exit 1; }
          done
          # CHỈ TÊN KEY: duyệt khoá của .data, không chạm giá trị.
          has_key() {
            kubectl -n "$1" get secret identity-secrets \
              -o go-template='{{range $k, $v := .data}}{{if eq $k "SECRET_ENCRYPTION_KEYS"}}yes{{end}}{{end}}'
          }
          # Giá trị (dạng base64 của .data) đi THẲNG vào tệp — không bao giờ ra stdout của job.
          read_key() {
            kubectl -n "$1" get secret identity-secrets \
              -o go-template='{{index .data "SECRET_ENCRYPTION_KEYS"}}' > "$2"
          }
          # Bản vá merge chỉ MỘT key; tệp vào là dạng base64 của .data.
          write_patch() {
            { printf '{"data":{"SECRET_ENCRYPTION_KEYS":"'; tr -d '\\n' < "$1"; printf '"}}'; } > "$2"
          }
          copy_prod_to_staging() {
            read_key vigov-prod "$TMP_DIR/prod"
            write_patch "$TMP_DIR/prod" "$TMP_DIR/patch-staging.json"
            kubectl -n vigov-staging patch secret identity-secrets --type=merge \
                --patch-file "$TMP_DIR/patch-staging.json" >/dev/null || {
              echo "⚠ prod ĐÃ CÓ khoá, staging CHƯA ghi được — chạy lại việc này (nó chỉ chép prod sang staging)."
              exit 1; }
            read_key vigov-staging "$TMP_DIR/staging"
            cmp -s "$TMP_DIR/prod" "$TMP_DIR/staging" || {
              echo "⚠ sau khi ghi, giá trị ở vigov-staging KHÁC vigov-prod — dừng, kiểm tay (không in giá trị)."; exit 1; }
            echo "✓ vigov-staging: identity-secrets có SECRET_ENCRYPTION_KEYS, CÙNG giá trị với prod (so bằng cmp, không in)"
          }
          # Cách sao lưu — LỆNH, không giá trị.
          print_next_steps() {
            cat <<'EOF'

SAO LƯU NGAY — TRƯỚC KHI LƯU SECRET ZALO ĐẦU TIÊN. Mất khoá này là mất mọi secret đã niêm (ADR 0009).
Từ một máy tin cậy có kubeconfig ViGov (KHÔNG phải máy chủ build), không in ra màn hình:

  kubectl -n vigov-prod get secret identity-secrets \\
    -o go-template='{{index .data "SECRET_ENCRYPTION_KEYS"}}' | base64 -d > <tệp trong kho bí mật>

Cất TÁCH khỏi bản sao lưu CSDL identity: một bản sao lưu chứa cả hai là bản chứa bản rõ.

identity đọc biến lúc KHỞI ĐỘNG: pod đang chạy chưa thấy khoá này. Bước kế:
  2. job này, HANH_DONG=mo-netpol-identity-zalo (MT=prod, rồi MT=staging)
  3. job này, HANH_DONG=bo-sung-cau-hinh-identity (MT=prod, rồi MT=staging)
  4. job service-identity — triển khai ảnh mới và khởi động lại pod
EOF
          }

          in_prod=$(has_key vigov-prod)
          in_staging=$(has_key vigov-staging)

          if [ -n "$in_prod" ]; then
            echo "identity-secrets của vigov-prod ĐÃ CÓ SECRET_ENCRYPTION_KEYS — prod KHÔNG bị đổi."
            echo "(Ghi đè là mọi secret đã niêm bằng khoá ấy không mở lại được nữa.)"
            if [ -z "$in_staging" ]; then
              echo "vigov-staging còn THIẾU — chép giá trị của prod sang (không ghi đè gì):"
              copy_prod_to_staging
              print_next_steps
              exit 0
            fi
            read_key vigov-prod "$TMP_DIR/prod"
            read_key vigov-staging "$TMP_DIR/staging"
            if cmp -s "$TMP_DIR/prod" "$TMP_DIR/staging"; then
              echo "✓ vigov-staging cũng có, CÙNG giá trị — bước 1 đã xong ở cả hai. Không đổi gì."
              exit 0
            fi
            echo "DỪNG: vigov-staging có SECRET_ENCRYPTION_KEYS KHÁC prod. Hai môi trường dùng CHUNG CSDL, nên"
            echo "khoá dữ liệu một bên niêm thì bên kia không mở được. Không đổi gì — người vận hành phải xác định"
            echo "bên nào đã niêm secret (bảng data_encryption_key của identity) trước khi chọn giữ giá trị nào."
            exit 1
          fi

          if [ -n "$in_staging" ]; then
            echo "DỪNG: vigov-prod CHƯA có SECRET_ENCRYPTION_KEYS nhưng vigov-staging ĐÃ CÓ — mọi khoá sinh mới đều"
            echo "KHÁC giá trị ấy, mà hai môi trường dùng CHUNG CSDL. Không đổi gì. Nếu staging đã niêm secret bằng"
            echo "khoá của nó thì prod phải dùng ĐÚNG giá trị ấy — chép tay theo tên, qua ống, không in ra."
            exit 1
          fi

          head -c 32 /dev/urandom | base64 -w0 > "$TMP_DIR/key"
          [ "$(base64 -d < "$TMP_DIR/key" | wc -c)" -eq 32 ] || {
            echo "DỪNG: khoá sinh ra không đủ 32 byte — không đổi gì."; exit 1; }
          # .data là base64 của GIÁ TRỊ, mà giá trị lại là base64 của khoá — nên mã hoá thêm một lần.
          base64 -w0 < "$TMP_DIR/key" > "$TMP_DIR/key.data"
          write_patch "$TMP_DIR/key.data" "$TMP_DIR/patch-prod.json"
          kubectl -n vigov-prod patch secret identity-secrets --type=merge \
              --patch-file "$TMP_DIR/patch-prod.json" >/dev/null
          read_key vigov-prod "$TMP_DIR/prod"
          cmp -s "$TMP_DIR/key.data" "$TMP_DIR/prod" || {
            echo "⚠ đọc lại từ cụm, giá trị ở vigov-prod không khớp giá trị vừa sinh — dừng, kiểm tay."; exit 1; }
          echo "✓ vigov-prod: đã thêm SECRET_ENCRYPTION_KEYS vào identity-secrets (một khoá, 32 byte; giá trị không in)"
          copy_prod_to_staging
          print_next_steps
        '''
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // BƯỚC 2 — đường ra 443 của RIÊNG identity tới Zalo Graph API: bản cho cụm dựng tay của
    // quy tắc 10 trong deploy/base/mang/netpol.yaml (`allow-identity-egress-zalo`). Thiếu nó trên
    // một namespace có hạn chế đường ra thì pod xanh mà mọi lượt đăng nhập thật của app riêng trả
    // 502 — trong khi pod và mọi phép kiểm sức khoẻ vẫn xanh: đúng kiểu hỏng trông như chạy được.
    //
    // CHỈ ÁP KHI ĐƯỜNG RA CỦA IDENTITY ĐÃ BỊ HẠN CHẾ. Một NetworkPolicy loại Egress chọn một pod là
    // biến pod ấy thành "chặn mọi đường ra trừ đường được mở" — áp quy tắc này lên một identity
    // CHƯA bị hạn chế sẽ CHẶN DNS, CSDL, platform, Redis của nó. Nên: không có NetworkPolicy, hoặc
    // không cái Egress nào chọn pod identity → đường ra đang mở, không làm gì. Một cái có
    // matchExpressions (không tự đối chiếu được) → DỪNG, người xem tay.
    //
    // Pod chọn theo `spec.selector.matchLabels` THẬT của Deployment dựng tay (nhãn workloadselector
    // của Rancher), không theo nhãn `deploy/base`. `kubectl apply` — chạy lại không sinh bản thứ hai.
    //
    // ⚠ 443 mở tới `0.0.0.0/0` vì Zalo không công bố dải địa chỉ; CHỈ pod identity, CHỈ cổng 443 — cùng
    // loại nợ với quy tắc 4 và 9 (`_chung/netpol-duong-ra-tam-mo`). Một pod identity bị chiếm quyền gửi
    // được tới bất kỳ máy nào mở 443, thay vì chỉ tới Zalo. Thay bằng egress gateway / FQDN policy khi cụm có.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Mở đường ra Zalo cho identity') {
      when { expression { params.HANH_DONG == 'mo-netpol-identity-zalo' } }
      steps {
        script {
          if (params.XAC_NHAN != env.NS) {
            error("XAC_NHAN phải là đúng '${env.NS}' (namespace của MT). Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
        }
        sh '''
          set -eu
          TMP_DIR=$(mktemp -d)
          trap 'rm -f "$TMP_DIR"/*; rmdir "$TMP_DIR"' EXIT
          POLICY=allow-identity-egress-zalo
          DEP=vigov-service-identity

          kubectl -n "$NS" get deploy "$DEP" >/dev/null 2>&1 || {
            echo "DỪNG: không thấy deploy/$DEP trong $NS — không đổi gì."; exit 1; }
          if [ -n "$(kubectl -n "$NS" get deploy "$DEP" -o go-template='{{if .spec.selector.matchExpressions}}yes{{end}}')" ]; then
            echo "DỪNG: selector của $DEP có matchExpressions — không tự dựng podSelector được. Không đổi gì."; exit 1
          fi
          kubectl -n "$NS" get deploy "$DEP" \
            -o go-template='{{range $k, $v := .spec.selector.matchLabels}}{{$k}}={{$v}}{{"\\n"}}{{end}}' > "$TMP_DIR/selector"
          kubectl -n "$NS" get deploy "$DEP" \
            -o go-template='{{range $k, $v := .spec.template.metadata.labels}}{{$k}}={{$v}}{{"\\n"}}{{end}}' > "$TMP_DIR/pod-labels"
          [ -s "$TMP_DIR/selector" ] || { echo "DỪNG: $DEP không có spec.selector.matchLabels — không đổi gì."; exit 1; }
          echo "── pod identity chọn theo selector THẬT của deploy/$DEP:"
          sed 's/^/   /' "$TMP_DIR/selector"

          # `get` hỏng (thiếu quyền) phải DỪNG ở đây — không được đọc thành "không có cái nào".
          kubectl -n "$NS" get networkpolicy \
            -o go-template='{{range .items}}{{.metadata.name}}|{{range .spec.policyTypes}}{{.}} {{end}}|{{range $k, $v := .spec.podSelector.matchLabels}}{{$k}}={{$v}},{{end}}|{{if .spec.podSelector.matchExpressions}}expr{{end}}{{"\\n"}}{{end}}' \
            > "$TMP_DIR/policies"
          echo "── NetworkPolicy đang có trong $NS (tên | loại | podSelector)"
          if [ ! -s "$TMP_DIR/policies" ]; then
            echo "   (không có cái nào)"
            echo "Đường ra của mọi pod trong $NS KHÔNG bị hạn chế — identity tới được Zalo. Không cần, không đổi gì."
            exit 0
          fi
          sed 's/^/   /' "$TMP_DIR/policies"

          restricted=""; unknown=""; ours=""
          while IFS='|' read -r name types labels expr; do
            [ -n "$name" ] || continue
            if [ "$name" = "$POLICY" ]; then ours=yes; continue; fi
            case " $types " in *" Egress "*) ;; *) continue ;; esac
            if [ -n "$expr" ]; then unknown="$unknown $name"; continue; fi
            hit=yes
            for pair in $(printf '%s' "$labels" | tr ',' ' '); do
              grep -qxF "$pair" "$TMP_DIR/pod-labels" || { hit=""; break; }
            done
            [ -z "$hit" ] || restricted="$restricted $name"
          done < "$TMP_DIR/policies"

          if [ -n "$unknown" ]; then
            echo "DỪNG: NetworkPolicy loại Egress dùng matchExpressions:$unknown — không tự đối chiếu được với pod identity."
            echo "Xem tay; không đổi gì."
            exit 1
          fi
          if [ -z "$restricted" ]; then
            if [ -n "$ours" ]; then
              echo "⚠ $POLICY ĐÃ CÓ và là cái DUY NHẤT hạn chế đường ra của identity — nó đang CHẶN mọi đường ra"
              echo "khác 443 (DNS, CSDL, platform, Redis). Không đổi gì; người vận hành gỡ tay sau khi xác nhận."
              exit 1
            fi
            echo "Không NetworkPolicy loại Egress nào chọn pod identity — đường ra của nó KHÔNG bị hạn chế, tới được Zalo."
            echo "Không cần; không đổi gì. (Áp quy tắc này lúc này sẽ CHẶN mọi đường ra khác của identity.)"
            exit 0
          fi
          echo "Đường ra của identity ĐANG bị hạn chế bởi:$restricted — áp $POLICY (mở thêm TCP 443)."

          {
cat <<'YAML'
# 10. Đường RA của RIÊNG identity: 443 tới Zalo (ADR 0066) — bản cụm dựng tay, áp bởi vigov-deploy.
# ⚠ NỢ: 443 mở tới 0.0.0.0/0 vì Zalo không công bố dải địa chỉ; CHỈ pod identity, CHỈ cổng 443.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-identity-egress-zalo
  annotations:
    vigov.vn/open-debt: "443 to 0.0.0.0/0: Zalo publishes no address range. Replace with an egress gateway / FQDN policy (deploy/base/mang/netpol.yaml rule 10)."
spec:
  podSelector:
    matchLabels:
YAML
            while IFS='=' read -r k v; do
              printf '      "%s": "%s"\\n' "$k" "$v"
            done < "$TMP_DIR/selector"
cat <<'YAML'
  policyTypes: [Egress]
  egress:
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0       # ← NỢ: Zalo không công bố dải; giữ giới hạn cổng 443
      ports:
        - { port: 443, protocol: TCP }
YAML
          } > "$TMP_DIR/policy.yaml"
          kubectl -n "$NS" apply -f "$TMP_DIR/policy.yaml"
          echo "── $POLICY sau khi áp"
          kubectl -n "$NS" get networkpolicy "$POLICY" -o wide
          echo ""
          echo "DNS: identity đã gọi platform/CSDL theo tên, nên chính sách đang có phải đã mở DNS cho nó — tên"
          echo "graph.zalo.me đi cùng đường ấy. Bước kế: HANH_DONG=bo-sung-cau-hinh-identity, rồi job service-identity."
        '''
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // BƯỚC 3 — bốn biến mà ảnh identity từ `config.Uses` (29/09/2026) đòi ở staging/prod. Sự cố
    // 01/10/2026: ảnh mới crash-loop ở vigov-prod, "thiếu biến môi trường bắt buộc: PETITIONS_GRPC_ADDR,
    // DOCUMENTS_GRPC_ADDR, CITIZEN_SESSION_BRIDGE_LISTEN_ADDR, CITIZEN_SESSION_BRIDGE_KEYS". Chỗ đặt
    // và dạng giá trị: core/config/hints.go + deploy/cau-hinh/README.md mục 1 và 3.
    //
    //   ba biến KHÔNG bí mật → `env:` của deploy identity (KHÔNG common-config: dịch vụ khác không
    //   dùng chúng, và CITIZEN_SESSION_BRIDGE_LISTEN_ADDR không có khoá đi kèm thì pod khác từ chối
    //   khởi động). CHỈ THÊM cái còn thiếu; cái đã có — dù khác giá trị ở đây — GIỮ NGUYÊN và in ra:
    //   một giá trị ai đó đã đặt tay là quyết định của người ấy, không phải của job này.
    //   CITIZEN_SESSION_BRIDGE_KEYS → identity-secrets: 48 byte /dev/urandom, base64 (đúng
    //   `openssl rand -base64 48` của hints.go), MỘT khoá. Bảng quyết định Y HỆT bước 1 (đã có ở prod
    //   → giữ; staging thiếu → chép prod sang; staging KHÁC → DỪNG trước khi ghi gì; chỉ lượt MT=prod
    //   được SINH khoá — lượt MT=staging thấy prod chưa có thì DỪNG). Cùng giá trị ở
    //   hai namespace cho đồng bộ với bước 1: người vận hành chỉ phải chép MỘT giá trị sang Secret
    //   của vihat-miniapp, và hai môi trường không lệch nhau một cách không ai ghi lại.
    //
    // THỨ TỰ: mọi phép ĐỌC trước, rồi khoá, rồi env. `kubectl set env` đổi pod template = BẮT ĐẦU
    // rollout; làm nó sau khoá thì rollout ấy đã thấy khoá, và một DỪNG ở bước khoá để Deployment
    // nguyên vẹn. Khởi động lại CHỈ khi đọc lại từ cụm thấy đủ cả bốn — không đủ thì khởi động lại chỉ
    // ra thêm một vòng crash-loop.
    //
    // Service petitions/documents thiếu cổng 9090 → CHỈ CẢNH BÁO, không sửa Service: identity vẫn
    // khởi động (gRPC quay số lười), chỉ việc xoá mềm đơn vị hỏng tới khi Service mở 9090. Sửa Service
    // dựng tay trong Rancher là việc của người vận hành, không phải tác dụng phụ của việc này.
    //
    // GIÁ TRỊ KHOÁ không bao giờ vào log hay dòng lệnh — cùng cách bước 1 (umask 077, tệp tạm,
    // --patch-file, so bằng cmp -s, không set -x). Giá trị ba biến env không bí mật nên được in.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Bổ sung cấu hình identity') {
      when { expression { params.HANH_DONG == 'bo-sung-cau-hinh-identity' } }
      steps {
        script {
          if (!(params.MT in ['prod', 'staging'])) { error("bo-sung-cau-hinh-identity: MT '${params.MT}' không hợp lệ.") }
          if (params.XAC_NHAN != env.NS) {
            error("XAC_NHAN phải là đúng '${env.NS}' (namespace của MT). Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
        }
        sh '''
          set -eu
          umask 077
          TMP_DIR=$(mktemp -d)
          trap 'rm -f "$TMP_DIR"/*; rmdir "$TMP_DIR"' EXIT
          DEP=vigov-service-identity
          KEY=CITIZEN_SESSION_BRIDGE_KEYS
          PETITIONS_SVC=vigov-service-petitions
          DOCUMENTS_SVC=vigov-service-documents
          BRIDGE_ADDR=:9091   # deploy/base/identity (cổng `bridge`), netpol.yaml quy tắc 8–9

          # ── 0. ĐỌC — chưa ghi gì. Hỏng một điều kiện = DỪNG, cụm không bị đụng.
          kubectl patch --help 2>/dev/null | grep -q -- '--patch-file' || {
            echo "DỪNG: kubectl của máy chủ build không có 'patch --patch-file' — giá trị sẽ phải đi qua dòng lệnh. Không đổi gì."
            exit 1; }
          kubectl -n "$NS" get deploy "$DEP" >/dev/null 2>&1 || {
            echo "DỪNG: không thấy deploy/$DEP trong $NS — không đổi gì."; exit 1; }
          n=$(kubectl -n "$NS" get deploy "$DEP" -o go-template='{{len .spec.template.spec.containers}}')
          [ "$n" = "1" ] || { echo "DỪNG: deploy/$DEP có $n container — không biết đặt env vào cái nào. Không đổi gì."; exit 1; }
          # Tên Service là một nửa giá trị sẽ ghi. Không thấy (kể cả vì thiếu quyền đọc) = DỪNG, không đoán.
          missing_svc=""
          for s in "$PETITIONS_SVC" "$DOCUMENTS_SVC"; do
            kubectl -n "$NS" get svc "$s" >/dev/null 2>&1 || missing_svc="$missing_svc $s"
          done
          if [ -n "$missing_svc" ]; then
            echo "DỪNG: không thấy Service:$missing_svc trong $NS — tên khác giả định của job này. Không đổi gì."
            echo "Service đang có (tên · cổng):"
            kubectl -n "$NS" get svc -o go-template='{{range .items}}   {{.metadata.name}} ·{{range .spec.ports}} {{.port}}/{{.protocol}}{{end}}{{"\\n"}}{{end}}' || true
            exit 1
          fi
          for ns in vigov-prod vigov-staging; do
            kubectl -n "$ns" get secret identity-secrets >/dev/null 2>&1 || {
              echo "DỪNG: không thấy secret/identity-secrets trong $ns — không đổi gì."; exit 1; }
          done

          svc_ports() { kubectl -n "$NS" get svc "$1" -o go-template='{{range .spec.ports}} {{.port}}/{{.protocol}}{{end}}'; }
          dep_ports() { kubectl -n "$NS" get deploy "$1" -o go-template='{{range (index .spec.template.spec.containers 0).ports}} {{.containerPort}}{{end}}'; }
          env_names() {
            kubectl -n "$NS" get deploy "$1" \
              -o go-template='{{range (index .spec.template.spec.containers 0).env}}{{.name}}{{"\\n"}}{{end}}'
          }
          # Chỉ dùng cho biến KHÔNG bí mật. valueFrom không đọc theo — in nguồn, không in giá trị.
          env_value() {
            kubectl -n "$NS" get deploy "$1" \
              -o go-template='{{range (index .spec.template.spec.containers 0).env}}{{if eq .name "'"$2"'"}}{{if .valueFrom}}<valueFrom>{{else}}{{.value}}{{end}}{{end}}{{end}}'
          }

          # ── 2. CHỈ CẢNH BÁO — petitions/documents có nghe gRPC ở 9090 qua Service không.
          grpc_cm=$(kubectl -n "$NS" get configmap common-config \
                      -o go-template='{{range $k, $v := .data}}{{if eq $k "GRPC_LISTEN_ADDR"}}{{$v}}{{end}}{{end}}' 2>/dev/null || true)
          grpc_warn=""
          for s in "$PETITIONS_SVC" "$DOCUMENTS_SVC"; do
            ports=$(svc_ports "$s")
            echo "── svc/$s, cổng:${ports:- (không có)}"
            case " $ports " in *" 9090/TCP "*) echo "   ✓ có 9090"; continue ;; esac
            grpc_warn="$grpc_warn $s"
            echo "   ⚠ KHÔNG có 9090"
            if kubectl -n "$NS" get deploy "$s" >/dev/null 2>&1; then
              grpc_dep=$(env_value "$s" GRPC_LISTEN_ADDR)
              echo "   deploy/$s: containerPort:$(dep_ports "$s")"
              echo "   GRPC_LISTEN_ADDR: env của Deployment '${grpc_dep:-(không đặt)}' · common-config '${grpc_cm:-(không đặt)}'"
              if [ -z "$grpc_dep" ] && [ -z "$grpc_cm" ]; then
                echo "   → không đặt ở đâu: tiến trình nghe gRPC ở MẶC ĐỊNH :9090 (core/config, GRPC_LISTEN_ADDR)."
              fi
            else
              echo "   (không thấy deploy/$s — không đọc được cổng của pod)"
            fi
          done
          if [ -n "$grpc_warn" ]; then
            cat <<EOF

⚠ CẢNH BÁO — Service$grpc_warn không mở 9090. identity VẪN khởi động được (gRPC quay số lười),
nhưng XOÁ MỀM MỘT ĐƠN VỊ sẽ HỎNG (identity hỏi petitions/documents trước khi xoá) tới khi:
  (a) Service mở cổng 9090/TCP → targetPort 9090, VÀ
  (b) pod thật sự nghe 9090 (GRPC_LISTEN_ADDR như in ở trên; không đặt = :9090).
Job này KHÔNG sửa Service — người vận hành thêm cổng trong Rancher (deploy/cau-hinh/README.md mục 3).
EOF
          fi
          id_ports=$(svc_ports "$DEP")
          case " $id_ports " in
            *" 9091/TCP "*) ;;
            *) echo ""
               echo "⚠ svc/$DEP, cổng:${id_ports:- (không có)} — chưa mở 9091 (cầu phiên công dân). identity vẫn khởi động;"
               echo "  vihat-miniapp chỉ gọi được cầu khi Service + containerPort có 9091 (deploy/base/identity, netpol quy tắc 8–9)." ;;
          esac

          # ── 3. KHOÁ — bảng quyết định của bước 1, đổi tên key. Không in giá trị.
          has_key() {
            kubectl -n "$1" get secret identity-secrets \
              -o go-template='{{range $k, $v := .data}}{{if eq $k "CITIZEN_SESSION_BRIDGE_KEYS"}}yes{{end}}{{end}}'
          }
          read_key() {
            kubectl -n "$1" get secret identity-secrets \
              -o go-template='{{index .data "CITIZEN_SESSION_BRIDGE_KEYS"}}' > "$2"
          }
          write_patch() {
            { printf '{"data":{"CITIZEN_SESSION_BRIDGE_KEYS":"'; tr -d '\\n' < "$1"; printf '"}}'; } > "$2"
          }
          copy_prod_to_staging() {
            read_key vigov-prod "$TMP_DIR/prod"
            write_patch "$TMP_DIR/prod" "$TMP_DIR/patch-staging.json"
            kubectl -n vigov-staging patch secret identity-secrets --type=merge \
                --patch-file "$TMP_DIR/patch-staging.json" >/dev/null || {
              echo "⚠ prod ĐÃ CÓ $KEY, staging CHƯA ghi được — chạy lại việc này (nó chỉ chép prod sang staging)."
              exit 1; }
            read_key vigov-staging "$TMP_DIR/staging"
            cmp -s "$TMP_DIR/prod" "$TMP_DIR/staging" || {
              echo "⚠ sau khi ghi, $KEY ở vigov-staging KHÁC vigov-prod — dừng, kiểm tay (không in giá trị)."; exit 1; }
            echo "✓ vigov-staging: identity-secrets có $KEY, CÙNG giá trị với prod (so bằng cmp, không in)"
          }
          ensure_key() {
            in_prod=$(has_key vigov-prod)
            in_staging=$(has_key vigov-staging)
            if [ -n "$in_prod" ]; then
              echo "identity-secrets của vigov-prod ĐÃ CÓ $KEY — giữ nguyên (đổi nó là cắt vihat-miniapp đang dùng khoá ấy)."
              if [ -z "$in_staging" ]; then
                echo "vigov-staging còn THIẾU — chép giá trị của prod sang (không ghi đè gì):"
                copy_prod_to_staging
                return 0
              fi
              read_key vigov-prod "$TMP_DIR/prod"
              read_key vigov-staging "$TMP_DIR/staging"
              if cmp -s "$TMP_DIR/prod" "$TMP_DIR/staging"; then
                echo "✓ vigov-staging cũng có, CÙNG giá trị. Không đổi Secret nào."
                return 0
              fi
              echo "DỪNG: vigov-staging có $KEY KHÁC prod. Không đổi gì (env của deploy cũng chưa đổi) — người vận"
              echo "hành xác định vihat-miniapp đang gửi khoá nào trước khi chọn giữ giá trị nào."
              exit 1
            fi
            if [ -n "$in_staging" ]; then
              echo "DỪNG: vigov-prod CHƯA có $KEY nhưng vigov-staging ĐÃ CÓ — khoá sinh mới sẽ KHÁC giá trị ấy."
              echo "Không đổi gì. Nếu vihat-miniapp đã dùng khoá của staging thì prod phải dùng ĐÚNG giá trị ấy —"
              echo "chép tay theo tên, qua tệp, không in ra."
              exit 1
            fi
            # Lượt MT=staging chỉ được xác nhận cho vigov-staging — nó không là lượt sinh khoá cho prod.
            if [ "$NS" != "vigov-prod" ]; then
              echo "DỪNG: cả hai namespace đều chưa có $KEY. Khoá sinh ở prod rồi chép sang staging — chạy việc"
              echo "này với MT=prod (XAC_NHAN=vigov-prod) trước. Không đổi gì."
              exit 1
            fi
            head -c 48 /dev/urandom | base64 -w0 > "$TMP_DIR/key"
            [ "$(base64 -d < "$TMP_DIR/key" | wc -c)" -eq 48 ] || {
              echo "DỪNG: khoá sinh ra không đủ 48 byte — không đổi gì."; exit 1; }
            # .data là base64 của GIÁ TRỊ, mà giá trị là base64 của khoá — mã hoá thêm một lần.
            base64 -w0 < "$TMP_DIR/key" > "$TMP_DIR/key.data"
            write_patch "$TMP_DIR/key.data" "$TMP_DIR/patch-prod.json"
            kubectl -n vigov-prod patch secret identity-secrets --type=merge \
                --patch-file "$TMP_DIR/patch-prod.json" >/dev/null
            read_key vigov-prod "$TMP_DIR/prod"
            cmp -s "$TMP_DIR/key.data" "$TMP_DIR/prod" || {
              echo "⚠ đọc lại từ cụm, $KEY ở vigov-prod không khớp giá trị vừa sinh — dừng, kiểm tay."; exit 1; }
            echo "✓ vigov-prod: đã thêm $KEY vào identity-secrets (một khoá, 48 byte; giá trị không in)"
            copy_prod_to_staging
          }
          echo ""
          echo "── $KEY trong identity-secrets (vigov-prod + vigov-staging)"
          ensure_key

          # ── 1. ENV — chỉ thêm cái còn thiếu, không đổi cái đã có.
          echo ""
          echo "── env của deploy/$DEP"
          env_names "$DEP" > "$TMP_DIR/env-names"
          to_set=""
          for pair in "PETITIONS_GRPC_ADDR=$PETITIONS_SVC:9090" \
                      "DOCUMENTS_GRPC_ADDR=$DOCUMENTS_SVC:9090" \
                      "CITIZEN_SESSION_BRIDGE_LISTEN_ADDR=$BRIDGE_ADDR"; do
            name=${pair%%=*}
            if grep -qxF "$name" "$TMP_DIR/env-names"; then
              echo "   $name: giữ nguyên — đang là '$(env_value "$DEP" "$name")'"
            else
              echo "   $name: chưa có → đặt ${pair#*=}"
              to_set="$to_set $pair"
            fi
          done
          if [ -n "$to_set" ]; then
            # Giá trị không bí mật, không có khoảng trắng — tách từ ở đây là cố ý.
            kubectl -n "$NS" set env deploy/"$DEP" $to_set
          fi

          # ── 4. ĐỌC LẠI từ cụm; đủ cả bốn mới khởi động lại.
          missing=""
          for name in PETITIONS_GRPC_ADDR DOCUMENTS_GRPC_ADDR CITIZEN_SESSION_BRIDGE_LISTEN_ADDR; do
            [ -n "$(env_value "$DEP" "$name")" ] || missing="$missing $name"
          done
          [ -n "$(has_key "$NS")" ] || missing="$missing $KEY"
          if [ -n "$missing" ]; then
            echo "DỪNG: đọc lại vẫn thiếu (hoặc rỗng):$missing — KHÔNG khởi động lại. Sửa tay rồi chạy lại việc này."
            exit 1
          fi
          echo "✓ đủ bốn biến cho deploy/$DEP trong $NS — khởi động lại"
          kubectl -n "$NS" rollout restart deploy/"$DEP"
          if ! kubectl -n "$NS" rollout status deploy/"$DEP" --timeout=180s; then
            pod=$(kubectl -n "$NS" get pod --sort-by=.metadata.creationTimestamp -o name 2>/dev/null \
                    | grep "^pod/$DEP-" | tail -1 || true)
            echo ""
            echo "✗ rollout chưa xong sau 3 phút. 60 dòng log cuối của ${pod:-(không thấy pod)}"
            echo "  (lỗi cấu hình chỉ in TÊN biến, không giá trị):"
            if [ -n "$pod" ]; then
              kubectl -n "$NS" logs "$pod" --tail=60 2>&1 || true
              echo "── lần chạy trước của pod ấy:"
              kubectl -n "$NS" logs "$pod" --tail=60 --previous 2>/dev/null || echo "   (không có)"
            fi
            exit 1
          fi
          echo "✓ deploy/$DEP trong $NS đã sẵn sàng."

          cat <<'EOF'

CÙNG GIÁ TRỊ CITIZEN_SESSION_BRIDGE_KEYS PHẢI VÀO Secret của vihat-miniapp khi cầu của app chung được
triển khai (ADR 0045; phía ấy đặt VIGOV_CITIZEN_SESSION_BRIDGE_ADDRESS trỏ tới cổng 9091 của identity).
Từ một máy tin cậy có kubeconfig ViGov (KHÔNG phải máy chủ build), vào tệp được bảo vệ, không in ra:

  umask 077
  kubectl -n vigov-prod get secret identity-secrets \\
    -o go-template='{{index .data "CITIZEN_SESSION_BRIDGE_KEYS"}}' | base64 -d > <tệp trong kho bí mật>

Chép theo tệp, xoá tệp khi xong. Không dán vào chat, ticket hay dòng lệnh.
EOF
          if [ "$NS" = "vigov-prod" ]; then
            echo "Bước kế: chạy lại việc này với MT=staging (XAC_NHAN=vigov-staging) — Secret staging đã có khoá,"
            echo "nhưng env + khởi động lại của deploy identity ở staging là lượt riêng. Rồi job service-identity."
          else
            echo "Bước kế: job service-identity (nếu ảnh mới chưa triển khai), rồi HANH_DONG=kiem-tra-dang-nhap-app-rieng."
          fi
        '''
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // SAU BƯỚC 4 (job service-identity) — CHỈ ĐỌC. Tuyến mới có sống thật chưa: key có trong
    // Secret (chỉ TÊN), ảnh đang chạy, Ingress của host API identity trỏ về Service nào, và một
    // `POST /api/v1/citizen-sessions` thân `{}` — mong 400 `invalid_body` (tuyến mới trả lời);
    // 404 = ảnh cũ hoặc Ingress sai. Lượt thử tính vào giới hạn 10 lần / 5 phút / IP của tuyến ấy.
    // Hỏng một phép kiểm → lượt ĐỎ, sau khi đã in đủ: xanh-mà-chưa-chạy là dạng hỏng tệ nhất.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Kiểm đăng nhập app riêng') {
      when { expression { params.HANH_DONG == 'kiem-tra-dang-nhap-app-rieng' } }
      steps {
        script {
          // Host đọc từ deploy/hosts.yaml — nơi DUY NHẤT viết host công khai (chủ dự án, 01/10/2026),
          // không gõ lại ở đây. Pipeline này không dùng readYaml (pipeline-utility-steps) ở đâu khác,
          // nên đọc bằng awk: đúng MỘT `api_suffix` dưới mục `name: <MT>` của `environments`, đúng dạng
          // tên miền. Không thấy, thấy hai, hay sai dạng → DỪNG lượt; không bao giờ đoán host.
          def suffix = ''
          withEnv(["MT=${params.MT}"]) {
            suffix = sh(returnStdout: true, script: '''
              set -eu
              [ -r deploy/hosts.yaml ] || { echo "DỪNG: không đọc được deploy/hosts.yaml" >&2; exit 1; }
              v=$(awk -v want="$MT" '
                /^[^ #]/ { inenv = ($0 ~ /^environments:/); name = ""; next }
                inenv && /^  - name:/ { name = $3; gsub(/"/, "", name); next }
                inenv && /^    api_suffix:/ && name == want { s = $2; gsub(/"/, "", s); print s }
              ' deploy/hosts.yaml)
              n=$(printf '%s\\n' "$v" | grep -c . || true)
              [ "$n" = "1" ] || { echo "DỪNG: deploy/hosts.yaml có $n api_suffix cho MT=$MT, cần đúng 1" >&2; exit 1; }
              printf '%s' "$v" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$' \
                || { echo "DỪNG: api_suffix của MT=$MT trong deploy/hosts.yaml không phải tên miền" >&2; exit 1; }
              printf '%s' "$v"
            ''').trim()
          }
          env.API_HOST = "identity.${suffix}"
        }
        sh '''
          set -u
          TMP_DIR=$(mktemp -d)
          trap 'rm -f "$TMP_DIR"/*; rmdir "$TMP_DIR"' EXIT
          DEP=vigov-service-identity
          failed=""

          echo "── identity-secrets: có key SECRET_ENCRYPTION_KEYS? (CHỈ TÊN KEY)"
          has=$(kubectl -n "$NS" get secret identity-secrets \
                  -o go-template='{{range $k, $v := .data}}{{if eq $k "SECRET_ENCRYPTION_KEYS"}}yes{{end}}{{end}}' 2>/dev/null || true)
          if [ -n "$has" ]; then echo "   ✓ có"; else echo "   ✗ THIẾU — chạy tao-khoa-ma-hoa-identity (MT=prod)"; failed="$failed khoa"; fi

          echo "── deploy/$DEP: ảnh, bản sẵn sàng, envFrom"
          kubectl -n "$NS" get deploy "$DEP" \
            -o go-template='{{range .spec.template.spec.containers}}   ảnh: {{.image}}{{"\\n"}}   envFrom:{{range .envFrom}}{{if .secretRef}} secret/{{.secretRef.name}}{{end}}{{if .configMapRef}} configmap/{{.configMapRef.name}}{{end}}{{end}}{{"\\n"}}{{end}}   sẵn sàng: {{.status.readyReplicas}}/{{.spec.replicas}} · cập nhật: {{.status.updatedReplicas}}{{"\\n"}}' \
            || { echo "   ✗ không đọc được deploy/$DEP"; failed="$failed deploy"; }
          echo "   (thẻ ảnh là commit của lượt build service-identity — đối chiếu với lịch sử job ấy)"

          echo "── Service identity"
          kubectl -n "$NS" get svc "$DEP" -o wide 2>/dev/null || { echo "   ✗ không thấy svc/$DEP"; failed="$failed svc"; }

          echo "── Ingress có host $API_HOST"
          kubectl -n "$NS" get ingress \
            -o go-template='{{range .items}}{{$n := .metadata.name}}{{range .spec.rules}}{{if eq .host "'"$API_HOST"'"}}{{range .http.paths}}{{$n}} {{.path}} {{.backend.service.name}}:{{.backend.service.port.number}}{{.backend.service.port.name}}{{"\\n"}}{{end}}{{end}}{{end}}{{end}}' \
            > "$TMP_DIR/ingress" 2>/dev/null || true
          if [ -s "$TMP_DIR/ingress" ]; then
            sed 's/^/   /' "$TMP_DIR/ingress"
            grep -q " $DEP:" "$TMP_DIR/ingress" || { echo "   ✗ không đường nào trỏ về svc/$DEP"; failed="$failed ingress"; }
          else
            echo "   ✗ không Ingress nào trong $NS khai host $API_HOST"; failed="$failed ingress"
          fi

          echo "── POST https://$API_HOST/api/v1/citizen-sessions thân {} — mong 400 invalid_body"
          if command -v curl >/dev/null 2>&1; then
            code=$(curl -sS -o "$TMP_DIR/body" -w '%{http_code}' --max-time 20 -X POST \
                     -H 'Content-Type: application/json' --data '{}' \
                     "https://$API_HOST/api/v1/citizen-sessions" 2>"$TMP_DIR/err" || true)
            echo "   HTTP $code · thân: $(head -c 300 "$TMP_DIR/body" 2>/dev/null)"
            if [ "$code" = "400" ] && grep -q '"invalid_body"' "$TMP_DIR/body"; then
              echo "   ✓ tuyến mới đang trả lời"
            else
              case "$code" in
                404) echo "   ✗ 404 — ảnh identity CŨ (chưa có tuyến) hoặc Ingress không tới identity" ;;
                429) echo "   ✗ 429 — giới hạn tần suất của tuyến; đợi 5 phút rồi chạy lại" ;;
                000) echo "   ✗ không kết nối được: $(head -c 300 "$TMP_DIR/err")" ;;
                *)   echo "   ✗ không phải 400 invalid_body" ;;
              esac
              failed="$failed probe"
            fi
          else
            echo "   ✗ máy chủ build thiếu curl — không thử được"; failed="$failed curl"
          fi

          if [ -n "$failed" ]; then echo ""; echo "CHƯA ĐẠT:$failed"; exit 1; fi
          echo ""
          echo "✓ Đạt. Bước kế: đặt App Secret — platform-admin 'Đặt/đổi khoá bí mật', hoặc HANH_DONG=dat-secret-mini-app (MT=prod)."
        '''
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // BƯỚC 5 — ĐẶT APP SECRET của app riêng một xã — `operatorctl mini-app-secret set` (ADR 0066 quyết định 3,
    // tới khi platform-admin có màn). Thiếu nó, POST /api/v1/citizen-sessions trả 422 app_not_ready
    // và app riêng không gửi được phản ánh nào — lý do Zalo từ chối bản duyệt ngày 05/10/2026.
    // Cùng việc ở platform-admin: "Đặt/đổi khoá bí mật" ở chi tiết xã.
    //
    // CHẠY Ở ĐÂU: pod identity là distroless (không shell), nên job dựng một pod sống MỘT lượt từ
    // ĐÚNG ảnh Deployment identity đang chạy (đọc từ cụm, không đoán thẻ) — ảnh ấy mang
    // /operatorctl từ service-identity/Dockerfile — với ĐÚNG envFrom + env + imagePullSecrets của
    // Deployment (đọc bằng kubectl, dùng lại nguyên). Manifest pod viết vào TỆP rồi `create -f`:
    // env của Deployment không bao giờ lên dòng lệnh. Không attach/stdin (lý do ở `chay_psql`):
    // hỏi pha bằng `get`, đọc `logs`, xoá pod.
    //
    // Pod KHÔNG mang nhãn của Deployment: mang nhãn ấy là Service identity gửi lưu lượng thật vào
    // một pod không nghe cổng nào. Nên nếu NetworkPolicy hạn chế đường ra theo nhãn ấy, pod này có
    // thể không tới CSDL / platform — log sẽ nói.
    //
    // MT=prod CHỈ: staging dùng chung CSDL. Vết kiểm toán ghi ở xã đích, chủ thể system, lý do
    // ticket:<TICKET> (operatorctl); người bấm nằm trong tên lượt build.
    //
    // ĐƯỜNG CỦA SECRET: ảnh distroless không có shell để chuyển stdin, và job không attach được
    // (lý do ở `chay_psql`), nên secret đi: tham số password → tệp 0600 trên máy build (printf là lệnh
    // dựng sẵn của sh — không lên `ps`) → Secret k8s tạm → tệp mount chỉ-đọc → `--secret-file`.
    // Không bao giờ ở argv, manifest pod hay log. trap xoá pod, Secret tạm và tệp cả khi lỗi.
    //
    // Giá trị mặc định của APP_SECRET là chỗ giữ chỗ: còn nguyên thì DỪNG trước mọi lệnh kubectl.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Đặt secret Mini App') {
      when { expression { params.HANH_DONG == 'dat-secret-mini-app' } }
      steps {
        script {
          if (params.MT != 'prod') { error('dat-secret-mini-app chỉ chạy với MT=prod (staging dùng chung CSDL).') }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
          if (!(params.TENANT_ID ==~ /^[0-7][0-9A-HJKMNP-TV-Z]{25}$/)) {
            error("TENANT_ID '${params.TENANT_ID}' không phải ULID (26 ký tự Crockford base32, chữ hoa). Không ghi gì cả.")
          }
          if (!(params.APP_ID ==~ /^[0-9]{1,32}$/)) {
            error("APP_ID '${params.APP_ID}' phải chỉ gồm chữ số. Không ghi gì cả.")
          }
          if (!(params.TICKET ==~ /^[A-Za-z0-9._-]{1,64}$/)) {
            error("TICKET bắt buộc, chỉ A-Z a-z 0-9 . _ -, tối đa 64 ký tự. Nhận được: '${params.TICKET}'. Không ghi gì cả.")
          }
          env.TENANT_ID = params.TENANT_ID
          env.APP_ID = params.APP_ID
          env.TICKET = params.TICKET
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.HANH_DONG} · ${params.APP_ID} · ${env.NGUOI_BAM}"
        }
        sh '''
          set -eu
          umask 077
          # Read in the shell, not in Groovy: a password parameter reaches `sh` as plain env, and is masked
          # in the console by Jenkins.
          case "${APP_SECRET:-}" in
            ""|THAY-BANG-APP-SECRET-CUA-ZALO)
              echo "DỪNG: APP_SECRET còn trống hoặc còn giá trị giữ chỗ. Dán App Secret thật của App ID $APP_ID"
              echo "(developers.zalo.me → app → Cài đặt → App Secret) rồi bấm lại. Không ghi gì cả."
              exit 1 ;;
          esac
          TMP_DIR=$(mktemp -d)
          DEP=vigov-service-identity
          POD="vigov-operatorctl-$BUILD_NUMBER"
          SEC="vigov-app-secret-$BUILD_NUMBER"
          trap 'kubectl -n vigov-prod delete pod "$POD" --ignore-not-found --wait=false >/dev/null 2>&1 || true
                kubectl -n vigov-prod delete secret "$SEC" --ignore-not-found >/dev/null 2>&1 || true
                rm -f "$TMP_DIR"/*; rmdir "$TMP_DIR"' EXIT

          n=$(kubectl -n vigov-prod get deploy "$DEP" -o go-template='{{len .spec.template.spec.containers}}')
          [ "$n" = "1" ] || { echo "DỪNG: deploy/$DEP có $n container — không biết lấy ảnh nào. Không ghi gì."; exit 1; }
          get_field() { kubectl -n vigov-prod get deploy "$DEP" -o jsonpath="$1"; }
          IMG=$(get_field '{.spec.template.spec.containers[0].image}')
          get_field '{.spec.template.spec.containers[0].envFrom}' > "$TMP_DIR/envfrom"
          get_field '{.spec.template.spec.containers[0].env}' > "$TMP_DIR/env"
          get_field '{.spec.template.spec.imagePullSecrets}' > "$TMP_DIR/pull"
          for f in envfrom env pull; do [ -s "$TMP_DIR/$f" ] || printf '[]' > "$TMP_DIR/$f"; done
          echo "── ảnh: $IMG"
          echo "── lệnh: /operatorctl mini-app-secret set --tenant $TENANT_ID --app-id $APP_ID --ticket $TICKET --secret-file /run/app-secret/value"

          printf '%s' "$APP_SECRET" > "$TMP_DIR/value"
          kubectl -n vigov-prod create secret generic "$SEC" --from-file=value="$TMP_DIR/value" >/dev/null
          rm -f "$TMP_DIR/value"

          {
            printf '{"apiVersion":"v1","kind":"Pod","metadata":{"name":"%s","labels":{"app.kubernetes.io/name":"identity-operatorctl"}},' "$POD"
            printf '"spec":{"restartPolicy":"Never","imagePullSecrets":'; cat "$TMP_DIR/pull"
            # 0444 (292): the distroless image runs as nonroot, and a 0400 root-owned file would be unreadable.
            # The pod has one container and lives for one command.
            printf ',"volumes":[{"name":"app-secret","secret":{"secretName":"%s","defaultMode":292}}]' "$SEC"
            printf ',"containers":[{"name":"operatorctl","image":"%s","envFrom":' "$IMG"; cat "$TMP_DIR/envfrom"
            printf ',"env":'; cat "$TMP_DIR/env"
            printf ',"volumeMounts":[{"name":"app-secret","mountPath":"/run/app-secret","readOnly":true}]'
            printf ',"command":["/operatorctl","mini-app-secret","set","--tenant","%s","--app-id","%s","--ticket","%s","--secret-file","/run/app-secret/value"]}]}}' \
              "$TENANT_ID" "$APP_ID" "$TICKET"
          } > "$TMP_DIR/pod.json"
          kubectl -n vigov-prod create -f "$TMP_DIR/pod.json" >/dev/null

          phase=""; i=0
          while [ $i -lt 60 ]; do   # 60 × 5 giây = 5 phút
            phase=$(kubectl -n vigov-prod get pod "$POD" -o jsonpath='{.status.phase}' 2>/dev/null || true)
            case "$phase" in Succeeded|Failed) break ;; esac
            sleep 5; i=$((i+1))
          done
          echo "── log của operatorctl"
          kubectl -n vigov-prod logs "$POD" 2>&1 || true
          if [ "$phase" != "Succeeded" ]; then
            echo "── pod $POD kết thúc ở pha '$phase' — sự kiện của pod:"
            kubectl -n vigov-prod describe pod "$POD" 2>/dev/null | sed -n '/^Events:/,$p' || true
            echo "Gợi ý: 'flag provided but not defined: -secret-file' = ảnh identity cũ — chạy job service-identity trước;"
            echo "'not bound' / App ID chưa gắn xã = chạy HANH_DONG=doi-app-id-thang-binh trước;"
            echo "SECRET_ENCRYPTION_KEYS rỗng = HANH_DONG=tao-khoa-ma-hoa-identity."
            exit 1
          fi
          echo ""
          echo "Xong. Kiểm: POST https://identity.api.vigov.vn/api/v1/citizen-sessions với token giả phải trả 401 (không còn 422)."
        '''
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // TẠO TÀI KHOẢN VẬN HÀNH platform-admin — `operatorctl create` rồi `grant` đủ sáu quyền `ops.*`
    // (service-identity/internal/domain/operator.go:36-41). Chủ dự án chọn 02/10/2026 chạy qua job này
    // thay vì kubectl tay.
    //
    // ĐÚNG ADR 0048 (§Chốt 28/09, dòng "Ai tạo, ai cấp quyền"): tên đăng nhập là EMAIL, mật khẩu do
    // hệ thống sinh, in MỘT lần, hết hạn sau 24 giờ, buộc đổi + đăng ký TOTP ở lần đăng nhập đầu. Job
    // KHÔNG nhận mật khẩu đặt trước — seed một bí mật qua cấu hình là phương án ADR ấy đã bác.
    //
    // GIÁ ĐÃ CHẤP NHẬN (chủ dự án 02/10/2026): `operatorctl` in mật khẩu tạm ra stdout, nên nó nằm trong
    // log lượt build này (giữ 200 lượt). ADR 0048 §"Mật khẩu tạm" nêu đúng mối nguy: ai đọc được trước
    // người nhận là tự đăng ký TOTP của mình và chiếm tài khoản. Nên: đăng nhập và đổi NGAY sau lượt chạy.
    //
    // EMAIL LÀ DỮ LIỆU CÁ NHÂN (luật 3): không echo, không lên tên lượt build. Nó vẫn đi vào lệnh của
    // pod (`kubectl describe` thấy) và Jenkins lưu tham số — pod bị xoá khi kết thúc.
    //
    // Cùng khuôn pod một lượt của bước 5 ở trên (ảnh distroless, không shell → mỗi lệnh một pod; env
    // của Deployment đọc từ cụm, viết vào TỆP, không lên dòng lệnh). MT=prod chỉ: sổ vận hành nằm trong
    // CSDL identity, staging dùng chung CSDL.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Tạo tài khoản vận hành') {
      when { expression { params.HANH_DONG == 'tao-tai-khoan-van-hanh' } }
      steps {
        script {
          if (params.MT != 'prod') { error("tao-tai-khoan-van-hanh chỉ chạy với MT=prod (staging dùng chung CSDL).") }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
          // Các giá trị đi vào manifest JSON của pod — chỉ nhận đúng dạng, không ký tự nào phải thoát
          // (không " \ hay ký tự điều khiển), trước mọi lệnh kubectl.
          if (!(params.EMAIL_VAN_HANH ==~ /^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,24}$/)) {
            error("EMAIL_VAN_HANH không đúng dạng email. Không ghi gì cả.")   // không in lại giá trị (luật 3)
          }
          if (!(params.TEN_VAN_HANH ==~ /^\p{L}[\p{L} .'-]{0,99}$/)) {
            error("TEN_VAN_HANH chỉ nhận chữ cái, khoảng trắng, . ' - (tối đa 100 ký tự). Không ghi gì cả.")
          }
          if (!(params.TICKET ==~ /^[A-Za-z0-9._-]{1,64}$/)) {
            error("TICKET bắt buộc, chỉ A-Z a-z 0-9 . _ -, tối đa 64 ký tự. Nhận được: '${params.TICKET}'. Không ghi gì cả.")
          }
          env.OP_EMAIL = params.EMAIL_VAN_HANH
          env.OP_NAME = params.TEN_VAN_HANH
          env.TICKET = params.TICKET
          env.RUN_DETAIL = "tạo tài khoản vận hành · ticket ${params.TICKET}"
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.HANH_DONG} · ${env.NGUOI_BAM}"
        }
        sh '''
          set -eu
          umask 077
          TMP_DIR=$(mktemp -d)
          DEP=vigov-service-identity
          PODS=""
          trap 'for p in $PODS; do kubectl -n vigov-prod delete pod "$p" --ignore-not-found --wait=false >/dev/null 2>&1 || true; done; rm -f "$TMP_DIR"/*; rmdir "$TMP_DIR"' EXIT

          n=$(kubectl -n vigov-prod get deploy "$DEP" -o go-template='{{len .spec.template.spec.containers}}')
          [ "$n" = "1" ] || { echo "DỪNG: deploy/$DEP có $n container — không biết lấy ảnh nào. Không ghi gì."; exit 1; }
          get_field() { kubectl -n vigov-prod get deploy "$DEP" -o jsonpath="$1"; }
          IMG=$(get_field '{.spec.template.spec.containers[0].image}')
          get_field '{.spec.template.spec.containers[0].envFrom}' > "$TMP_DIR/envfrom"
          get_field '{.spec.template.spec.containers[0].env}' > "$TMP_DIR/env"
          get_field '{.spec.template.spec.imagePullSecrets}' > "$TMP_DIR/pull"
          for f in envfrom env pull; do [ -s "$TMP_DIR/$f" ] || printf '[]' > "$TMP_DIR/$f"; done
          echo "── ảnh: $IMG"

          # run_op <hậu tố pod> <mảng lệnh JSON đã dựng sẵn> — một pod một lượt, log vào $TMP_DIR/<hậu tố>.log.
          # Trả 0 khi pod Succeeded.
          run_op() {
            pod="vigov-operatorctl-$BUILD_NUMBER-$1"
            PODS="$PODS $pod"
            {
              printf '{"apiVersion":"v1","kind":"Pod","metadata":{"name":"%s","labels":{"app.kubernetes.io/name":"identity-operatorctl"}},' "$pod"
              printf '"spec":{"restartPolicy":"Never","imagePullSecrets":'; cat "$TMP_DIR/pull"
              printf ',"containers":[{"name":"operatorctl","image":"%s","envFrom":' "$IMG"; cat "$TMP_DIR/envfrom"
              printf ',"env":'; cat "$TMP_DIR/env"
              printf ',"command":%s}]}}' "$2"
            } > "$TMP_DIR/pod-$1.json"
            # `|| return 1`: run_op chạy trong `if`, nơi `set -e` không có tác dụng — thiếu nó thì một
            # lần create hỏng vẫn đợi đủ 5 phút cho một pod không tồn tại.
            kubectl -n vigov-prod create -f "$TMP_DIR/pod-$1.json" >/dev/null || { rm -f "$TMP_DIR/pod-$1.json"; return 1; }
            rm -f "$TMP_DIR/pod-$1.json"   # mang email — không để lại trên đĩa agent
            phase=""; i=0
            while [ $i -lt 60 ]; do   # 60 × 5 giây = 5 phút
              phase=$(kubectl -n vigov-prod get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)
              case "$phase" in Succeeded|Failed) break ;; esac
              sleep 5; i=$((i+1))
            done
            kubectl -n vigov-prod logs "$pod" > "$TMP_DIR/$1.log" 2>&1 || true
            if [ "$phase" != "Succeeded" ]; then
              cat "$TMP_DIR/$1.log"
              echo "── pod $pod kết thúc ở pha '$phase' — sự kiện của pod:"
              kubectl -n vigov-prod describe pod "$pod" 2>/dev/null | sed -n '/^Events:/,$p' || true
              return 1
            fi
            return 0
          }

          echo "── operatorctl create --email *** --name <TEN_VAN_HANH> --ticket $TICKET"
          if ! run_op create "[\\"/operatorctl\\",\\"create\\",\\"--email\\",\\"$OP_EMAIL\\",\\"--name\\",\\"$OP_NAME\\",\\"--ticket\\",\\"$TICKET\\"]"; then
            echo "Gợi ý: 'no such file' /operatorctl = ảnh identity cũ; 'operator tables do not exist' = migration 0012"
            echo "chưa áp; email đã có tài khoản = dùng operatorctl list / reset-mfa, KHÔNG tạo lại. Không cấp quyền nào."
            exit 1
          fi
          CODE=$(grep -o 'created VH-[0-9]\\{5\\}' "$TMP_DIR/create.log" | head -1 | cut -d' ' -f2)
          [ -n "$CODE" ] || { cat "$TMP_DIR/create.log"; echo "DỪNG: không đọc được mã VH- trong kết quả create."; exit 1; }
          echo "── đã tạo $CODE"

          failed=""
          for perm in ops.tenant.manage ops.domain.manage ops.profile.manage ops.mini_app.manage ops.upload_policy.manage ops.qr.issue ops.petition_field.manage; do
            suffix="grant-$(printf '%s' "$perm" | tr '._' '--')"
            if run_op "$suffix" "[\\"/operatorctl\\",\\"grant\\",\\"--code\\",\\"$CODE\\",\\"--permission\\",\\"$perm\\",\\"--ticket\\",\\"$TICKET\\"]"; then
              echo "   ✓ $perm"
            else
              failed="$failed $perm"
            fi
          done

          echo ""
          echo "════════════════════════════════════════════════════════════════════════════"
          # Dòng mật khẩu tạm — lần DUY NHẤT nó xuất hiện. Chủ dự án chấp nhận nó nằm trong log này.
          grep -A1 '^temporary password' "$TMP_DIR/create.log" || true
          echo "════════════════════════════════════════════════════════════════════════════"
          echo "Tài khoản $CODE. Đăng nhập platform-admin bằng email vừa nhập + mật khẩu tạm trên,"
          echo "đổi mật khẩu (tối thiểu 12 ký tự) và đăng ký TOTP NGAY — mật khẩu tạm hết hạn sau 24 giờ."
          if [ -n "$failed" ]; then
            echo ""
            echo "CHƯA CẤP ĐƯỢC:$failed — tài khoản ĐÃ tạo; cấp nốt bằng operatorctl grant --code $CODE ..."
            exit 1
          fi
        '''
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // DỰNG CLAMAV (clamd) — máy quét mã độc tệp tải lên của petitions (ADR 0052 §9). Manifest và
    // lý do từng lựa chọn (RAM, đường ra freshclam, StreamMaxLength, không Ingress): đầu tệp
    // deploy/cluster/clamav.yaml. Chạy MT=prod và MT=staging riêng — mỗi namespace một clamd.
    //
    // THỨ TỰ: ĐỌC trước (common-config có không, NetworkPolicy nào đang có) → `apply` (chạy lại
    // không sinh bản thứ hai) → đợi sẵn sàng → THỬ THẬT bằng PING/PONG từ một pod khác qua Service
    // (đúng đường petitions sẽ đi, không phải từ trong pod clamd) → MỚI ghi common-config.
    // Ghi địa chỉ trước khi clamd trả lời là để petitions khởi động với một máy quét chưa ai thấy chạy.
    //
    // MALWARE_SCANNER_ADDRESS CHỈ THÊM KHI CHƯA CÓ — có rồi (kể cả khác giá trị) thì GIỮ NGUYÊN và
    // in ra: giá trị ai đó đặt tay là quyết định của người ấy. Không bí mật nên được in.
    // KHÔNG khởi động lại dịch vụ nào: petitions đọc key ở lần khởi động kế (job service-petitions).
    //
    // POD THỬ: dùng LẠI ảnh clamav của Deployment (đã kéo về node, cùng pull secret) với `command`
    // thay entrypoint — `echo PING | nc` như clamdcheck.sh của ảnh. Không attach/stdin (lý do ở
    // `chay_psql`): hỏi pha bằng `get`, đọc `logs`, xoá pod. Nhãn KHÁC nhãn của Deployment, không thì
    // Service vigov-clamav gửi lưu lượng vào pod thử.
    //
    // THỜI GIAN: lần đầu freshclam tải ~300 MB rồi clamd mới mở 3310 — `rollout status` 600 giây +
    // pod thử ≤ 2 phút, dưới giới hạn 20 phút của job.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Dựng ClamAV') {
      when { expression { params.HANH_DONG == 'dung-clamav' } }
      steps {
        script {
          if (!(params.MT in ['prod', 'staging'])) { error("dung-clamav: MT '${params.MT}' không hợp lệ.") }
          if (params.XAC_NHAN != env.NS) {
            error("XAC_NHAN phải là đúng '${env.NS}' (namespace của MT). Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
        }
        sh '''
          set -eu
          TMP_DIR=$(mktemp -d)
          DEP=vigov-clamav
          ADDR=vigov-clamav:3310
          KEY=MALWARE_SCANNER_ADDRESS
          POD="vigov-clamav-ping-$BUILD_NUMBER"
          trap 'kubectl -n "$NS" delete pod "$POD" --ignore-not-found --wait=false >/dev/null 2>&1 || true; rm -f "$TMP_DIR"/*; rmdir "$TMP_DIR"' EXIT

          # In sự kiện + 80 dòng log của pod clamd mới nhất, rồi đỏ.
          fail() {
            echo ""
            echo "✗ $1"
            echo "── deploy/$DEP"
            kubectl -n "$NS" describe deploy "$DEP" 2>/dev/null | sed -n '/^Events:/,$p' || true
            pod=$(kubectl -n "$NS" get pod -l app.kubernetes.io/name=vigov-clamav \
                    --sort-by=.metadata.creationTimestamp -o name 2>/dev/null | tail -1 || true)
            if [ -n "$pod" ]; then
              echo "── $pod — sự kiện"
              kubectl -n "$NS" describe "$pod" 2>/dev/null | sed -n '/^Events:/,$p' || true
              echo "── $pod — 80 dòng log cuối"
              kubectl -n "$NS" logs "$pod" --tail=80 2>&1 || true
              echo "── $pod — lần chạy TRƯỚC (nếu đã khởi động lại)"
              kubectl -n "$NS" logs "$pod" --tail=80 --previous 2>/dev/null || echo "   (không có)"
            else
              echo "   (không thấy pod clamd nào)"
            fi
            echo ""
            echo "Gợi ý: kẹt ở 'Updating initial database' = không tới được database.clamav.net:443 (NetworkPolicy /"
            echo "tường lửa); ImagePullBackOff = thiếu/sai secret dockerhub-omicrm; OOMKilled = limit bộ nhớ quá thấp."
            exit 1
          }

          # ── 0. ĐỌC — chưa ghi gì.
          [ -r deploy/cluster/clamav.yaml ] || { echo "DỪNG: không thấy deploy/cluster/clamav.yaml trong kho — không đổi gì."; exit 1; }
          kubectl -n "$NS" get configmap common-config >/dev/null 2>&1 || {
            echo "DỪNG: không thấy configmap/common-config trong $NS — không đổi gì (job này không tạo nó)."; exit 1; }
          kubectl -n "$NS" get secret dockerhub-omicrm >/dev/null 2>&1 || \\
            echo "⚠ không đọc được secret/dockerhub-omicrm trong $NS (thiếu, hoặc job không có quyền đọc tên) — kéo ảnh Docker Hub có thể bị giới hạn."
          echo "── NetworkPolicy trong $NS (tên | loại)"
          kubectl -n "$NS" get networkpolicy \\
            -o go-template='{{range .items}}   {{.metadata.name}} |{{range .spec.policyTypes}} {{.}}{{end}}{{"\\n"}}{{end}}' > "$TMP_DIR/netpol" || true
          if [ -s "$TMP_DIR/netpol" ]; then
            cat "$TMP_DIR/netpol"
            echo "⚠ Namespace CÓ NetworkPolicy. pod clamd cần: VÀO 3310 từ petitions; RA DNS + 443 (database.clamav.net)."
            echo "  Job này KHÔNG mở — chặn thì bước đợi bên dưới đỏ và in log."
          else
            echo "   (không có cái nào — đường vào/ra không bị hạn chế)"
          fi

          # ── 1. ÁP manifest — idempotent.
          echo ""
          echo "── kubectl apply deploy/cluster/clamav.yaml → $NS"
          kubectl -n "$NS" apply -f deploy/cluster/clamav.yaml

          # ── 2. ĐỢI sẵn sàng — lần đầu là tải chữ ký, chậm.
          echo ""
          echo "── đợi deploy/$DEP sẵn sàng (tối đa 600 giây; lần đầu tải ~300 MB chữ ký)"
          kubectl -n "$NS" rollout status deploy/"$DEP" --timeout=600s || fail "deploy/$DEP chưa sẵn sàng sau 600 giây."

          # ── 3. THỬ qua Service: PING → PONG.
          IMG=$(kubectl -n "$NS" get deploy "$DEP" -o jsonpath='{.spec.template.spec.containers[0].image}')
          echo ""
          echo "── thử PING → $ADDR từ pod $POD (ảnh $IMG)"
          cat > "$TMP_DIR/pod.json" <<'JSON'
{"apiVersion":"v1","kind":"Pod",
 "metadata":{"name":"@POD@","labels":{"app.kubernetes.io/name":"vigov-clamav-ping"}},
 "spec":{"restartPolicy":"Never","automountServiceAccountToken":false,
   "imagePullSecrets":[{"name":"dockerhub-omicrm"}],
   "securityContext":{"runAsNonRoot":true,"runAsUser":100,"seccompProfile":{"type":"RuntimeDefault"}},
   "containers":[{"name":"ping","image":"@IMG@",
     "command":["sh","-c","out=$(echo PING | nc -w 10 vigov-clamav 3310); echo clamd tra loi: $out; test $out = PONG"],
     "securityContext":{"allowPrivilegeEscalation":false,"capabilities":{"drop":["ALL"]}},
     "resources":{"requests":{"cpu":"10m","memory":"16Mi"},"limits":{"memory":"64Mi"}}}]}}
JSON
          sed -i -e "s|@POD@|$POD|" -e "s|@IMG@|$IMG|" "$TMP_DIR/pod.json"
          kubectl -n "$NS" create -f "$TMP_DIR/pod.json" >/dev/null
          phase=""; i=0
          while [ $i -lt 24 ]; do   # 24 × 5 giây = 2 phút
            phase=$(kubectl -n "$NS" get pod "$POD" -o jsonpath='{.status.phase}' 2>/dev/null || true)
            case "$phase" in Succeeded|Failed) break ;; esac
            sleep 5; i=$((i+1))
          done
          kubectl -n "$NS" logs "$POD" 2>&1 | sed 's/^/   /' || true
          if [ "$phase" != "Succeeded" ]; then
            echo "── pod $POD kết thúc ở pha '$phase' — sự kiện:"
            kubectl -n "$NS" describe pod "$POD" 2>/dev/null | sed -n '/^Events:/,$p' || true
            fail "clamd KHÔNG trả PONG qua Service $ADDR — common-config KHÔNG bị đổi."
          fi
          kubectl -n "$NS" delete pod "$POD" --ignore-not-found --wait=false >/dev/null 2>&1 || true
          echo "   ✓ clamd trả PONG qua Service $ADDR"

          # ── 4. common-config: CHỈ THÊM khi chưa có key.
          echo ""
          echo "── $KEY trong configmap/common-config của $NS"
          has=$(kubectl -n "$NS" get configmap common-config \\
                  -o go-template='{{range $k, $v := .data}}{{if eq $k "MALWARE_SCANNER_ADDRESS"}}yes{{end}}{{end}}')
          if [ -n "$has" ]; then
            cur=$(kubectl -n "$NS" get configmap common-config -o go-template='{{index .data "MALWARE_SCANNER_ADDRESS"}}')
            echo "   giữ nguyên — đang là '$cur'"
            if [ "$cur" != "$ADDR" ]; then
              echo "   ⚠ KHÁC Service vừa dựng ($ADDR). Job này không đổi giá trị đặt tay; sửa tay nếu nó trỏ nhầm."
            fi
          else
            kubectl -n "$NS" patch configmap common-config --type=merge \\
              -p '{"data":{"MALWARE_SCANNER_ADDRESS":"vigov-clamav:3310"}}' >/dev/null
            cur=$(kubectl -n "$NS" get configmap common-config -o go-template='{{index .data "MALWARE_SCANNER_ADDRESS"}}')
            [ "$cur" = "$ADDR" ] || { echo "✗ đọc lại $KEY = '$cur', không phải '$ADDR' — kiểm tay."; exit 1; }
            echo "   ✓ đã đặt $KEY=$ADDR (đọc lại từ cụm khớp)"
          fi

          cat <<'EOF'

KHÔNG dịch vụ nào bị khởi động lại. petitions đọc MALWARE_SCANNER_ADDRESS ở lần khởi động kế.

⚠ TRƯỚC job service-petitions: ảnh petitions mới (config.Uses) còn đòi OBJECT_STORAGE_ENDPOINT ·
OBJECT_STORAGE_PUBLIC_ENDPOINT · OBJECT_STORAGE_BUCKET_PREFIX (common-config) và
OBJECT_STORAGE_ACCESS_KEY · OBJECT_STORAGE_SECRET_KEY (petitions-secrets) — thiếu là TỪ CHỐI KHỞI
ĐỘNG. Dạng giá trị: deploy/cau-hinh/README.md mục 1 và 2.

Trần quét của clamd: StreamMaxLength = 50M (CLAMD_CONF_StreamMaxLength, chủ dự án chốt 01/10/2026).
Tệp lớn hơn 50 MB bị TỪ CHỐI tải lên, không bao giờ coi là sạch — đầu tệp deploy/cluster/clamav.yaml.
EOF
        '''
      }
    }

    stage('Xem log') {
      when { expression { params.HANH_DONG == 'xem-log' } }
      steps {
        sh '''
          set -u
          echo "── mô tả deploy/$DICH_VU"
          kubectl -n "$NS" describe deploy/"$DICH_VU" | tail -40 || true
          # Pod tìm theo TIỀN TỐ TÊN, không theo nhãn: Deployment dựng tay trong Rancher mang nhãn
          # `workload.user.cattle.io/workloadselector`, khác nhãn của `deploy/base`.
          for p in $(kubectl -n "$NS" get pod -o name 2>/dev/null | grep "^pod/$DICH_VU-" || true); do
            echo ""
            echo "════ $p — sự kiện"
            kubectl -n "$NS" describe "$p" | sed -n '/^Events:/,$p' || true
            echo "════ $p — log (300 dòng cuối)"
            kubectl -n "$NS" logs "$p" --all-containers --tail=300 || true
            echo "════ $p — log lần chạy TRƯỚC (nếu pod đã khởi động lại)"
            kubectl -n "$NS" logs "$p" --all-containers --tail=100 --previous 2>/dev/null || echo "   (không có)"
          done
        '''
      }
    }
  }

  post {
    success {
      script {
        currentBuild.description = "${params.HANH_DONG} · ${env.NS} · bấm bởi ${env.NGUOI_BAM}" +
                                   (env.RUN_DETAIL ? " · ${env.RUN_DETAIL}" : '')
      }
    }
  }
}

// AI BẤM LƯỢT NÀY — cùng hàm với service-platform/Jenkinsfile, lý do ở đó.
String nguoiBam() {
  List nn
  try {
    nn = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')
  } catch (Throwable e) {
    echo "Không đọc được nguyên nhân lượt build (${e.getClass().getSimpleName()})."
    return ''
  }
  if (nn == null || nn.isEmpty()) { return '' }
  def id = nn[0].userId
  return id == null ? '' : id.toString().trim()
}
