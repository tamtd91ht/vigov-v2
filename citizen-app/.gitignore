# The Vite build output. The repository root ignores `/dist/` only at the root, so without
# this line the whole bundle — 226 kB of generated JavaScript — lands in a commit and every
# rebuild shows as a diff on a file nobody wrote.
dist/

# Logo xã chép vào đây cho ĐÚNG một lần đẩy `--vao-thang` rồi xoá (scripts/deploy.mjs).
public/logo-xa.png
# Banner xã, cùng cách với logo: chép cho đúng một lần đẩy `--vao-thang` rồi xoá.
public/banner-xa.png

# Tài liệu thiết kế khách gửi (ảnh chụp, PROTOTYPE.md) — tham khảo trên máy, không vào kho:
# nguồn của nó là prototype bên vigov-require, và một bản sao ở đây sẽ lệch bản gốc (luật 9).
ui-design/

# QR sinh bởi `npm run qr` (scripts/make-qr.mjs). Sinh lại được bất cứ lúc nào từ platform + identity;
# một bản trong kho là một App ID chép tay, lệch ngày platform đổi App ID.
qr/
