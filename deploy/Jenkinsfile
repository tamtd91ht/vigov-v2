// Job HẠ TẦNG `vigov-deploy` — bấm tay. Làm qua Jenkins những việc trước đây phải SSH vào máy
// chủ mới làm được: kiểm cụm, xem log, và (một lần) nhân bản staging sang prod.
//
// ─────────────────────────────────────────────────────────────────────────────────────────
// MÔ HÌNH ĐANG CHẠY THẬT — đo 25/09/2026 bằng `kiem-tra` trên vigov-staging, chủ dự án chọn
// "prod = nhân bản staging" cùng ngày:
//
//   Staging được dựng TAY trong Rancher, KHÔNG từ `deploy/base`. Tên thật trên cụm:
//     Deployment/Service  vigov-service-<dịch vụ> · vigov-web-admin
//     Secret              <dịch vụ>-secrets  (key DATABASE_DSN · GRPC_CALLER_KEY ·
//                         SESSION_SIGNING_KEYS · REDIS_DSN — trừ platform: không REDIS_DSN)
//     ConfigMap           common-config (key ENV)
//     Ingress             một cái mỗi dịch vụ, HTTP cổng 80, host thật (admin.vigov.vn …)
//
//   `deploy/base` + `overlays/` KHÔNG mô tả cụm này (tên `platform`, `<service>-secrets`, Ingress
//   `*.vigov.vn` bắt TLS). Việc `ap-manifest` đã GỠ: áp nó lên prod sẽ tạo bộ Deployment thứ
//   hai chạy song song, và giành `*.vigov.vn` với Ingress của staging.
//
// Đặt ẢNH là việc của job dịch vụ (`service-*/Jenkinsfile`). Job này không tạo Secret từ giá
// trị nào nhập vào — chỉ chép theo TÊN, dữ liệu đi qua ống, không in ra log.
// ─────────────────────────────────────────────────────────────────────────────────────────
//
// MÁY CHỦ BUILD CẦN: kubectl. Stage đầu kiểm.

// Hàm shell `chay_psql <tên pod> <tệp .sql>` dùng chung cho các việc một lần ghi vào CSDL của
// `platform`. Dán vào ĐẦU khối sh của stage: sh(CHAY_PSQL + '''...''').
def CHAY_PSQL = '''
          set -eu
          MAU='{"apiVersion":"v1","spec":{"restartPolicy":"Never",
                "imagePullSecrets":[{"name":"dockerhub-omicrm"}],
                "containers":[{"name":"psql","image":"postgres:16-alpine",
                  "envFrom":[{"secretRef":{"name":"platform-secrets"}}],
                  "env":[{"name":"SQL_B64","value":"@SQL@"}],
                  "command":["sh","-c","echo \\"$SQL_B64\\" | base64 -d | psql \\"$DATABASE_DSN\\" -X -q -v ON_ERROR_STOP=1 -f -"]}]}}'
          # Lượt #17 và #18 (26/09/2026) chết ở "timed out waiting for the condition" dù pod đã
          # Started ngay giây đầu (image có sẵn trên máy): `kubectl run -i` KHÔNG GẮN ĐƯỢC vào pod,
          # psql ngồi đợi stdin tới khi bị giết. Nên bỏ stdin/attach: câu SQL vào pod qua biến môi
          # trường (base64 — chỉ [A-Za-z0-9+/=], nhúng vào JSON an toàn; SQL này không chứa bí mật),
          # pod tự chạy tới xong, job hỏi pha bằng `get` rồi đọc `logs`. Chỉ cần quyền
          # create/get/delete pod + đọc log — không cần attach, không cần watch.
          chay_psql() {
            ten="$1"
            tep="$2"
            OVR=$(printf '%s' "$MAU" | sed "s|@SQL@|$(base64 -w0 "$tep")|")
            kubectl -n vigov-prod run "$ten" --restart=Never \
                --image=postgres:16-alpine --overrides="$OVR" --quiet
            pha=""; i=0
            while [ $i -lt 60 ]; do   # 60 × 5 giây = 5 phút
              pha=$(kubectl -n vigov-prod get pod "$ten" -o jsonpath='{.status.phase}' 2>/dev/null || true)
              case "$pha" in Succeeded|Failed) break ;; esac
              sleep 5; i=$((i+1))
            done
            kubectl -n vigov-prod logs "$ten" 2>&1 || true
            if [ "$pha" != "Succeeded" ]; then
              echo "── pod $ten kết thúc ở pha '$pha' — sự kiện của pod:"
              kubectl -n vigov-prod describe pod "$ten" 2>/dev/null | sed -n '/^Events:/,$p' || true
            fi
            kubectl -n vigov-prod delete pod "$ten" --ignore-not-found --wait=false || true
            [ "$pha" = "Succeeded" ]
          }
'''

pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 20, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '200'))   // giữ lâu hơn job build: đây là hồ sơ
    disableConcurrentBuilds()
  }

  parameters {
    // `nhan-ban-staging` (một lần) đã chạy 25/09/2026 và đã gỡ — xem lịch sử git của tệp này.
    // `tao-xa-thang-binh` là việc MỘT LẦN (chủ dự án, 26/09/2026): CHƯA GHI ĐƯỢC tới lượt #20 —
    // chạy nó TRƯỚC `doi-ten-mien-thang-binh`.
    // `doi-ten-mien-thang-binh` là việc MỘT LẦN (chủ dự án, 26/09/2026). Hai việc gỡ bằng một commit
    // khi chủ dự án xác nhận xong.
    // `gan-mini-app-thang-binh` là việc MỘT LẦN (chủ dự án, 27/09/2026) — tạm thời, tới khi
    // platform-admin có màn ghi sổ mini_app; gỡ cùng lúc ấy.
    // Năm việc đăng nhập app riêng (ADR 0066) — thứ tự ở khối chú thích trước stage
    // 'Tạo khoá mã hoá identity'. Gỡ cùng commit đưa platform-admin có màn tương ứng.
    choice(name: 'HANH_DONG', choices: ['kiem-tra', 'xem-log', 'doi-ten-mien-thang-binh', 'tao-xa-thang-binh',
                                  'gan-mini-app-thang-binh',
                                  'tao-khoa-ma-hoa-identity', 'mo-netpol-identity-zalo',
                                  'kiem-tra-dang-nhap-app-rieng', 'bat-demo-mini-app', 'tat-demo-mini-app'],
           description: 'kiem-tra: chỉ đọc · xem-log: log + sự kiện của DICH_VU · ' +
                        'tao-khoa-ma-hoa-identity: (app riêng, bước 1) sinh SECRET_ENCRYPTION_KEYS vào identity-secrets ' +
                        'của vigov-prod VÀ cùng giá trị vào vigov-staging (chung CSDL); đã có thì DỪNG, không đổi gì ' +
                        '(MT=prod; chạy TRƯỚC job service-identity) · ' +
                        'mo-netpol-identity-zalo: (bước 2) mở đường ra 443 cho pod identity nếu namespace MT có NetworkPolicy ' +
                        '(không có cái nào = không cần, không đổi gì) · ' +
                        'kiem-tra-dang-nhap-app-rieng: (bước 3, SAU job service-identity) chỉ đọc — key, ảnh, Ingress, ' +
                        'thử POST /api/v1/citizen-sessions · ' +
                        'bat-demo-mini-app / tat-demo-mini-app: (bước 4) operatorctl mini-app-demo on|off cho TENANT_ID + APP_ID ' +
                        '(MT=prod; chỉ chạy SAU khi ảnh identity có migration 0021 + /operatorctl đã triển khai) · ' +
                        'doi-ten-mien-thang-binh: đặt thangbinh-danang.vigov.vn làm tên miền chính của Xã Thăng Bình ' +
                        '+ thangbinh-danang.stg.vigov.vn (MT=prod; chạy SAU khi DNS/TLS/Ingress của hai host chạy, ' +
                        'TRƯỚC job service-platform có migration 0007) · ' +
                        'tao-xa-thang-binh: LỊCH SỬ — đã chạy 26/09/2026; chạy lại sẽ DỪNG ở phép kiểm, và sau ' +
                        'platform 0007 câu INSERT admin.* của nó bị CHECK từ chối · ' +
                        'gan-mini-app-thang-binh: ghi dòng mini_app App ID 3291993990104489440 → Xã Thăng Bình ' +
                        '(MT=prod; cần platform migration 0006)')
    choice(name: 'MT', choices: ['prod', 'staging'], description: 'Môi trường')
    choice(name: 'DICH_VU',
           choices: ['vigov-service-platform', 'vigov-service-identity', 'vigov-service-comms',
                     'vigov-service-documents', 'vigov-service-finance', 'vigov-service-petitions',
                     'vigov-service-reporting', 'vigov-web-admin'],
           description: 'Chỉ dùng cho xem-log')
    string(name: 'XAC_NHAN', defaultValue: '',
           description: 'Cho doi-ten-mien-thang-binh / tao-xa-thang-binh / gan-mini-app-thang-binh / ' +
                        'tao-khoa-ma-hoa-identity / bat-demo-mini-app / tat-demo-mini-app: gõ đúng vigov-prod. ' +
                        'Cho mo-netpol-identity-zalo: gõ đúng namespace của MT (vigov-prod hoặc vigov-staging).')
    string(name: 'TENANT_ID', defaultValue: '01M3CS7HHK72V71CGRRJHGR8E8',
           description: 'Cho bat-demo-mini-app / tat-demo-mini-app: id xã (ULID 26 ký tự). Mặc định: Xã Thăng Bình.')
    string(name: 'APP_ID', defaultValue: '3291993990104489440',
           description: 'Cho bat-demo-mini-app / tat-demo-mini-app: App ID Zalo (chỉ chữ số) đã gắn cho xã ấy ' +
                        '(gan-mini-app-thang-binh). Mặc định: app riêng của Xã Thăng Bình.')
    string(name: 'TICKET', defaultValue: '',
           description: 'Cho bat-demo-mini-app / tat-demo-mini-app: BẮT BUỘC — số phiếu yêu cầu, ghi vào vết kiểm toán ' +
                        'của xã đích (ticket:<số>). Chỉ A-Z a-z 0-9 . _ -, tối đa 64 ký tự.')
  }

  environment {
    // Kubeconfig của ViGov — KHÔNG phải `rancher-omi.yaml` nằm cạnh nó (tên chỉ khác bốn ký tự;
    // chép nhầm là thao tác vào cụm của dự án khác).
    KUBECONFIG = '/u01/rancher/rancher-vigov.yaml'
  }

  stages {

    stage('Kiểm công cụ') {
      steps {
        script {
          // LƯỢT ĐẦU SAU KHI ĐỔI `parameters {}`: Jenkins chỉ HỌC danh sách tham số ở lượt ấy, nên
          // lượt ấy chạy với mọi `params.*` là null. Dừng trước mọi lệnh kubectl.
          if (params.HANH_DONG == null || params.MT == null) {
            error('Jenkins vừa học tham số mới của job — lượt này không có tham số nào.\n' +
                  'Bấm lại bằng "Build with Parameters". Cụm không bị đụng tới.')
          }
          // Một việc đã GỠ khỏi `choices` vẫn tới được đây qua "Rebuild" một lượt cũ (đo được
          // 25/09/2026: `sao-chep-tu-staging` chạy xanh mà không stage nào khớp). Xanh-mà-không-làm-
          // gì là dạng hỏng tệ nhất: người bấm tin là đã xong.
          if (!(params.HANH_DONG in ['kiem-tra', 'xem-log', 'doi-ten-mien-thang-binh', 'tao-xa-thang-binh',
                                  'gan-mini-app-thang-binh',
                                  'tao-khoa-ma-hoa-identity', 'mo-netpol-identity-zalo',
                                  'kiem-tra-dang-nhap-app-rieng', 'bat-demo-mini-app', 'tat-demo-mini-app'])) {
            error("HANH_DONG '${params.HANH_DONG}' không còn trong job này (đã gỡ). " +
                  'Bấm "Build with Parameters" và chọn lại trong danh sách — đừng "Rebuild" một lượt cũ.')
          }
          env.HANH_DONG = params.HANH_DONG
          env.MT = params.MT
          env.DICH_VU = params.DICH_VU
          env.NS = "vigov-${params.MT}"

          env.NGUOI_BAM = nguoiBam()
          if (!env.NGUOI_BAM) {
            error('KHÔNG XÁC ĐỊNH ĐƯỢC AI BẤM LƯỢT NÀY — dừng. Lịch sử build của job này là nhật ký ' +
                  'thay đổi hạ tầng; một dòng không có tên người không trả lời được câu thanh tra sẽ hỏi.')
          }
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.HANH_DONG} · ${env.NS} · ${env.NGUOI_BAM}"
        }
        sh '''
          set -eu
          command -v kubectl >/dev/null 2>&1 || { echo "MÁY CHỦ BUILD THIẾU: kubectl"; exit 1; }
          if [ ! -r "$KUBECONFIG" ]; then
            echo "KHÔNG ĐỌC ĐƯỢC KUBECONFIG: $KUBECONFIG"; exit 1
          fi
          kubectl version --client
          echo "cụm: $(kubectl config current-context) · namespace: $NS · việc: $HANH_DONG · bấm bởi: $NGUOI_BAM"
          echo "commit của kho: $(git rev-parse --short=12 HEAD)"
        '''
      }
    }

    stage('Kiểm tra') {
      steps {
        sh '''
          set -u
          echo "── namespace"
          kubectl get ns "$NS" || echo "   (không đọc được namespace $NS)"
          echo "── Deployment + ảnh đang chạy"
          kubectl -n "$NS" get deploy -o wide || true
          echo "── Pod"
          kubectl -n "$NS" get pod -o wide || true
          echo "── Service · Ingress · ConfigMap · NetworkPolicy"
          kubectl -n "$NS" get svc,ingress,configmap,networkpolicy || true
          echo "── Secret (CHỈ TÊN và LOẠI — không in giá trị)"
          kubectl -n "$NS" get secret -o custom-columns=TEN:.metadata.name,LOAI:.type \
            --no-headers 2>/dev/null | awk '{print "   " $1 "  " $2}' || true
          # TÊN KEY, không giá trị: go-template chỉ duyệt khoá của `.data`.
          echo "── Key của từng Secret (CHỈ TÊN KEY)"
          kubectl -n "$NS" get secret -o go-template='{{range .items}}   {{.metadata.name}}:{{range $k, $v := .data}} {{$k}}{{end}}{{"\\n"}}{{end}}' 2>/dev/null || true
          echo "── Key của từng ConfigMap (CHỈ TÊN KEY)"
          kubectl -n "$NS" get configmap -o go-template='{{range .items}}   {{.metadata.name}}:{{range $k, $v := .data}} {{$k}}{{end}}{{"\\n"}}{{end}}' 2>/dev/null || true
          echo "── Deployment đọc Secret/ConfigMap nào (envFrom) và biến env đặt thẳng"
          kubectl -n "$NS" get deploy -o go-template='{{range .items}}   {{.metadata.name}}:{{range .spec.template.spec.containers}}{{range .envFrom}}{{if .secretRef}} secret/{{.secretRef.name}}{{end}}{{if .configMapRef}} configmap/{{.configMapRef.name}}{{end}}{{end}} | env:{{range .env}} {{.name}}{{end}}{{end}}{{"\\n"}}{{end}}' 2>/dev/null || true
          echo "── Sự kiện gần nhất"
          kubectl -n "$NS" get events --sort-by=.lastTimestamp 2>/dev/null | tail -25 || true
        '''
        script {
          // Secret + ConfigMap mà các Deployment dựng theo staging đọc (`envFrom`).
          env.THIEU = sh(returnStdout: true, script: '''
            set -u
            thieu=""
            for s in harbor-vigov platform-secrets identity-secrets comms-secrets documents-secrets \
                     finance-secrets petitions-secrets reporting-secrets; do
              kubectl -n "$NS" get secret "$s" >/dev/null 2>&1 || thieu="$thieu secret/$s"
            done
            kubectl -n "$NS" get configmap common-config >/dev/null 2>&1 || thieu="$thieu configmap/common-config"
            echo "$thieu"
          ''').trim()
          if (env.THIEU) {
            echo "⚠ THIẾU trong ${env.NS}: ${env.THIEU}"
          } else {
            echo "✓ đủ 8 Secret + common-config trong ${env.NS}"
          }
        }
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // CHƯA TỪNG GHI ĐƯỢC — đo lượt #20 (26/09/2026): sổ xã của vigov_platform trống, không một
    // dòng vết `tao_xa`. Lượt trước "chạy" bằng `kubectl run -i`, cách đã treo ở #17/#18, nên
    // không ghi gì. Nay chạy qua `chay_psql`. Câu SQL giữ nguyên, KHÔNG sửa: nó gắn admin.vigov.vn
    // tạm thời, và việc `doi-ten-mien-thang-binh` chạy NGAY SAU gỡ đi và đặt tên miền của xã
    // (mô hình chốt cùng ngày: admin.vigov.vn là cổng liên xã của nhà cung cấp, không phải một
    // xã). Hai dòng vết `tao_xa` + `doi_ten_mien` kể lại đủ. Chạy lại khi xã đã có thì DỪNG ở phép
    // kiểm đầu; trên CSDL đã có platform 0007 thì INSERT admin.* bị CHECK
    // `tenant_domain_khong_danh_rieng` từ chối — cả hai đều là hỏng-đóng, đúng.
    //
    // VIỆC MỘT LẦN — onboard Xã Thăng Bình (Thành phố Đà Nẵng) vào sổ xã của `platform`, gắn
    // admin.vigov.vn (chính) và admin-stg.vigov.vn. Chủ dự án chọn 26/09/2026.
    //
    // Vì sao cần: admin.vigov.vn trả 404 `tenant_not_found` — sổ xã không có dòng nào. Kho
    // không gieo xã nào (một xã thật là dữ liệu vận hành, không phải migration).
    //
    // tenant_id là ULID sinh MỘT lần lúc viết stage này (core/ulid.Moi) và cố định ở đây, để
    // chạy lại không tạo xã thứ hai (luật 1 bất biến 2: id vô nghĩa, bất biến). Tên + tỉnh viết
    // theo ADR 0017 ("Thành phố Đà Nẵng", đúng một cách viết mỗi tỉnh — ADR 0023).
    //
    // CHỈ THÊM, MỘT GIAO DỊCH, CÓ VẾT: dừng không ghi gì nếu id / tên miền / một xã trùng tên đã
    // có; ghi `audit_log` của platform cùng giao dịch (luật 6), chủ thể là người bấm job.
    //
    // CHẠY Ở ĐÂU: pod `platform` là distroless (không shell, không psql), nên job dựng một pod
    // `postgres:16-alpine` sống một lượt, đọc DATABASE_DSN từ `platform-secrets` (envFrom — DSN
    // không đi qua log hay tham số). `chay_psql` xoá pod khi xong.
    //
    // Staging và prod đang DÙNG CHUNG CSDL (Secret chép nguyên 25/09/2026), nên một lượt ghi
    // cho cả hai môi trường.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Tạo xã Thăng Bình') {
      when { expression { params.HANH_DONG == 'tao-xa-thang-binh' } }
      steps {
        script {
          if (params.MT != 'prod') { error('tao-xa-thang-binh chỉ chạy với MT=prod.') }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
          // Tên người bấm đi THẲNG vào câu SQL của dòng vết bên dưới — chỉ nhận ký tự an toàn.
          if (!(env.NGUOI_BAM ==~ /^[A-Za-z0-9._-]{1,64}$/)) {
            error("Tên người bấm '${env.NGUOI_BAM}' có ký tự không an toàn cho câu SQL — dừng.")
          }
        }
        writeFile file: 'tao-xa.sql', encoding: 'UTF-8', text: """\\set ON_ERROR_STOP on
BEGIN;
DO \$\$
BEGIN
  IF EXISTS (SELECT 1 FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8') THEN
    RAISE EXCEPTION 'DUNG: xa 01M3CS7HHK72V71CGRRJHGR8E8 da co — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant_domain WHERE host IN ('admin.vigov.vn', 'admin-stg.vigov.vn')) THEN
    RAISE EXCEPTION 'DUNG: ten mien admin.vigov.vn / admin-stg.vigov.vn da gan cho mot xa — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant WHERE lower(ten) LIKE '%thăng bình%') THEN
    RAISE EXCEPTION 'DUNG: da co mot xa ten Thang Binh — khong tao xa thu hai';
  END IF;
END \$\$;
INSERT INTO tenant (id, ten, tinh_thanh, dang_hoat_dong)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'Xã Thăng Bình', 'Thành phố Đà Nẵng', true);
INSERT INTO tenant_domain (host, tenant_id, la_chinh) VALUES
  ('admin.vigov.vn',     '01M3CS7HHK72V71CGRRJHGR8E8', true),
  ('admin-stg.vigov.vn', '01M3CS7HHK72V71CGRRJHGR8E8', false);
INSERT INTO audit_log (tenant_id, actor_id, actor_kind, action, subject, at, delta)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'van-hanh:${env.NGUOI_BAM}', 'system', 'tao_xa',
          'Xã Thăng Bình', now(),
          jsonb_build_object('ten', 'Xã Thăng Bình', 'tinh_thanh', 'Thành phố Đà Nẵng',
                             'ten_mien', jsonb_build_array('admin.vigov.vn', 'admin-stg.vigov.vn'),
                             'qua', 'jenkins vigov-deploy #${env.BUILD_NUMBER}'));
COMMIT;
SELECT t.id, t.ten, t.tinh_thanh, t.dang_hoat_dong, d.host, d.la_chinh
  FROM tenant t JOIN tenant_domain d ON d.tenant_id = t.id
 WHERE t.id = '01M3CS7HHK72V71CGRRJHGR8E8';
"""
        sh(CHAY_PSQL + '''
          echo "── các xã đang có trong sổ (trước khi ghi)"
          echo "SELECT id, ten, tinh_thanh, dang_hoat_dong FROM tenant ORDER BY tao_luc; SELECT host, tenant_id, la_chinh FROM tenant_domain ORDER BY host;" > doc-xa.sql
          chay_psql "vigov-psql-doc-$BUILD_NUMBER" doc-xa.sql
          echo "── ghi"
          chay_psql "vigov-psql-ghi-$BUILD_NUMBER" tao-xa.sql
          echo ""
          echo "Xong. Bước kế: chạy lại job này với HANH_DONG=doi-ten-mien-thang-binh."
        ''')
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // VIỆC MỘT LẦN — trỏ Xã Thăng Bình (01M3CS7HHK72V71CGRRJHGR8E8) sang tên miền của mô hình
    // chủ dự án chốt 26/09/2026: `<xã>.vigov.vn` (prod) · `<xã>.stg.vigov.vn` (staging). Mô hình
    // + nhãn dành riêng: ADR 0046; việc của người vận hành: deploy/cau-hinh/README.md mục 5.
    //
    // THỨ TỰ BẮT BUỘC — sai thứ tự là xã mất đăng nhập hoặc việc này không chạy được:
    //   1. DNS + TLS + Ingress cho thangbinh-danang.vigov.vn và thangbinh-danang.stg.vigov.vn chạy
    //      thật (cụm dựng tay trong Rancher — `deploy/base` KHÔNG được áp, nên đây là việc tay).
    //      Đổi tên miền chính trước khi host mới tới được pod là mọi đường dẫn dựng từ tên miền
    //      chính (thông báo, liên kết) trỏ vào một địa chỉ chưa ai trả lời.
    //   2. VIỆC NÀY — chạy được cả TRƯỚC lẫn SAU platform 0007: nó chỉ DELETE và INSERT, không
    //      UPDATE dòng admin.*, nên CHECK `tenant_domain_khong_danh_rieng` không có gì để từ chối.
    //      Thực tế 26/09/2026: 0007 áp lúc 07:50Z, TRƯỚC việc này (lượt #21 đo) — bản cũ có câu
    //      UPDATE la_chinh và dừng ở phép kiểm 0007; chủ dự án chọn "xoá trước, chèn sau".
    //
    // GỠ hai dòng admin.vigov.vn / admin-stg.vigov.vn — chủ dự án quyết 26/09/2026 ("xóa đi, nó
    // là dùng cho pod web admin tổng quản lý multi domain"). Đó là dòng định tuyến, không phải hồ
    // sơ nghiệp vụ; trạng thái trước khi gỡ nằm trong delta `truoc` của dòng vết `doi_ten_mien`.
    // Gỡ xong thì 0007 VALIDATE CONSTRAINT được — nhưng việc ấy để một migration sau quyết.
    //
    // GỠ HAI DÒNG + THÊM HAI DÒNG, MỘT GIAO DỊCH, CÓ VẾT: mọi phép kiểm RAISE và không ghi gì; dòng
    // `audit_log` cùng giao dịch, chủ thể là người bấm job (luật 6). Cách chạy psql và CSDL dùng
    // chung hai môi trường: như việc `tao-xa-thang-binh` ở trên.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Đổi tên miền Thăng Bình') {
      when { expression { params.HANH_DONG == 'doi-ten-mien-thang-binh' } }
      steps {
        script {
          if (params.MT != 'prod') { error('doi-ten-mien-thang-binh chỉ chạy với MT=prod.') }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
          // Tên người bấm đi THẲNG vào câu SQL của dòng vết bên dưới — chỉ nhận ký tự an toàn.
          if (!(env.NGUOI_BAM ==~ /^[A-Za-z0-9._-]{1,64}$/)) {
            error("Tên người bấm '${env.NGUOI_BAM}' có ký tự không an toàn cho câu SQL — dừng.")
          }
        }
        writeFile file: 'doi-ten-mien.sql', encoding: 'UTF-8', text: """\\set ON_ERROR_STOP on
BEGIN;
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8') THEN
    RAISE EXCEPTION 'DUNG: xa 01M3CS7HHK72V71CGRRJHGR8E8 chua co trong so xa — khong ghi gi';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8' AND dang_hoat_dong) THEN
    RAISE EXCEPTION 'DUNG: xa 01M3CS7HHK72V71CGRRJHGR8E8 khong con hoat dong — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant_domain
              WHERE host IN ('thangbinh-danang.vigov.vn', 'thangbinh-danang.stg.vigov.vn')
                AND tenant_id <> '01M3CS7HHK72V71CGRRJHGR8E8') THEN
    RAISE EXCEPTION 'DUNG: thangbinh-danang.vigov.vn / .stg.vigov.vn da gan cho MOT XA KHAC — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant_domain
              WHERE host = 'thangbinh-danang.vigov.vn' AND tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8' AND la_chinh) THEN
    RAISE EXCEPTION 'DUNG: thangbinh-danang.vigov.vn da la ten mien chinh — viec nay da chay, khong ghi gi';
  END IF;
END \$\$;
INSERT INTO audit_log (tenant_id, actor_id, actor_kind, action, subject, at, delta)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'van-hanh:${env.NGUOI_BAM}', 'system', 'doi_ten_mien',
          'Xã Thăng Bình', now(),
          jsonb_build_object(
            'truoc', (SELECT jsonb_agg(jsonb_build_object('host', host, 'la_chinh', la_chinh) ORDER BY host)
                        FROM tenant_domain WHERE tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8'),
            'chinh_moi', 'thangbinh-danang.vigov.vn',
            'them', jsonb_build_array('thangbinh-danang.vigov.vn', 'thangbinh-danang.stg.vigov.vn'),
            'go', jsonb_build_array('admin.vigov.vn', 'admin-stg.vigov.vn'),
            'qua', 'jenkins vigov-deploy #${env.BUILD_NUMBER}'));
-- Gỡ hai tên miền cũ: chủ dự án quyết 26/09/2026 — admin.vigov.vn là tên miền của pod web quản
-- trị tổng liên xã (chưa dựng), không phải của một xã. Đây là dòng ĐỊNH TUYẾN của sổ xã, không
-- phải hồ sơ nghiệp vụ; dòng vết `doi_ten_mien` ở trên giữ nguyên trạng thái trước (`truoc`).
-- Lọc đúng hai host VÀ đúng xã này — không bao giờ gỡ tên miền của xã khác.
--
-- XOÁ TRƯỚC, CHÈN SAU — không UPDATE (chủ dự án chọn 26/09/2026, sau lượt #21). Platform 0007 đã
-- áp, và CHECK NOT VALID của nó kiểm MỌI phiên bản dòng mới: hạ cờ la_chinh của admin.vigov.vn
-- bị từ chối (23514). DELETE không tạo phiên bản dòng mới nên CHECK không chạm; xoá xong thì xã
-- không còn dòng chính nào, và chỉ mục `tenant_domain_mot_chinh` nhận dòng chính mới.
DELETE FROM tenant_domain
 WHERE tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8'
   AND host IN ('admin.vigov.vn', 'admin-stg.vigov.vn');
INSERT INTO tenant_domain (host, tenant_id, la_chinh) VALUES
  ('thangbinh-danang.vigov.vn',     '01M3CS7HHK72V71CGRRJHGR8E8', true),
  ('thangbinh-danang.stg.vigov.vn', '01M3CS7HHK72V71CGRRJHGR8E8', false)
  ON CONFLICT (host) DO NOTHING;
DO \$\$
BEGIN
  IF (SELECT count(*) FROM tenant_domain
       WHERE host IN ('thangbinh-danang.vigov.vn', 'thangbinh-danang.stg.vigov.vn')
         AND tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8') <> 2 THEN
    RAISE EXCEPTION 'DUNG: sau khi ghi, hai ten mien moi khong cung thuoc xa 01M3CS7HHK72V71CGRRJHGR8E8 — quay lui, khong ghi gi';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM tenant_domain
                  WHERE host = 'thangbinh-danang.vigov.vn' AND tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8' AND la_chinh) THEN
    RAISE EXCEPTION 'DUNG: thangbinh-danang.vigov.vn khong thanh ten mien chinh (dong co san voi la_chinh=false?) — quay lui, khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant_domain WHERE host IN ('admin.vigov.vn', 'admin-stg.vigov.vn')) THEN
    RAISE EXCEPTION 'DUNG: admin.vigov.vn / admin-stg.vigov.vn van con (gan cho xa khac?) — quay lui, khong ghi gi';
  END IF;
END \$\$;
COMMIT;
SELECT t.id, t.ten, t.dang_hoat_dong, d.host, d.la_chinh
  FROM tenant t JOIN tenant_domain d ON d.tenant_id = t.id
 WHERE t.id = '01M3CS7HHK72V71CGRRJHGR8E8'
 ORDER BY d.host;
"""
        sh(CHAY_PSQL + '''
          echo "── tên miền của xã và hai host mới (trước khi ghi)"
          # Lượt #19: phép kiểm báo xã chưa có trong sổ dù `tao-xa-thang-binh` được ghi là đã chạy.
          # Đọc TOÀN BỘ sổ xã + CSDL đang nói chuyện + vết tao_xa, để biết xã thiếu thật hay DSN
          # trỏ nhầm CSDL — trước khi ai tạo lại một xã có thể đã tồn tại ở nơi khác.
          cat > doc-ten-mien.sql <<'SQL'
SELECT current_database() AS csdl, inet_server_addr() AS may_chu, current_user AS vai;
SELECT id, ten, tinh_thanh, dang_hoat_dong FROM tenant ORDER BY tao_luc;
SELECT host, tenant_id, la_chinh FROM tenant_domain ORDER BY host;
SELECT tenant_id, actor_id, action, subject, at FROM audit_log WHERE action IN ('tao_xa', 'doi_ten_mien') ORDER BY at;
SQL
          chay_psql "vigov-psql-doc-$BUILD_NUMBER" doc-ten-mien.sql
          echo "── ghi"
          chay_psql "vigov-psql-ghi-$BUILD_NUMBER" doi-ten-mien.sql
          echo ""
          echo "Xong. Thử: https://thangbinh-danang.vigov.vn/dang-nhap · https://thangbinh-danang.stg.vigov.vn/dang-nhap"
          echo "Bước kế: job service-platform (migration 0007)."
        ''')
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // VIỆC MỘT LẦN — ghi sổ `mini_app`: App ID 3291993990104489440 là app RIÊNG của Xã Thăng Bình
    // (01M3CS7HHK72V71CGRRJHGR8E8). Chủ dự án giao App ID và chọn đường này 27/09/2026: đẩy app lên
    // trước, màn ghi sổ ở platform-admin làm sau — gỡ stage này cùng commit thêm màn ấy.
    //
    // Vì sao cần: `ResolveMiniApp` là nơi DUY NHẤT máy chủ biết một App ID phục vụ xã nào (ADR
    // 0044, 0045). Không có dòng → từ chối, nên app đẩy lên được mà không mở được. Migration 0006
    // cố ý không gieo dòng nào (một App ID thật là dữ liệu vận hành, không phải migration).
    // `citizen-app/scripts/ung-dung-theo-ten-mien.mjs` giữ CÙNG cặp cho bước đẩy — hai nơi, chưa
    // có phép đối chiếu (ADR 0047 CÒN MỞ #3); sửa một thì sửa cả hai.
    //
    // CHỈ THÊM, MỘT GIAO DỊCH, CÓ VẾT, như `tao-xa-thang-binh`: mọi phép kiểm RAISE và không ghi
    // gì — xã thiếu hoặc ngừng hoạt động, App ID đã có dòng (kể cả dòng đã xoá mềm: khoá chính
    // giữ nó, một App ID không bao giờ bị gắn lại lặng lẽ). Dòng `audit_log` cùng giao dịch, chủ
    // thể là người bấm job (luật 6). Bảng chưa có (0006 chưa áp) thì psql lỗi và không ghi gì.
    // Cách chạy psql và CSDL dùng chung hai môi trường: như `tao-xa-thang-binh`.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Gắn Mini App Thăng Bình') {
      when { expression { params.HANH_DONG == 'gan-mini-app-thang-binh' } }
      steps {
        script {
          if (params.MT != 'prod') { error('gan-mini-app-thang-binh chỉ chạy với MT=prod.') }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
          // Tên người bấm đi THẲNG vào câu SQL bên dưới — chỉ nhận ký tự an toàn.
          if (!(env.NGUOI_BAM ==~ /^[A-Za-z0-9._-]{1,64}$/)) {
            error("Tên người bấm '${env.NGUOI_BAM}' có ký tự không an toàn cho câu SQL — dừng.")
          }
        }
        writeFile file: 'gan-mini-app.sql', encoding: 'UTF-8', text: """\\set ON_ERROR_STOP on
BEGIN;
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8' AND dang_hoat_dong) THEN
    RAISE EXCEPTION 'DUNG: xa 01M3CS7HHK72V71CGRRJHGR8E8 chua co hoac khong con hoat dong — khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM mini_app WHERE app_id = '3291993990104489440') THEN
    RAISE EXCEPTION 'DUNG: App ID 3291993990104489440 da co dong trong mini_app (xem bang doc o tren) — khong ghi gi';
  END IF;
END \$\$;
INSERT INTO mini_app (app_id, che_do, tenant_id, ghi_chu, tao_boi, cap_nhat_boi)
  VALUES ('3291993990104489440', 'rieng', '01M3CS7HHK72V71CGRRJHGR8E8',
          'App riêng Xã Thăng Bình — App ID chủ dự án giao 27/09/2026 (jenkins vigov-deploy #${env.BUILD_NUMBER})',
          'van-hanh:${env.NGUOI_BAM}', 'van-hanh:${env.NGUOI_BAM}');
INSERT INTO audit_log (tenant_id, actor_id, actor_kind, action, subject, at, delta)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'van-hanh:${env.NGUOI_BAM}', 'system', 'gan_mini_app',
          'MiniApp 3291993990104489440', now(),
          jsonb_build_object('app_id', '3291993990104489440', 'che_do', 'rieng',
                             'xa', 'Xã Thăng Bình',
                             'qua', 'jenkins vigov-deploy #${env.BUILD_NUMBER}'));
COMMIT;
SELECT m.app_id, m.che_do, m.tenant_id, t.ten, m.dang_hoat_dong, m.tao_boi, m.tao_luc
  FROM mini_app m JOIN tenant t ON t.id = m.tenant_id
 WHERE m.app_id = '3291993990104489440';
"""
        sh(CHAY_PSQL + '''
          echo "── CSDL, xã, và sổ mini_app (trước khi ghi)"
          cat > doc-mini-app.sql <<'SQL'
SELECT current_database() AS csdl, current_user AS vai;
SELECT id, ten, dang_hoat_dong FROM tenant WHERE id = '01M3CS7HHK72V71CGRRJHGR8E8';
SELECT to_regclass('mini_app') AS bang_mini_app;
SQL
          chay_psql "vigov-psql-doc-$BUILD_NUMBER" doc-mini-app.sql
          echo "SELECT app_id, che_do, tenant_id, dang_hoat_dong, deleted_at FROM mini_app ORDER BY tao_luc;" > doc-mini-app-2.sql
          chay_psql "vigov-psql-doc2-$BUILD_NUMBER" doc-mini-app-2.sql || echo "   (không đọc được mini_app — migration 0006 chưa áp?)"
          echo "── ghi"
          chay_psql "vigov-psql-ghi-$BUILD_NUMBER" gan-mini-app.sql
          echo ""
          echo "Xong. Bước kế: cd citizen-app && npm run zmp:phat-hanh -- --domain=thangbinh-danang.vigov.vn --vao-thang"
        ''')
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // ĐĂNG NHẬP APP RIÊNG CỦA XÃ (ADR 0066) — đưa lên cụm thật. THỨ TỰ BẮT BUỘC:
    //
    //   1. tao-khoa-ma-hoa-identity      (MT=prod)   SECRET_ENCRYPTION_KEYS vào identity-secrets
    //                                                 của vigov-prod + vigov-staging, cùng giá trị.
    //                                                 Thiếu nó thì ảnh identity mới TỪ CHỐI khởi động.
    //   2. mo-netpol-identity-zalo       (MT=prod, rồi MT=staging)   đường ra 443 tới Zalo, nếu cần.
    //   3. job `service-identity` (service-identity/Jenkinsfile) — ảnh có migration 0021 +
    //      /operatorctl, và khởi động lại pod để đọc khoá ở bước 1. KHÔNG làm lại ở đây.
    //      rồi kiem-tra-dang-nhap-app-rieng (chỉ đọc) — tuyến mới có sống chưa.
    //   4. bat-demo-mini-app             (MT=prod)   bật danh tính demo cho App ID của xã.
    //   rồi: cd citizen-app && npm run zmp:deploy -- --domain=thangbinh-danang.vigov.vn --vao-thang --demo
    //   Trước khi Zalo duyệt app: tat-demo-mini-app (MT=prod).
    //
    // Cùng bản ở trang của người vận hành: deploy/cau-hinh/README.md mục 6. Sửa một thì sửa cả hai.
    // Gỡ năm việc này cùng commit đưa platform-admin có màn tương ứng.
    // ─────────────────────────────────────────────────────────────────────────────────────

    // ─────────────────────────────────────────────────────────────────────────────────────
    // BƯỚC 1 — SECRET_ENCRYPTION_KEYS của identity (ADR 0009, 0066). Một khoá: 32 byte từ
    // /dev/urandom (CSPRNG của nhân), base64 chuẩn — đúng dạng core/config/secret_encryption.go
    // đòi (danh sách `<mới>,<cũ>`, một phần tử là đủ).
    //
    // KHÔNG BAO GIỜ GHI ĐÈ: prod đã có key → DỪNG, prod không bị đụng. Ghi đè là mọi khoá dữ liệu
    // đã niêm bằng khoá cũ — và mọi secret Zalo của mọi xã — không mở lại được nữa.
    //
    // CÙNG MỘT GIÁ TRỊ Ở STAGING: hai môi trường dùng CHUNG CSDL (xem trên), nên khoá dữ liệu
    // staging niêm thì prod phải mở được và ngược lại. Staging có một giá trị KHÁC → DỪNG, báo.
    // Prod có mà staging thiếu (lượt trước ghi được prod, hỏng ở staging) → chỉ CHÉP prod sang
    // staging — không ghi đè gì, prod không bị đụng.
    //
    // GIÁ TRỊ KHÔNG BAO GIỜ VÀO LOG HAY DÒNG LỆNH: sinh thẳng vào tệp trong thư mục tạm (umask
    // 077, xoá khi thoát), bản vá đi qua `--patch-file` (không qua `-p`, vì argv hiện trong `ps`),
    // staging chép THEO TÊN từ prod qua tệp, so khớp bằng `cmp -s`. Không `set -x`.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Tạo khoá mã hoá identity') {
      when { expression { params.HANH_DONG == 'tao-khoa-ma-hoa-identity' } }
      steps {
        script {
          if (params.MT != 'prod') { error('tao-khoa-ma-hoa-identity chỉ chạy với MT=prod (nó ghi cả prod lẫn staging).') }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
        }
        sh '''
          set -eu
          umask 077
          TMP_DIR=$(mktemp -d)
          trap 'rm -f "$TMP_DIR"/*; rmdir "$TMP_DIR"' EXIT
          kubectl patch --help 2>/dev/null | grep -q -- '--patch-file' || {
            echo "DỪNG: kubectl của máy chủ build không có 'patch --patch-file' — giá trị sẽ phải đi qua dòng lệnh. Không đổi gì."
            exit 1; }
          for ns in vigov-prod vigov-staging; do
            kubectl -n "$ns" get secret identity-secrets >/dev/null 2>&1 || {
              echo "DỪNG: không thấy secret/identity-secrets trong $ns — không đổi gì."; exit 1; }
          done
          # CHỈ TÊN KEY: duyệt khoá của .data, không chạm giá trị.
          has_key() {
            kubectl -n "$1" get secret identity-secrets \
              -o go-template='{{range $k, $v := .data}}{{if eq $k "SECRET_ENCRYPTION_KEYS"}}yes{{end}}{{end}}'
          }
          # Giá trị (dạng base64 của .data) đi THẲNG vào tệp — không bao giờ ra stdout của job.
          read_key() {
            kubectl -n "$1" get secret identity-secrets \
              -o go-template='{{index .data "SECRET_ENCRYPTION_KEYS"}}' > "$2"
          }
          # Bản vá merge chỉ MỘT key; tệp vào là dạng base64 của .data.
          write_patch() {
            { printf '{"data":{"SECRET_ENCRYPTION_KEYS":"'; tr -d '\\n' < "$1"; printf '"}}'; } > "$2"
          }
          copy_prod_to_staging() {
            read_key vigov-prod "$TMP_DIR/prod"
            write_patch "$TMP_DIR/prod" "$TMP_DIR/patch-staging.json"
            kubectl -n vigov-staging patch secret identity-secrets --type=merge \
                --patch-file "$TMP_DIR/patch-staging.json" >/dev/null || {
              echo "⚠ prod ĐÃ CÓ khoá, staging CHƯA ghi được — chạy lại việc này (nó chỉ chép prod sang staging)."
              exit 1; }
            read_key vigov-staging "$TMP_DIR/staging"
            cmp -s "$TMP_DIR/prod" "$TMP_DIR/staging" || {
              echo "⚠ sau khi ghi, giá trị ở vigov-staging KHÁC vigov-prod — dừng, kiểm tay (không in giá trị)."; exit 1; }
            echo "✓ vigov-staging: identity-secrets có SECRET_ENCRYPTION_KEYS, CÙNG giá trị với prod (so bằng cmp, không in)"
          }
          # Cách sao lưu — LỆNH, không giá trị.
          print_next_steps() {
            cat <<'EOF'

SAO LƯU NGAY — TRƯỚC KHI LƯU SECRET ZALO ĐẦU TIÊN. Mất khoá này là mất mọi secret đã niêm (ADR 0009).
Từ một máy tin cậy có kubeconfig ViGov (KHÔNG phải máy chủ build), không in ra màn hình:

  kubectl -n vigov-prod get secret identity-secrets \\
    -o go-template='{{index .data "SECRET_ENCRYPTION_KEYS"}}' | base64 -d > <tệp trong kho bí mật>

Cất TÁCH khỏi bản sao lưu CSDL identity: một bản sao lưu chứa cả hai là bản chứa bản rõ.

identity đọc biến lúc KHỞI ĐỘNG: pod đang chạy chưa thấy khoá này. Bước kế:
  2. job này, HANH_DONG=mo-netpol-identity-zalo (MT=prod, rồi MT=staging)
  3. job service-identity — triển khai ảnh mới và khởi động lại pod
EOF
          }

          in_prod=$(has_key vigov-prod)
          in_staging=$(has_key vigov-staging)

          if [ -n "$in_prod" ]; then
            echo "identity-secrets của vigov-prod ĐÃ CÓ SECRET_ENCRYPTION_KEYS — prod KHÔNG bị đổi."
            echo "(Ghi đè là mọi secret đã niêm bằng khoá ấy không mở lại được nữa.)"
            if [ -z "$in_staging" ]; then
              echo "vigov-staging còn THIẾU — chép giá trị của prod sang (không ghi đè gì):"
              copy_prod_to_staging
              print_next_steps
              exit 0
            fi
            read_key vigov-prod "$TMP_DIR/prod"
            read_key vigov-staging "$TMP_DIR/staging"
            if cmp -s "$TMP_DIR/prod" "$TMP_DIR/staging"; then
              echo "✓ vigov-staging cũng có, CÙNG giá trị — bước 1 đã xong ở cả hai. Không đổi gì."
              exit 0
            fi
            echo "DỪNG: vigov-staging có SECRET_ENCRYPTION_KEYS KHÁC prod. Hai môi trường dùng CHUNG CSDL, nên"
            echo "khoá dữ liệu một bên niêm thì bên kia không mở được. Không đổi gì — người vận hành phải xác định"
            echo "bên nào đã niêm secret (bảng data_encryption_key của identity) trước khi chọn giữ giá trị nào."
            exit 1
          fi

          if [ -n "$in_staging" ]; then
            echo "DỪNG: vigov-prod CHƯA có SECRET_ENCRYPTION_KEYS nhưng vigov-staging ĐÃ CÓ — mọi khoá sinh mới đều"
            echo "KHÁC giá trị ấy, mà hai môi trường dùng CHUNG CSDL. Không đổi gì. Nếu staging đã niêm secret bằng"
            echo "khoá của nó thì prod phải dùng ĐÚNG giá trị ấy — chép tay theo tên, qua ống, không in ra."
            exit 1
          fi

          head -c 32 /dev/urandom | base64 -w0 > "$TMP_DIR/key"
          [ "$(base64 -d < "$TMP_DIR/key" | wc -c)" -eq 32 ] || {
            echo "DỪNG: khoá sinh ra không đủ 32 byte — không đổi gì."; exit 1; }
          # .data là base64 của GIÁ TRỊ, mà giá trị lại là base64 của khoá — nên mã hoá thêm một lần.
          base64 -w0 < "$TMP_DIR/key" > "$TMP_DIR/key.data"
          write_patch "$TMP_DIR/key.data" "$TMP_DIR/patch-prod.json"
          kubectl -n vigov-prod patch secret identity-secrets --type=merge \
              --patch-file "$TMP_DIR/patch-prod.json" >/dev/null
          read_key vigov-prod "$TMP_DIR/prod"
          cmp -s "$TMP_DIR/key.data" "$TMP_DIR/prod" || {
            echo "⚠ đọc lại từ cụm, giá trị ở vigov-prod không khớp giá trị vừa sinh — dừng, kiểm tay."; exit 1; }
          echo "✓ vigov-prod: đã thêm SECRET_ENCRYPTION_KEYS vào identity-secrets (một khoá, 32 byte; giá trị không in)"
          copy_prod_to_staging
          print_next_steps
        '''
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // BƯỚC 2 — đường ra 443 của RIÊNG identity tới Zalo Graph API: bản cho cụm dựng tay của
    // quy tắc 10 trong deploy/base/mang/netpol.yaml (`allow-identity-egress-zalo`). Thiếu nó trên
    // một namespace có hạn chế đường ra thì pod xanh mà mọi lượt đăng nhập thật của app riêng trả
    // 502; `--demo` vẫn chạy vì không gọi Zalo — đúng kiểu hỏng trông như chạy được.
    //
    // CHỈ ÁP KHI ĐƯỜNG RA CỦA IDENTITY ĐÃ BỊ HẠN CHẾ. Một NetworkPolicy loại Egress chọn một pod là
    // biến pod ấy thành "chặn mọi đường ra trừ đường được mở" — áp quy tắc này lên một identity
    // CHƯA bị hạn chế sẽ CHẶN DNS, CSDL, platform, Redis của nó. Nên: không có NetworkPolicy, hoặc
    // không cái Egress nào chọn pod identity → đường ra đang mở, không làm gì. Một cái có
    // matchExpressions (không tự đối chiếu được) → DỪNG, người xem tay.
    //
    // Pod chọn theo `spec.selector.matchLabels` THẬT của Deployment dựng tay (nhãn workloadselector
    // của Rancher), không theo nhãn `deploy/base`. `kubectl apply` — chạy lại không sinh bản thứ hai.
    //
    // ⚠ 443 mở tới `0.0.0.0/0` vì Zalo không công bố dải địa chỉ; CHỈ pod identity, CHỈ cổng 443 — cùng
    // loại nợ với quy tắc 4 và 9 (`_chung/netpol-duong-ra-tam-mo`). Một pod identity bị chiếm quyền gửi
    // được tới bất kỳ máy nào mở 443, thay vì chỉ tới Zalo. Thay bằng egress gateway / FQDN policy khi cụm có.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Mở đường ra Zalo cho identity') {
      when { expression { params.HANH_DONG == 'mo-netpol-identity-zalo' } }
      steps {
        script {
          if (params.XAC_NHAN != env.NS) {
            error("XAC_NHAN phải là đúng '${env.NS}' (namespace của MT). Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
        }
        sh '''
          set -eu
          TMP_DIR=$(mktemp -d)
          trap 'rm -f "$TMP_DIR"/*; rmdir "$TMP_DIR"' EXIT
          POLICY=allow-identity-egress-zalo
          DEP=vigov-service-identity

          kubectl -n "$NS" get deploy "$DEP" >/dev/null 2>&1 || {
            echo "DỪNG: không thấy deploy/$DEP trong $NS — không đổi gì."; exit 1; }
          if [ -n "$(kubectl -n "$NS" get deploy "$DEP" -o go-template='{{if .spec.selector.matchExpressions}}yes{{end}}')" ]; then
            echo "DỪNG: selector của $DEP có matchExpressions — không tự dựng podSelector được. Không đổi gì."; exit 1
          fi
          kubectl -n "$NS" get deploy "$DEP" \
            -o go-template='{{range $k, $v := .spec.selector.matchLabels}}{{$k}}={{$v}}{{"\\n"}}{{end}}' > "$TMP_DIR/selector"
          kubectl -n "$NS" get deploy "$DEP" \
            -o go-template='{{range $k, $v := .spec.template.metadata.labels}}{{$k}}={{$v}}{{"\\n"}}{{end}}' > "$TMP_DIR/pod-labels"
          [ -s "$TMP_DIR/selector" ] || { echo "DỪNG: $DEP không có spec.selector.matchLabels — không đổi gì."; exit 1; }
          echo "── pod identity chọn theo selector THẬT của deploy/$DEP:"
          sed 's/^/   /' "$TMP_DIR/selector"

          # `get` hỏng (thiếu quyền) phải DỪNG ở đây — không được đọc thành "không có cái nào".
          kubectl -n "$NS" get networkpolicy \
            -o go-template='{{range .items}}{{.metadata.name}}|{{range .spec.policyTypes}}{{.}} {{end}}|{{range $k, $v := .spec.podSelector.matchLabels}}{{$k}}={{$v}},{{end}}|{{if .spec.podSelector.matchExpressions}}expr{{end}}{{"\\n"}}{{end}}' \
            > "$TMP_DIR/policies"
          echo "── NetworkPolicy đang có trong $NS (tên | loại | podSelector)"
          if [ ! -s "$TMP_DIR/policies" ]; then
            echo "   (không có cái nào)"
            echo "Đường ra của mọi pod trong $NS KHÔNG bị hạn chế — identity tới được Zalo. Không cần, không đổi gì."
            exit 0
          fi
          sed 's/^/   /' "$TMP_DIR/policies"

          restricted=""; unknown=""; ours=""
          while IFS='|' read -r name types labels expr; do
            [ -n "$name" ] || continue
            if [ "$name" = "$POLICY" ]; then ours=yes; continue; fi
            case " $types " in *" Egress "*) ;; *) continue ;; esac
            if [ -n "$expr" ]; then unknown="$unknown $name"; continue; fi
            hit=yes
            for pair in $(printf '%s' "$labels" | tr ',' ' '); do
              grep -qxF "$pair" "$TMP_DIR/pod-labels" || { hit=""; break; }
            done
            [ -z "$hit" ] || restricted="$restricted $name"
          done < "$TMP_DIR/policies"

          if [ -n "$unknown" ]; then
            echo "DỪNG: NetworkPolicy loại Egress dùng matchExpressions:$unknown — không tự đối chiếu được với pod identity."
            echo "Xem tay; không đổi gì."
            exit 1
          fi
          if [ -z "$restricted" ]; then
            if [ -n "$ours" ]; then
              echo "⚠ $POLICY ĐÃ CÓ và là cái DUY NHẤT hạn chế đường ra của identity — nó đang CHẶN mọi đường ra"
              echo "khác 443 (DNS, CSDL, platform, Redis). Không đổi gì; người vận hành gỡ tay sau khi xác nhận."
              exit 1
            fi
            echo "Không NetworkPolicy loại Egress nào chọn pod identity — đường ra của nó KHÔNG bị hạn chế, tới được Zalo."
            echo "Không cần; không đổi gì. (Áp quy tắc này lúc này sẽ CHẶN mọi đường ra khác của identity.)"
            exit 0
          fi
          echo "Đường ra của identity ĐANG bị hạn chế bởi:$restricted — áp $POLICY (mở thêm TCP 443)."

          {
cat <<'YAML'
# 10. Đường RA của RIÊNG identity: 443 tới Zalo (ADR 0066) — bản cụm dựng tay, áp bởi vigov-deploy.
# ⚠ NỢ: 443 mở tới 0.0.0.0/0 vì Zalo không công bố dải địa chỉ; CHỈ pod identity, CHỈ cổng 443.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-identity-egress-zalo
  annotations:
    vigov.vn/open-debt: "443 to 0.0.0.0/0: Zalo publishes no address range. Replace with an egress gateway / FQDN policy (deploy/base/mang/netpol.yaml rule 10)."
spec:
  podSelector:
    matchLabels:
YAML
            while IFS='=' read -r k v; do
              printf '      "%s": "%s"\\n' "$k" "$v"
            done < "$TMP_DIR/selector"
cat <<'YAML'
  policyTypes: [Egress]
  egress:
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0       # ← NỢ: Zalo không công bố dải; giữ giới hạn cổng 443
      ports:
        - { port: 443, protocol: TCP }
YAML
          } > "$TMP_DIR/policy.yaml"
          kubectl -n "$NS" apply -f "$TMP_DIR/policy.yaml"
          echo "── $POLICY sau khi áp"
          kubectl -n "$NS" get networkpolicy "$POLICY" -o wide
          echo ""
          echo "DNS: identity đã gọi platform/CSDL theo tên, nên chính sách đang có phải đã mở DNS cho nó — tên"
          echo "graph.zalo.me đi cùng đường ấy. Bước kế: job service-identity, rồi HANH_DONG=kiem-tra-dang-nhap-app-rieng."
        '''
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // SAU BƯỚC 3 (job service-identity) — CHỈ ĐỌC. Tuyến mới có sống thật chưa: key có trong
    // Secret (chỉ TÊN), ảnh đang chạy, Ingress của host API identity trỏ về Service nào, và một
    // `POST /api/v1/citizen-sessions` thân `{}` — mong 400 `invalid_body` (tuyến mới trả lời);
    // 404 = ảnh cũ hoặc Ingress sai. Lượt thử tính vào giới hạn 10 lần / 5 phút / IP của tuyến ấy.
    // Hỏng một phép kiểm → lượt ĐỎ, sau khi đã in đủ: xanh-mà-chưa-chạy là dạng hỏng tệ nhất.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Kiểm đăng nhập app riêng') {
      when { expression { params.HANH_DONG == 'kiem-tra-dang-nhap-app-rieng' } }
      steps {
        script {
          env.API_HOST = (params.MT == 'prod') ? 'identity.api.vigov.vn' : 'identity.api-stg.vigov.vn'
        }
        sh '''
          set -u
          TMP_DIR=$(mktemp -d)
          trap 'rm -f "$TMP_DIR"/*; rmdir "$TMP_DIR"' EXIT
          DEP=vigov-service-identity
          failed=""

          echo "── identity-secrets: có key SECRET_ENCRYPTION_KEYS? (CHỈ TÊN KEY)"
          has=$(kubectl -n "$NS" get secret identity-secrets \
                  -o go-template='{{range $k, $v := .data}}{{if eq $k "SECRET_ENCRYPTION_KEYS"}}yes{{end}}{{end}}' 2>/dev/null || true)
          if [ -n "$has" ]; then echo "   ✓ có"; else echo "   ✗ THIẾU — chạy tao-khoa-ma-hoa-identity (MT=prod)"; failed="$failed khoa"; fi

          echo "── deploy/$DEP: ảnh, bản sẵn sàng, envFrom"
          kubectl -n "$NS" get deploy "$DEP" \
            -o go-template='{{range .spec.template.spec.containers}}   ảnh: {{.image}}{{"\\n"}}   envFrom:{{range .envFrom}}{{if .secretRef}} secret/{{.secretRef.name}}{{end}}{{if .configMapRef}} configmap/{{.configMapRef.name}}{{end}}{{end}}{{"\\n"}}{{end}}   sẵn sàng: {{.status.readyReplicas}}/{{.spec.replicas}} · cập nhật: {{.status.updatedReplicas}}{{"\\n"}}' \
            || { echo "   ✗ không đọc được deploy/$DEP"; failed="$failed deploy"; }
          echo "   (thẻ ảnh là commit của lượt build service-identity — đối chiếu với lịch sử job ấy)"

          echo "── Service identity"
          kubectl -n "$NS" get svc "$DEP" -o wide 2>/dev/null || { echo "   ✗ không thấy svc/$DEP"; failed="$failed svc"; }

          echo "── Ingress có host $API_HOST"
          kubectl -n "$NS" get ingress \
            -o go-template='{{range .items}}{{$n := .metadata.name}}{{range .spec.rules}}{{if eq .host "'"$API_HOST"'"}}{{range .http.paths}}{{$n}} {{.path}} {{.backend.service.name}}:{{.backend.service.port.number}}{{.backend.service.port.name}}{{"\\n"}}{{end}}{{end}}{{end}}{{end}}' \
            > "$TMP_DIR/ingress" 2>/dev/null || true
          if [ -s "$TMP_DIR/ingress" ]; then
            sed 's/^/   /' "$TMP_DIR/ingress"
            grep -q " $DEP:" "$TMP_DIR/ingress" || { echo "   ✗ không đường nào trỏ về svc/$DEP"; failed="$failed ingress"; }
          else
            echo "   ✗ không Ingress nào trong $NS khai host $API_HOST"; failed="$failed ingress"
          fi

          echo "── POST https://$API_HOST/api/v1/citizen-sessions thân {} — mong 400 invalid_body"
          if command -v curl >/dev/null 2>&1; then
            code=$(curl -sS -o "$TMP_DIR/body" -w '%{http_code}' --max-time 20 -X POST \
                     -H 'Content-Type: application/json' --data '{}' \
                     "https://$API_HOST/api/v1/citizen-sessions" 2>"$TMP_DIR/err" || true)
            echo "   HTTP $code · thân: $(head -c 300 "$TMP_DIR/body" 2>/dev/null)"
            if [ "$code" = "400" ] && grep -q '"invalid_body"' "$TMP_DIR/body"; then
              echo "   ✓ tuyến mới đang trả lời"
            else
              case "$code" in
                404) echo "   ✗ 404 — ảnh identity CŨ (chưa có tuyến) hoặc Ingress không tới identity" ;;
                429) echo "   ✗ 429 — giới hạn tần suất của tuyến; đợi 5 phút rồi chạy lại" ;;
                000) echo "   ✗ không kết nối được: $(head -c 300 "$TMP_DIR/err")" ;;
                *)   echo "   ✗ không phải 400 invalid_body" ;;
              esac
              failed="$failed probe"
            fi
          else
            echo "   ✗ máy chủ build thiếu curl — không thử được"; failed="$failed curl"
          fi

          if [ -n "$failed" ]; then echo ""; echo "CHƯA ĐẠT:$failed"; exit 1; fi
          echo ""
          echo "✓ Đạt. Bước kế: HANH_DONG=bat-demo-mini-app (MT=prod)."
        '''
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────────────
    // BƯỚC 4 — `operatorctl mini-app-demo on|off` cho một App ID của một xã (ADR 0066 quyết định 3,
    // tới khi platform-admin có màn). Danh tính demo mở phiên KHÔNG xác minh số điện thoại: là cờ
    // nguy hiểm (luật 8 bất biến 7) — TẮT trước khi Zalo duyệt app.
    //
    // CHẠY Ở ĐÂU: pod identity là distroless (không shell), nên job dựng một pod sống MỘT lượt từ
    // ĐÚNG ảnh Deployment identity đang chạy (đọc từ cụm, không đoán thẻ) — ảnh ấy mang
    // /operatorctl từ service-identity/Dockerfile — với ĐÚNG envFrom + env + imagePullSecrets của
    // Deployment (đọc bằng kubectl, dùng lại nguyên). Manifest pod viết vào TỆP rồi `create -f`:
    // env của Deployment không bao giờ lên dòng lệnh. Không attach/stdin (lý do ở `chay_psql`):
    // hỏi pha bằng `get`, đọc `logs`, xoá pod.
    //
    // Pod KHÔNG mang nhãn của Deployment: mang nhãn ấy là Service identity gửi lưu lượng thật vào
    // một pod không nghe cổng nào. Nên nếu NetworkPolicy hạn chế đường ra theo nhãn ấy, pod này có
    // thể không tới CSDL / platform — log sẽ nói.
    //
    // MT=prod CHỈ: staging dùng chung CSDL. Vết kiểm toán ghi ở xã đích, chủ thể system, lý do
    // ticket:<TICKET> (operatorctl); người bấm nằm trong tên lượt build.
    // ─────────────────────────────────────────────────────────────────────────────────────
    stage('Bật/tắt demo Mini App') {
      when { expression { params.HANH_DONG in ['bat-demo-mini-app', 'tat-demo-mini-app'] } }
      steps {
        script {
          if (params.MT != 'prod') { error("${params.HANH_DONG} chỉ chạy với MT=prod (staging dùng chung CSDL).") }
          if (params.XAC_NHAN != 'vigov-prod') {
            error("XAC_NHAN phải là đúng 'vigov-prod'. Nhận được: '${params.XAC_NHAN}'. Không ghi gì cả.")
          }
          // Ba giá trị đi vào manifest JSON và dòng lệnh của pod — chỉ nhận đúng dạng, trước mọi lệnh kubectl.
          if (!(params.TENANT_ID ==~ /^[0-7][0-9A-HJKMNP-TV-Z]{25}$/)) {
            error("TENANT_ID '${params.TENANT_ID}' không phải ULID (26 ký tự Crockford base32, chữ hoa). Không ghi gì cả.")
          }
          if (!(params.APP_ID ==~ /^[0-9]{1,32}$/)) {
            error("APP_ID '${params.APP_ID}' phải chỉ gồm chữ số. Không ghi gì cả.")
          }
          if (!(params.TICKET ==~ /^[A-Za-z0-9._-]{1,64}$/)) {
            error("TICKET bắt buộc, chỉ A-Z a-z 0-9 . _ -, tối đa 64 ký tự. Nhận được: '${params.TICKET}'. Không ghi gì cả.")
          }
          env.DEMO_MODE = (params.HANH_DONG == 'bat-demo-mini-app') ? 'on' : 'off'
          env.TENANT_ID = params.TENANT_ID
          env.APP_ID = params.APP_ID
          env.TICKET = params.TICKET
          env.RUN_DETAIL = "demo ${env.DEMO_MODE} · xã ${params.TENANT_ID} · app ${params.APP_ID} · ticket ${params.TICKET}"
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.HANH_DONG} · ${params.APP_ID} · ${env.NGUOI_BAM}"
        }
        sh '''
          set -eu
          umask 077
          TMP_DIR=$(mktemp -d)
          DEP=vigov-service-identity
          POD="vigov-operatorctl-$BUILD_NUMBER"
          trap 'kubectl -n vigov-prod delete pod "$POD" --ignore-not-found --wait=false >/dev/null 2>&1 || true; rm -f "$TMP_DIR"/*; rmdir "$TMP_DIR"' EXIT

          n=$(kubectl -n vigov-prod get deploy "$DEP" -o go-template='{{len .spec.template.spec.containers}}')
          [ "$n" = "1" ] || { echo "DỪNG: deploy/$DEP có $n container — không biết lấy ảnh nào. Không ghi gì."; exit 1; }
          get_field() { kubectl -n vigov-prod get deploy "$DEP" -o jsonpath="$1"; }
          IMG=$(get_field '{.spec.template.spec.containers[0].image}')
          get_field '{.spec.template.spec.containers[0].envFrom}' > "$TMP_DIR/envfrom"
          get_field '{.spec.template.spec.containers[0].env}' > "$TMP_DIR/env"
          get_field '{.spec.template.spec.imagePullSecrets}' > "$TMP_DIR/pull"
          for f in envfrom env pull; do [ -s "$TMP_DIR/$f" ] || printf '[]' > "$TMP_DIR/$f"; done
          echo "── ảnh: $IMG"
          echo "── môi trường dùng lại của deploy/$DEP (CHỈ TÊN):"
          kubectl -n vigov-prod get deploy "$DEP" \
            -o go-template='{{range .spec.template.spec.containers}}   envFrom:{{range .envFrom}}{{if .secretRef}} secret/{{.secretRef.name}}{{end}}{{if .configMapRef}} configmap/{{.configMapRef.name}}{{end}}{{end}}{{"\\n"}}   env:{{range .env}} {{.name}}{{end}}{{"\\n"}}{{end}}'
          echo "── lệnh: /operatorctl mini-app-demo $DEMO_MODE --tenant $TENANT_ID --app-id $APP_ID --ticket $TICKET"

          {
            printf '{"apiVersion":"v1","kind":"Pod","metadata":{"name":"%s","labels":{"app.kubernetes.io/name":"identity-operatorctl"}},' "$POD"
            printf '"spec":{"restartPolicy":"Never","imagePullSecrets":'; cat "$TMP_DIR/pull"
            printf ',"containers":[{"name":"operatorctl","image":"%s","envFrom":' "$IMG"; cat "$TMP_DIR/envfrom"
            printf ',"env":'; cat "$TMP_DIR/env"
            printf ',"command":["/operatorctl","mini-app-demo","%s","--tenant","%s","--app-id","%s","--ticket","%s"]}]}}' \
              "$DEMO_MODE" "$TENANT_ID" "$APP_ID" "$TICKET"
          } > "$TMP_DIR/pod.json"
          kubectl -n vigov-prod create -f "$TMP_DIR/pod.json" >/dev/null

          phase=""; i=0
          while [ $i -lt 60 ]; do   # 60 × 5 giây = 5 phút
            phase=$(kubectl -n vigov-prod get pod "$POD" -o jsonpath='{.status.phase}' 2>/dev/null || true)
            case "$phase" in Succeeded|Failed) break ;; esac
            sleep 5; i=$((i+1))
          done
          echo "── log của operatorctl"
          kubectl -n vigov-prod logs "$POD" 2>&1 || true
          if [ "$phase" != "Succeeded" ]; then
            echo "── pod $POD kết thúc ở pha '$phase' — sự kiện của pod:"
            kubectl -n vigov-prod describe pod "$POD" 2>/dev/null | sed -n '/^Events:/,$p' || true
            echo "Gợi ý: 'no such file' /operatorctl = ảnh cũ, chưa qua job service-identity có Dockerfile mới;"
            echo "lỗi schema/bảng = migration 0021 chưa áp (pod identity áp lúc khởi động)."
            exit 1
          fi
          echo ""
          if [ "$DEMO_MODE" = "on" ]; then
            echo "Xong. Bước kế: cd citizen-app && npm run zmp:deploy -- --domain=thangbinh-danang.vigov.vn --vao-thang --demo"
            echo "⚠ TẮT (tat-demo-mini-app) trước khi Zalo duyệt app."
          else
            echo "Xong — danh tính demo đã tắt cho app $APP_ID."
          fi
        '''
      }
    }

    stage('Xem log') {
      when { expression { params.HANH_DONG == 'xem-log' } }
      steps {
        sh '''
          set -u
          echo "── mô tả deploy/$DICH_VU"
          kubectl -n "$NS" describe deploy/"$DICH_VU" | tail -40 || true
          # Pod tìm theo TIỀN TỐ TÊN, không theo nhãn: Deployment dựng tay trong Rancher mang nhãn
          # `workload.user.cattle.io/workloadselector`, khác nhãn của `deploy/base`.
          for p in $(kubectl -n "$NS" get pod -o name 2>/dev/null | grep "^pod/$DICH_VU-" || true); do
            echo ""
            echo "════ $p — sự kiện"
            kubectl -n "$NS" describe "$p" | sed -n '/^Events:/,$p' || true
            echo "════ $p — log (300 dòng cuối)"
            kubectl -n "$NS" logs "$p" --all-containers --tail=300 || true
            echo "════ $p — log lần chạy TRƯỚC (nếu pod đã khởi động lại)"
            kubectl -n "$NS" logs "$p" --all-containers --tail=100 --previous 2>/dev/null || echo "   (không có)"
          done
        '''
      }
    }
  }

  post {
    success {
      script {
        currentBuild.description = "${params.HANH_DONG} · ${env.NS} · bấm bởi ${env.NGUOI_BAM}" +
                                   (env.RUN_DETAIL ? " · ${env.RUN_DETAIL}" : '')
      }
    }
  }
}

// AI BẤM LƯỢT NÀY — cùng hàm với service-platform/Jenkinsfile, lý do ở đó.
String nguoiBam() {
  List nn
  try {
    nn = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')
  } catch (Throwable e) {
    echo "Không đọc được nguyên nhân lượt build (${e.getClass().getSimpleName()})."
    return ''
  }
  if (nn == null || nn.isEmpty()) { return '' }
  def id = nn[0].userId
  return id == null ? '' : id.toString().trim()
}
