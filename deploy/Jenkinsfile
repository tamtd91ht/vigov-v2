  IF EXISTS (SELECT 1 FROM tenant_domain
              WHERE host = 'thangbinh-danang.vigov.vn' AND tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8' AND la_chinh) THEN
    RAISE EXCEPTION 'DUNG: thangbinh-danang.vigov.vn da la ten mien chinh — viec nay da chay, khong ghi gi';
  END IF;
END \$\$;
INSERT INTO audit_log (tenant_id, actor_id, actor_kind, action, subject, at, delta)
  VALUES ('01M3CS7HHK72V71CGRRJHGR8E8', 'van-hanh:${env.NGUOI_BAM}', 'system', 'doi_ten_mien',
          'Xã Thăng Bình', now(),
          jsonb_build_object(
            'truoc', (SELECT jsonb_agg(jsonb_build_object('host', host, 'la_chinh', la_chinh) ORDER BY host)
                        FROM tenant_domain WHERE tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8'),
            'chinh_moi', 'thangbinh-danang.vigov.vn',
            'them', jsonb_build_array('thangbinh-danang.vigov.vn', 'thangbinh-danang.stg.vigov.vn'),
            'go', jsonb_build_array('admin.vigov.vn', 'admin-stg.vigov.vn'),
            'qua', 'jenkins vigov-deploy #${env.BUILD_NUMBER}'));
-- Gỡ hai tên miền cũ: chủ dự án quyết 26/09/2026 — admin.vigov.vn là tên miền của pod web quản
-- trị tổng liên xã (chưa dựng), không phải của một xã. Đây là dòng ĐỊNH TUYẾN của sổ xã, không
-- phải hồ sơ nghiệp vụ; dòng vết `doi_ten_mien` ở trên giữ nguyên trạng thái trước (`truoc`).
-- Lọc đúng hai host VÀ đúng xã này — không bao giờ gỡ tên miền của xã khác.
--
-- XOÁ TRƯỚC, CHÈN SAU — không UPDATE (chủ dự án chọn 26/09/2026, sau lượt #21). Platform 0007 đã
-- áp, và CHECK NOT VALID của nó kiểm MỌI phiên bản dòng mới: hạ cờ la_chinh của admin.vigov.vn
-- bị từ chối (23514). DELETE không tạo phiên bản dòng mới nên CHECK không chạm; xoá xong thì xã
-- không còn dòng chính nào, và chỉ mục `tenant_domain_mot_chinh` nhận dòng chính mới.
DELETE FROM tenant_domain
 WHERE tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8'
   AND host IN ('admin.vigov.vn', 'admin-stg.vigov.vn');
INSERT INTO tenant_domain (host, tenant_id, la_chinh) VALUES
  ('thangbinh-danang.vigov.vn',     '01M3CS7HHK72V71CGRRJHGR8E8', true),
  ('thangbinh-danang.stg.vigov.vn', '01M3CS7HHK72V71CGRRJHGR8E8', false)
  ON CONFLICT (host) DO NOTHING;
DO \$\$
BEGIN
  IF (SELECT count(*) FROM tenant_domain
       WHERE host IN ('thangbinh-danang.vigov.vn', 'thangbinh-danang.stg.vigov.vn')
         AND tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8') <> 2 THEN
    RAISE EXCEPTION 'DUNG: sau khi ghi, hai ten mien moi khong cung thuoc xa 01M3CS7HHK72V71CGRRJHGR8E8 — quay lui, khong ghi gi';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM tenant_domain
                  WHERE host = 'thangbinh-danang.vigov.vn' AND tenant_id = '01M3CS7HHK72V71CGRRJHGR8E8' AND la_chinh) THEN
    RAISE EXCEPTION 'DUNG: thangbinh-danang.vigov.vn khong thanh ten mien chinh (dong co san voi la_chinh=false?) — quay lui, khong ghi gi';
  END IF;
  IF EXISTS (SELECT 1 FROM tenant_domain WHERE host IN ('admin.vigov.vn', 'admin-stg.vigov.vn')) THEN
    RAISE EXCEPTION 'DUNG: admin.vigov.vn / admin-stg.vigov.vn van con (gan cho xa khac?) — quay lui, khong ghi gi';
  END IF;
END \$\$;
COMMIT;
SELECT t.id, t.ten, t.dang_hoat_dong, d.host, d.la_chinh
  FROM tenant t JOIN tenant_domain d ON d.tenant_id = t.id
 WHERE t.id = '01M3CS7HHK72V71CGRRJHGR8E8'
 ORDER BY d.host;
"""
        sh(CHAY_PSQL + '''
          echo "── tên miền của xã và hai host mới (trước khi ghi)"
          # Lượt #19: phép kiểm báo xã chưa có trong sổ dù `tao-xa-thang-binh` được ghi là đã chạy.
          # Đọc TOÀN BỘ sổ xã + CSDL đang nói chuyện + vết tao_xa, để biết xã thiếu thật hay DSN
          # trỏ nhầm CSDL — trước khi ai tạo lại một xã có thể đã tồn tại ở nơi khác.
