{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/drift_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/progress_guard.py\"" }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/secret_scan.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pii_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/data_safety_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tenant_scope_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/service_boundary_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/citizen_scope_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/citizen_commitment_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/rest_api_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/doc_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/progress_guard.py\"" }
        ]
      },
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/data_safety_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bash_content_guard.py\"" }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/rbac_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/rest_api_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/audit_guard.py\"" }
        ]
      }
    ],

    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_verify_guard.py\"" },
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/progress_guard.py\"" }
        ]
      }
    ]
  },

  "permissions": {
    "allow": [
      "Read(**)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(date:*)",
      "Bash(mkdir:*)",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote -v:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",

      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go run ./tools/kb:*)",
      "Bash(go list:*)",
      "Bash(gofmt -l:*)",
      "Bash(golangci-lint run:*)",
      "Bash(buf lint:*)",
      "Bash(buf generate:*)",

      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc --noEmit:*)",

      "Bash(make check:*)",
      "Bash(make kb:*)",
      "Bash(make test:*)",

      "Bash(docker compose config:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],

    "deny": [
      "Bash(sed:*)",
      "Bash(perl:*)",
      "Bash(awk:*)",
      "Bash(tee:*)",
      "Bash(find:*)",
      "Bash(xargs:*)",
      "Bash(dd:*)",
      "Bash(truncate:*)",

      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)",
      "Bash(rmdir:*)",

      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git branch -D:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rm:*)",
      "Bash(git filter-branch:*)",

      "Bash(mongosh:*)",
      "Bash(mongo:*)",
      "Bash(psql:*)",
      "Bash(mongorestore:*)",

      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune:*)",

      "Read(./.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)"
    ]
  }
}
