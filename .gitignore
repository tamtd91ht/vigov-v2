# Secrets — never committed
.env
.env.local
.env.*.local
*.pem
*.key
!*.pub

# Runtime artefacts
.claude/logs/
.claude/settings.local.json
__pycache__/
*.pyc

# Go
/bin/
/dist/
vendor/

# Generated from .proto — run `make proto`.
# Nằm trong core/ vì mã sinh từ proto là HỢP ĐỒNG dùng chung, cùng tầng với core;
# một module riêng cho nó sẽ cần một go.mod mà chính dòng ignore này nuốt mất.
core/gen/

# Node / Next.js
node_modules/
.next/
out/
web/build/
# Đệm tăng tốc của `tsc --noEmit`, sinh ra ngay lần typecheck ĐẦU TIÊN của một app. Nó chứa
# đường dẫn tuyệt đối của máy chạy, nên hai máy commit nó là hai bản xung đột mỗi lần chạy cổng.
# `web-admin` và `citizen-app` chưa bao giờ để lộ nó chỉ vì chúng đã được typecheck từ trước khi
# có ai `git add -A`; `platform-admin` thì lần đầu là 22/09/2026 — và tệp này hiện ra ngay.
*.tsbuildinfo

# The GENERATED kb tiers are committed on purpose, so a fresh clone has working
# knowledge before anyone runs `make kb`.

# Cấu hình MCP là của từng máy, không phải của dự án
.mcp.json

# Bản nén trùng nội dung với docs/ui-ux/*.md
docs/ui-ux/*.zip

# Thư mục của IDE — của từng máy, không phải của dự án.
# Chưa có dòng nào cho chúng cho tới 2026-09-17, nên một lần `git add -A` là .idea/ lọt vào
# kho mã: đường dẫn tuyệt đối, tên người dùng, đôi khi cả chuỗi kết nối trong cấu hình data source.
.idea/
.vscode/
*.swp

# Nháp của phiên làm việc — ảnh chụp màn hình, QR sinh ra để thử, kết quả tải về.
# Có tên riêng chứ không phải /tmp của hệ điều hành: hai phiên agent dùng chung một cây làm
# việc, và một tệp nháp không bị bỏ qua là một tệp sẽ bị 'git add -A' của người khác cuốn vào.
tmp/
